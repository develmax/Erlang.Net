[Pairs] = init:get_plain_arguments(),
{ok, Data} = file:read_file(Pairs),
ReadFiles = fun(Path) ->
    {ok, {Name, [{abstract_code, {raw_abstract_v1, Forms}}]}} =
        beam_lib:chunks(binary_to_list(string:trim(Path)), [abstract_code]),
    Files = [File || {attribute, _, file, {File, 1}} <- Forms,
                     filename:basename(File) =:= "snmp_debug.hrl"],
    {Name, Files}
end,
Rows = [binary:split(Row, <<9>>, [global]) ||
        Row <- binary:split(Data, <<10>>, [global, trim_all])],
Results = [begin
    {Name, Before} = ReadFiles(Reference),
    {Name, After} = ReadFiles(Candidate),
    io:format("~0p.~n", [{Name, Before, After, Before =:= After}]),
    Before =/= [] andalso Before =:= After
end || [Reference, Candidate] <- Rows],
case Results =/= [] andalso lists:all(fun(X) -> X end, Results) of
    true -> halt(0);
    false -> halt(1)
end.
