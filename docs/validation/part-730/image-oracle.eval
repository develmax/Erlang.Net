A="artifacts/beam-backend/part730-images/ssl_srp_primes.beam", O=code:which(ssl_srp_primes), {ok,Actual}=file:read_file(A), {ok,Original}=file:read_file(O), {ok,_,AC}=beam_lib:all_chunks(A), {ok,_,OC}=beam_lib:all_chunks(O), io:format("bytes_equal=~p~nsize=~p~nsha256=~s~nsections_equal=~p~n",[Actual=:=Original,byte_size(Actual),binary:encode_hex(crypto:hash(sha256,Actual)),AC=:=OC]), {module,ssl_srp_primes}=code:load_binary(ssl_srp_primes,A,Actual), Pairs=[ssl_srp_primes:get_srp_params(K)||K<-[srp_2048,srp_3072,srp_4096,srp_6144,srp_8192]], [begin ok=ssl_srp_primes:check_srp_params(G,P), N=byte_size(P)-1, <<Short:N/binary,Last>>=P, not_accepted=ssl_srp_primes:check_srp_params(G,Short), not_accepted=ssl_srp_primes:check_srp_params(G,<<Short/binary,(Last bxor 1)>>), not_accepted=ssl_srp_primes:check_srp_params(G,<<P/binary,0>>), not_accepted=ssl_srp_primes:check_srp_params(<<G/binary,0>>,P), not_accepted=ssl_srp_primes:check_srp_params(not_a_binary,P), not_accepted=ssl_srp_primes:check_srp_params(G,not_a_binary) end||{G,P}<-Pairs], io:format("accepted_pairs=~p~nrejected_inputs=~p~n",[length(Pairs),6*length(Pairs)]), halt().
