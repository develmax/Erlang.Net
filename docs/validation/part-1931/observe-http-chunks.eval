[Beam,Out]=init:get_plain_arguments(),
M=http_chunk,
{ok,Bin}=file:read_file(Beam),
{ok,_}=code:prepare_loading([{M,Beam,Bin}]),
{module,M}=code:load_binary(M,Beam,Bin),
Chunk=M:encode(<<"abc">>),
Equivalent=iolist_to_binary(M:encode([<<"a">>,98,<<"c">>])),
Last=M:encode_last(),
Trailer=M:encode_last([{"X-Parity","ok"}]),
Packet = <<Chunk/binary,Last/binary>>,
Decoded=M:decode(Packet,8192,8192),
Invalid=try M:decode(<<"invalid\r\n">>,8192,8192) of Value->Value catch Class:Reason->{Class,Reason} end,
<<"3\r\nabc\r\n">> = Chunk,
Chunk=Equivalent,
ok=file:write_file(Out,io_lib:format("~p.~n",[[Chunk,Equivalent,Last,Trailer,Decoded,Invalid]])),
halt().
