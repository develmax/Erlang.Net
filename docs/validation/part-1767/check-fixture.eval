[{ok,[3]},{ok,[4]}]=beam_filtered_list_generator:guarded([{tag,[3]},wrong,{tag,[]},{tag,not_list},{tag,[-8]},{tag,[4]}]),
[]=beam_filtered_list_generator:guarded([]),
[{key,1},{key,3}]=beam_filtered_list_generator:comparison([{key,1},{other,2},noise,{key,3}],key),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_filtered_list_generator:comparison([{key,1}|improper],key)),
[a,b]=beam_filtered_list_generator:identity([10,a,{},b]),
[]=beam_filtered_list_generator:identity([]),
[{selected,true}]=beam_filtered_list_generator:boolean([false,true,false]),
false=get(last_filter),
{'EXIT',{{bad_filter,'maybe'},_}}=(catch beam_filtered_list_generator:boolean([false,'maybe',true])),
'maybe'=get(last_filter),
{'EXIT',{filter_crash,_}}=(catch beam_filtered_list_generator:boolean([true,crash,false])),
true=get(last_filter),
[]=beam_filtered_list_generator:boolean([]),
{'EXIT',{{bad_generator,bad},_}}=(catch beam_filtered_list_generator:guarded(bad)),
io:format("14 assertions passed~n"),
halt().
