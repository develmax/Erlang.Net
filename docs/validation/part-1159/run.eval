[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[{N,Is} || {function,N,2,_,Is}<-Fs,N=:=tuple_fallback orelse N=:=cons_fallback]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    {{1,saved},saved}=M:tuple_fallback({item,1,7},saved),
    {item,1,8}=M:tuple_fallback({item,1,8},saved),
    {{1,2},saved}=M:cons_fallback([1|2],saved),
    {saved,[]}=M:cons_fallback([],saved),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
