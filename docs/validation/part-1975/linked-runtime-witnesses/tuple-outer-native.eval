[Path]=init:get_plain_arguments(), M=beam_tuple_outer_generators, {ok,B}=file:read_file(Path),
{module,M}=code:load_binary(M,Path,B),
{beam_file,M,_,_,_,Fs}=beam_disasm:file(B),
Keys=[{F,A,E}||{function,F,A,E,_}<-Fs,string:find(atom_to_list(F),"-lc$^")=/=nomatch],
io:format("physical ~0tp~n",[Keys]),
true=[{a,[1]},{a,[2]},{b,[3]}]=:=M:grouped([{a,[1,2]},skip,{empty,[]},{b,[3]}]),
true=[{same,1},{same,2}]=:=M:captured(same,[{ignored,[1,2]}]),
true=[]=:=M:computed([]),
receive outer->ok after 0->error(no_outer) end,
receive Unexpected0->error({unexpected_empty_later,Unexpected0}) after 0->ok end,
true=[1,2,3]=:=M:computed([{one,[1,2]},skip,{empty,[]},{three,[3]}]),
[receive E->ok after 0->error({missing,E}) end||E<-[outer,one,empty,three]],
receive Unexpected1->error({unexpected_extra,Unexpected1}) after 0->ok end,
true=[1,2]=:=M:repeated([{[1,2],[1,2]},{[3],[4]},skip]),
try M:computed([{one,[1]},skip,{stop,[2|broken]},{unreached,[3]}]) of _->error(expected_inner_failure)
catch error:{bad_generator,broken}:Stack1 -> [{M,Helper1,_,Meta1}|_]=Stack1,
     true=lists:prefix("-computed/1-lc$^1/",atom_to_list(Helper1)),
     io:format("inner error ~0tp~n",[Meta1]) end,
[receive E->ok after 0->error({missing_failure,E}) end||E<-[outer,one,stop]],
receive Unexpected2->error({unexpected_after_failure,Unexpected2}) after 0->ok end,
try M:computed([skip|outer_broken]) of _->error(expected_outer_failure)
catch error:{bad_generator,outer_broken}:Stack2 -> [{M,Helper2,_,Meta2}|_]=Stack2,
     true=lists:prefix("-computed/1-lc$^0/",atom_to_list(Helper2)),
     io:format("outer error ~0tp~n",[Meta2]) end,
receive outer->ok after 0->error(no_outer) end,
receive Unexpected3->error({unexpected_after_outer_failure,Unexpected3}) after 0->ok end,
io:format("OTP 7 behavior profiles passed~n"),halt().
