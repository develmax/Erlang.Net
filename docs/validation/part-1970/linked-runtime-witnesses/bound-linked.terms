[{bound,[improper,a,b,c],
        {{ok,{improper,[{first,a},{second,b},{third,c}|improper]}},
         [{read,improper},{tail,improper},{consume,improper}]},
        {{ok,{improper,[{first,a},{second,b},{third,c}|improper]}},
         [{read,improper},{tail,improper},{consume,improper}]}},
 {bound,[fail,a,b,c],
        {{error,tail_failed},[{read,fail},{tail,fail}]},
