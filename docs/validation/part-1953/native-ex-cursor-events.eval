[Image,Stub,Output]=init:get_plain_arguments(),
{ok,[Stubs]}=file:consult(filename:join(Stub,"modules.terms")),
[begin {module,M}=code:load_abs(filename:join(Stub,atom_to_list(M))) end || M<-[fixture_calls|Stubs]],
{ok,Bytes}=file:read_file(Image),
{module,ex_cursor}=code:load_binary(ex_cursor,Image,Bytes),
Frame=fun(Event)->{wx,17,toggle,user,Event} end,
Radio=fun(Name)->Frame({wxCommand,command_radiobox_selected,Name,0,0}) end,
Toggle=fun(Value)->Frame({wxCommand,command_togglebutton_clicked,[],Value,0}) end,
State={state,parent,config,undefined,window},
Cases=[{radio,Radio("Arrow"),State},{unknown_cursor,Radio("Unknown"),State},
       {on,Toggle(1),State},{off,Toggle(0),State},{bad_toggle,Toggle(19),State},
       {fallback_kind,Frame({wxCommand,other,[],0,0}),State},
       {fallback_shape,Frame(unrelated),State},{bad_state,Radio("Arrow"),bad_state},
       {bad_fallback_state,Frame(unrelated),bad_state},{bad_envelope,unrelated,State}],
Run=fun({Name,Event,St})->
    fixture_calls:reset(),
    Outcome=try ex_cursor:handle_event(Event,St) of X->{ok,X}
       catch Class:Reason:Stack->{Class,Reason,lists:sublist(Stack,1)} end,
    {Name,Outcome,fixture_calls:calls()}
end,
Result=[Run(Case)||Case<-Cases],
10=length(Result),
[{radio,{ok,_},[_|_]}, {unknown_cursor,{ok,_},[_|_]},
 {on,{ok,_},[_|_]}, {off,{ok,_},[_|_]}, {bad_toggle,{error,{case_clause,19},[_]},[]},
 {fallback_kind,{ok,_},[_|_]}, {fallback_shape,{ok,_},[_|_]},
 {bad_state,{error,function_clause,[_]},[]},
 {bad_fallback_state,{error,function_clause,[_]},[]},
 {bad_envelope,{error,function_clause,[_]},[]}]=Result,
ok=file:write_file(Output,io_lib:format("~tp.~n",[Result])),
halt().
