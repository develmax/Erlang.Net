[Image,Dir,Output]=init:get_plain_arguments(),
ok=file:make_dir(Dir),
{ok,Bytes}=file:read_file(Image),
{module,mnesia_dumper}=code:load_binary(mnesia_dumper,Image,Bytes),
LoadTable=ets:new(load_rows,[ordered_set]),
File=filename:join(Dir,"loaded.log"),
Name=make_ref(),
{ok,Name}=disk_log:open([{name,Name},{file,File}]),
Rows=[{1,alpha},{2,{beta,3}}],
ok=disk_log:log_terms(Name,Rows),
ok=disk_log:close(Name),
ok=mnesia_dumper:load_from_logfile(ram_copies,LoadTable,File),
Rows=lists:sort(ets:tab2list(LoadTable)),
true=ets:delete(LoadTable),
ok=file:write_file(Output,io_lib:format("~tp.~n",[{load_nonempty,Rows}])),
halt().
