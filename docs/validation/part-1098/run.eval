[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, branch_liveness_probe} = code:load_binary(branch_liveness_probe, Path, Binary),
undefined = put(branch,initial),
{initial,keep} = branch_liveness_probe:multi(yes,a,keep),
{1,keep} = branch_liveness_probe:multi(yes,1,keep),
{a,keep} = branch_liveness_probe:selected(yes,b,keep),
{2,keep} = branch_liveness_probe:selected(yes,2,keep),
{c,keep,b} = branch_liveness_probe:exported(yes,c,keep),
{d,keep,fallback} = branch_liveness_probe:exported(no,d,keep),
b = get(follow),
c = get(branch),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [Item]) || Item = {function, Name, _, _, _} <- Functions, Name =/= module_info],
halt().
