[{prefix,one},{prefix,two}]=beam_recursive_list_comprehensions:map([one,two],prefix),
[]=beam_recursive_list_comprehensions:map([],prefix),
{tag,[{prefix,two},{prefix,one}]}=beam_recursive_list_comprehensions:embedded([one,two],prefix),
skipped=beam_recursive_list_comprehensions:choose(false,not_list),
[{chosen,one}]=beam_recursive_list_comprehensions:choose({prefix,chosen},[one]),
put(seen,[]),
[{z,one,a},{z,two,a}]=beam_recursive_list_comprehensions:captured([one,two],z,a),
[two,one]=get(seen),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_recursive_list_comprehensions:map([one|improper],prefix)),
{'EXIT',{{bad_generator,bad},_}}=(catch beam_recursive_list_comprehensions:map(bad,prefix)),
put(seen,[]),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_recursive_list_comprehensions:captured([one|improper],z,a)),
[one]=get(seen),
io:format("11 assertions passed~n"),
halt().
