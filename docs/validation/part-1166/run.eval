[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[{N,Is} || {function,N,_,_,Is}<-Fs,N=:=nil_case orelse N=:=literal_call_case]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    empty=M:nil_case([]),
    {error,{badarg,bad}}=M:nil_case(bad),
    {ok,child,{normal,allow}}=M:literal_call_case(normal,allow),
    {error,denied}=M:literal_call_case(normal,other),
    {error,badarg}=M:literal_call_case(other,allow),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
