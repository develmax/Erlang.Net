[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, capture_order_probe} = code:load_binary(capture_order_probe, Path, Binary),
[{sample, a, m, z}] = capture_order_probe:run(z, a, m),
{beam_file, _, _, _, _, Fs} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Fs,
    Name =:= run orelse lists:prefix("-run/3-fun-", atom_to_list(Name))],
halt().
