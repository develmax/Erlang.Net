diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.SharedTaggedArityPredicate.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.SharedTaggedArityPredicate.cs
new file mode 100644
--- /dev/null
+++ b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.SharedTaggedArityPredicate.cs
@@ -0,0 +1,62 @@
+using static Erlang.Compiler.BeamEmissionFormat;
+
+namespace Erlang.Compiler;
+
+internal sealed partial class BeamModuleCompiler
+{
+    private sealed partial class GeneralEmitter
+    {
+        private bool TryEmitSharedTaggedArityPredicate(FunctionDefinition function)
+        {
+            IReadOnlyList<Clause> clauses = function.Clauses;
+            if (!owner.SsaTypeInferenceEnabled || owner.ModuleOptimizationDisabled || function.Arity != 1 || clauses.Count < 3
+                || clauses[^1] is not
+                {
+                    Guard: null,
+                    Patterns: [Erlang.Pattern.Variable],
+                    Body: Expr.Literal { Value: Atom { Name: ErlangBooleanAtoms.False } }
+                })
+            {
+                return false;
+            }
+
+            Atom? shared = null;
+            var arities = new HashSet<int>();
+            foreach (Clause candidate in clauses.SkipLast(1))
+            {
+                if (candidate is not
+                    {
+                        Guard: null,
+                        Patterns: [Erlang.Pattern.Tuple { Items: [Erlang.Pattern.Literal { Value: Atom tag }, ..] } tuple],
+                        Body: Expr.Literal { Value: Atom { Name: ErlangBooleanAtoms.True } }
+                    }
+                    || tuple.Items.Count < 2 || shared is not null && !shared.Equals(tag) || !arities.Add(tuple.Items.Count)
+                    || tuple.Items.Skip(1).Any(item => item is not Erlang.Pattern.Variable)
+                    || !HasUnconditionalParameters(candidate with { Patterns = tuple.Items.Skip(1).ToArray() }))
+                {
+                    return false;
+                }
+
+                shared = tag;
+            }
+
+            int compare = Label();
+            int rejected = Label();
+            owner.EmitTupleArityDispatch(rejected, arities.Order().Select(arity => (arity, compare)).ToArray());
+            Mark(compare);
+            owner.EmitTuplePart(0, 0, 0);
+            owner.Op(BifTwo, LabelTag, 0);
+            owner.Operand(BeamWire.UnsignedTag, owner.Import(ErlangModuleNames.Module, ErlangOperators.ExactEqual, 2));
+            owner.Operand(XRegisterTag, 0);
+            owner.LiteralOperand(shared!);
+            owner.Operand(XRegisterTag, 0);
+            owner.instructions.WriteByte(Return);
+
+            Mark(rejected);
+            owner.EmitConstant(Term.A(ErlangBooleanAtoms.False), 0);
+            owner.instructions.WriteByte(Return);
+
+            return true;
+        }
+    }
+}
diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.NestedTaggedAppendLoop.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.NestedTaggedAppendLoop.cs
new file mode 100644
--- /dev/null
+++ b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.NestedTaggedAppendLoop.cs
@@ -0,0 +1,133 @@
+using static Erlang.Compiler.BeamEmissionFormat;
+
+namespace Erlang.Compiler;
+
+internal sealed partial class BeamModuleCompiler
+{
+    private sealed partial class GeneralEmitter
+    {
+        private bool TryEmitNestedTaggedAppendLoop(FunctionDefinition function, int functionInfo)
+        {
+            if (!owner.SsaTypeInferenceEnabled || owner.ModuleOptimizationDisabled || function.Clauses is not
+                [
+                {
+                    Guard: null,
+                    Patterns: [var nil, Erlang.Pattern.Variable fallback],
+                    Body: Expr.List { Items: [var defaultHead], Tail: Expr.Variable defaultTail }
+                },
+                {
+                    Guard: null,
+                    Patterns: [AliasPattern alias, Erlang.Pattern.Variable leftAccumulator],
+                    Body: Expr.Binary
+                    {
+                        Operator: ErlangOperators.Append, Left: Expr.Variable original, Right: Expr.Variable right
+                    } append
+                },
+                {
+                    Guard: null,
+                    Patterns:
+                        [
+                            Erlang.Pattern.List { Items: [Erlang.Pattern.Variable head], Tail: Erlang.Pattern.Variable tail },
+                            Erlang.Pattern.Variable accumulator
+                        ],
+                    Body: Expr.Call
+                    {
+                        Module: null, DynamicRemote: false,
+                        Arguments: [Expr.Variable remaining, Expr.List { Items: [Expr.Variable item], Tail: Expr.Variable carried }]
+                    } recur
+                }
+                ]
+                || ListEntryTest(nil) != IsNil || fallback.Name == VariableScopeNames.Wildcard || fallback.Name != defaultTail.Name
+                || !AttributeLiteral.TryNormalizeConstant(defaultHead, out Term defaultValue)
+                || !TryReadPatternAlias(alias, out var input, out var shape)
+                || shape is not Erlang.Pattern.List
+                {
+                    Tail: Erlang.Pattern.Variable { Name: VariableScopeNames.Wildcard },
+                    Items: [Erlang.Pattern.Tuple
+                    {
+                        Items: [
+                            Erlang.Pattern.Literal { Value: Atom outer },
+                            Erlang.Pattern.Tuple { Items: [Erlang.Pattern.Literal { Value: Atom inner }, Erlang.Pattern.Variable] } nested
+                        ]
+                    }]
+                }
+                || !DistinctBindings(input, leftAccumulator) || !DistinctBindings(head, tail, accumulator)
+                || nested.Items[1] is Erlang.Pattern.Variable binding && binding.Name != VariableScopeNames.Wildcard
+                    && (binding.Name == input.Name || binding.Name == leftAccumulator.Name)
+                || input.Name != original.Name || leftAccumulator.Name != right.Name
+                || remaining.Name != tail.Name || item.Name != head.Name || carried.Name != accumulator.Name
+                || recur.Function != function.Name || !entries.TryGetValue((recur.Function, 2), out int entry))
+            {
+                return false;
+            }
+
+            bool proper = HasProperListEntry(
+                function,
+                0,
+                followForwarding: true,
+                followReturnedLists: true
+            );
+            int collect = Label();
+            int empty = Label();
+            const int headRegister = 2;
+            const int tailRegister = 3;
+            const int payload = 4;
+            owner.EmitNonemptyList(0, empty);
+            owner.EmitListParts(
+                0,
+                XRegisterTag,
+                headRegister,
+                XRegisterTag,
+                tailRegister
+            );
+            EmitDetailRecordTest(
+                headRegister,
+                2,
+                outer,
+                collect
+            );
+            owner.EmitTuplePart(headRegister, 1, payload);
+            EmitDetailRecordTest(
+                payload,
+                2,
+                inner,
+                collect
+            );
+            var previous = location;
+            owner.EmitArithmeticLine(append.SourceLine, ref previous);
+            owner.Op(TailExternalCall, BeamWire.UnsignedTag, 2);
+            owner.Operand(BeamWire.UnsignedTag, owner.Import(ErlangModuleNames.Module, ErlangOperators.Append, 2));
+
+            Mark(collect);
+            owner.Op(TestHeap, BeamWire.UnsignedTag, ConsHeapWords);
+            owner.Operand(BeamWire.UnsignedTag, tailRegister + 1);
+            owner.Op(PutList, XRegisterTag, headRegister);
+            owner.Operand(XRegisterTag, 1);
+            owner.Operand(XRegisterTag, 1);
+            owner.MoveRegister(
+                XRegisterTag,
+                tailRegister,
+                XRegisterTag,
+                0
+            );
+            owner.Op(TailLocalCall, BeamWire.UnsignedTag, 2);
+            owner.Operand(LabelTag, entry);
+
+            Mark(empty);
+            if (!proper)
+            {
+                owner.EmitNilTest(XRegisterTag, 0, functionInfo);
+            }
+
+            owner.Op(TestHeap, BeamWire.UnsignedTag, ConsHeapWords);
+            owner.Operand(BeamWire.UnsignedTag, 2);
+            owner.instructions.WriteByte(PutList);
+            owner.LiteralOperand(defaultValue);
+            owner.Operand(XRegisterTag, 1);
+            owner.Operand(XRegisterTag, 0);
+            owner.instructions.WriteByte(Return);
+
+            return true;
+        }
+    }
+}
diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalTupleAlias.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalTupleAlias.cs
new file mode 100644
--- /dev/null
+++ b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalTupleAlias.cs
@@ -0,0 +1,79 @@
+using static Erlang.Compiler.BeamEmissionFormat;
+
+namespace Erlang.Compiler;
+
+internal sealed partial class BeamModuleCompiler
+{
+    private static byte[]? RemoveTerminalTupleAlias(ReadOnlyMemory<byte> code, IReadOnlyList<BeamInstruction> body)
+    {
+        using var output = new MemoryStream();
+        int copied = 0;
+        for (int index = 1; index + 3 < body.Count; index++)
+        {
+            if (body[index - 1] is not { Definition.Opcode: PutTuple, Operands: [var built, ..] }
+                || !PlainX(built, 0)
+                || body[index] is not { Definition.Opcode: Move, Operands: [var source, var alias] }
+                || source != built || !PlainX(alias, 1)
+                || body[index + 1] is not { Definition.Opcode: PutTuple, Operands: [var destination, var length, ..] }
+                || destination != source
+                || !(body[index + 2].Definition.Opcode == Return
+                    || body[index + 2].Definition.Opcode == Deallocate && body[index + 3].Definition.Opcode == Return))
+            {
+                continue;
+            }
+
+            var fields = body[index + 1].Operands.Skip(2).ToArray();
+            if (!fields.Contains(alias) || fields.Any(field => field.TypeIndex is not null
+                || field.Kind is not (BeamOperandParameters.X or BeamOperandParameters.Y or BeamOperandParameters.Integer
+                    or BeamOperandParameters.Atom or BeamOperandParameters.Nil or BeamOperandParameters.LiteralValue)))
+            {
+                continue;
+            }
+
+            // The enclosing tuple reads all fields before overwriting X0, and the
+            // return does not expose its temporary alias in X1.
+            output.Write(code.Span[copied..body[index].Offset]);
+            output.WriteByte(PutTuple);
+            BeamCompactWriter.Write(output, XRegisterTag, destination.Value);
+            output.WriteByte(ExtendedListOperand);
+            BeamCompactWriter.Write(output, BeamWire.UnsignedTag, length.Value);
+            foreach (var field in fields)
+            {
+                switch (field.Kind)
+                {
+                    case BeamOperandParameters.X:
+                        BeamCompactWriter.Write(output, XRegisterTag, field == alias ? source.Value : field.Value);
+                        break;
+                    case BeamOperandParameters.Y:
+                        BeamCompactWriter.Write(output, YRegisterTag, field.Value);
+                        break;
+                    case BeamOperandParameters.Integer:
+                        BeamCompactWriter.Write(output, BeamWire.IntegerTag, field.Value);
+                        break;
+                    case BeamOperandParameters.LiteralValue:
+                        output.WriteByte(ExtendedLiteralOperand);
+                        BeamCompactWriter.Write(output, BeamWire.UnsignedTag, field.Value);
+                        break;
+                    default:
+                        BeamCompactWriter.Write(output, AtomTag, field.Value);
+                        break;
+                }
+            }
+
+            copied = body[index + 2].Offset;
+            index += 1;
+        }
+
+        if (copied == 0)
+        {
+            return null;
+        }
+
+        output.Write(code.Span[copied..]);
+
+        return output.ToArray();
+
+        static bool PlainX(BeamOperand operand, int index) =>
+            operand.Kind == BeamOperandParameters.X && operand.TypeIndex is null && operand.Value == index;
+    }
+}
