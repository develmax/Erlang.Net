diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CaughtComputedListResult.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CaughtComputedListResult.cs
