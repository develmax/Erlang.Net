diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.GuardedBytePrefixScanner.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.GuardedBytePrefixScanner.cs
