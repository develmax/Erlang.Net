[Ref, Old, New | Changed] = init:get_plain_arguments(),
Normalize = fun(Is) ->
    Labels = [L || {label,L} <- Is],
    LabelMap = maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    Rename = fun
        Rebase({f,L}) -> {f,maps:get(L,LabelMap,L)};
        Rebase({literal,_}=Literal) -> Literal;
        Rebase(T) when is_tuple(T) -> list_to_tuple([Rebase(E) || E <- tuple_to_list(T)]);
        Rebase(L) when is_list(L) -> [Rebase(E) || E <- L];
        Rebase(Other) -> Other
    end,
    [Rename(I) || I <- Is, not (is_tuple(I) andalso element(1,I) =:= label)]
end,
Read = fun(Root, Path) ->
    {beam_file, _, _, _, _, Fs} = beam_disasm:file(filename:join(Root, Path)),
    maps:from_list([{{N,A}, Normalize(Is)}
                    || {function,N,A,_,Is} <- Fs])
end,
Rows = lists:flatmap(fun(Path) ->
    Expected = Read(Ref, Path),
    Before = Read(Old, Path),
    After = Read(New, Path),
    [{Path, F, case {maps:find(F, Expected), maps:find(F, Before), maps:find(F, After)} of
        {{ok,I}, {ok,I}, _} -> lost_match;
        {{ok,I}, _, {ok,I}} -> gained_match;
        _ -> changed
    end} || F <- lists:usort(maps:keys(Before) ++ maps:keys(After)),
            maps:find(F, Before) =/= maps:find(F, After)]
end, Changed),
io:format("Changed functions with local labels normalized: ~p~n", [length(Rows)]),
lists:foreach(fun(Row) -> io:format("~p~n", [Row]) end,
              [Row || Row={_,_,Status} <- Rows, Status =/= changed]),
halt().
