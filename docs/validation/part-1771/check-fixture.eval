M=beam_tagged_record_lookup,
S={state,[{enabled,1},{disabled,2}]},
{reply,{state,[{disabled,2}]}}=M:message({event,1,process,ignored,selected},S),
enabled=get(inspection), enabled=erase(applied),
{reply,{state,[{enabled,1}]}}=M:message({event,2,process,ignored,selected},S),
disabled=erase(inspection), undefined=get(applied),
{reply,S}=M:message({event,3,process,ignored,selected},S),
undefined=get(inspection),
{reply,{state,[{disabled,2}]}}=M:message({event,1,process,ignored,other},S),
undefined=get(inspection),
{reply,S}=M:message({event,1,wrong_tag,ignored,selected},S),
{reply,S}=M:message(unrelated,S),
{reply,invalid_state}=M:message({event,1,process,ignored,selected},invalid_state),
{'EXIT',{{case_clause,wrong_result},_}}=(catch M:message({event,1,process,ignored,selected},{state,invalid})),
{'EXIT',{{case_clause,{value,{unexpected,bad_key},[]}},_}}=(catch M:message({event,1,process,ignored,selected},{state,inconsistent})),
io:format("15 assertions passed~n"),
halt().
