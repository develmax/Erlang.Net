M=beam_independent_probe,
{[{a,1},{a,2}],[{b,3}]}=M:seq([1,2],[3]),
{[{a,1}],[{b,3},{b,4}]}=M:tuple([1],[3,4]),
[[{a,1}],[{b,2}]]=M:list([1],[2]),
{[{b,2}],[{a,1}]}=M:match([1],[2]),
{'EXIT',{badarg,_}}=(catch M:remote([1],[2])),
[{a,1}]=M:case1([1],[2],yes),
[{b,2}]=M:case1([1],[2],other),
[{b,2}]=M:case2([1],[2],no),
{'EXIT',{{case_clause,other},_}}=(catch M:case2([1],[2],other)),
[{a,1}]=M:fun1([1],[2],yes),
[{b,2}]=M:fun1([1],[2],other),
[{b,2}]=M:fun2([1],[2],no),
{'EXIT',{function_clause,_}}=(catch M:fun2([1],[2],other)),
[]=M:fun3([1],[2],other),
[{a,1}]=M:guard1([1],[2],yes),
[{b,2}]=M:guard1([1],[2],1),
{[{a,1}],[{b,2}]}=M:mix([1],[2],yes),
{[],[{b,2}]}=M:mix([1],[2],no),
{'EXIT',{{bad_generator,improper},_}}=(catch M:tuple([1|improper],[2])),
{'EXIT',{{bad_generator,bad},_}}=(catch M:seq([],bad)),
io:format("20 assertions passed~n"),
halt().
