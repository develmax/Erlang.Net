M=beam_general_try_probe,P="artifacts/beam-backend/part632-eldap/beam_general_try_probe",{ok,M,E}=compile:file(P++".erl",[binary]),{module,M}=code:load_binary(M,P,E),Run=fun()->[M:outer(X)||X<-[ok,bad,exit,throw]] end,Expected=Run(),code:purge(M),code:delete(M),{ok,A}=file:read_file(P++".beam"),{module,M}=code:load_binary(M,P,A),Actual=Run(),io:format("~p~n~p~n",[Expected,Actual]),case Expected=:=Actual of true->halt();_->halt(1) end.