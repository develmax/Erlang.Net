new file mode 100644
--- /dev/null
+++ b/tests/Erlang.Tests/Compiler/Beam/BeamBinaryLengthPrefixChecks.cs
@@ -0,0 +1,115 @@
+using System.Collections;
+using System.Numerics;
+using Erlang;
+using Erlang.Compiler;
+using static Erlang.Compiler.BeamEmissionFormat;
+using static Erlang.Tests.BeamBinaryHostAccess;
+
+namespace Erlang.Tests;
+
+internal static class BeamBinaryLengthPrefixChecks
+{
+    internal const string TestName = "compiler/beam/shares-private-binary-length-prefix";
+    private const string Fixture = "beam_binary_length_prefix.erl";
+    private const string WrongSchedule = "The private binary length did not use its expected shared prefix.";
+    private const string WrongResult = "The binary length changed its result or failure reason.";
+
+    private const string Source = """
+        -module(beam_binary_length_prefix).
+        -export([probe/1]).
+        probe(Bits) ->
+            {left,Tail} = strip(Bits),
+            measure(Tail).
+        strip(<<_:8,Rest/binary>>) -> {left,Rest}.
+        measure(<<1:1,0:7,Tail/binary>>) -> {forever,Tail};
+        measure(<<0:1,Count:7,Tail/binary>>) -> {Count,Tail};
+        measure(<<1:1,Width:7,Count:Width/unit:8,Tail/binary>>) -> {Count,Tail}.
+        """;
+
+    internal static async Task Run()
+    {
+        byte[] image = CodeGeneration.CompileBeamModule(Source, Fixture);
+        byte[] unproved = CodeGeneration.CompileBeamModule(
+            Source.Replace("strip(<<_:8,Rest/binary>>)", "strip(Rest)", StringComparison.Ordinal),
+            Fixture
+        );
+        byte[] exported = CodeGeneration.CompileBeamModule(
+            Source.Replace("[probe/1]", "[probe/1, measure/1]", StringComparison.Ordinal),
+            Fixture
+        );
+
+        var module = BeamModule.Prepare(image);
+        await using var runtime = new ProcessRuntime();
+        await using var actor = new RuntimeNodeFoundationHostActor(runtime);
+        await actor.InvokeAsync(async context =>
+        {
+            foreach (var (data, count) in new (byte[] Data, Term Count)[]
+            {
+                ([0xff, 0x7f, 0x2a], Term.I(127)),
+                ([0xff, 0x80, 0x2a], Term.A("forever")),
+                ([0xff, 0x81, 0x80, 0x2a], Term.I(128)),
+                ([0xff, 0x82, 0x01, 0x00, 0x2a], Term.I(256))
+            })
+            {
+                Term expected = Term.Tuple(count, new BitString([0x2a]));
+                if (!expected.Equals(await module.Invoke(context, "probe", new BitString(data))))
+                {
+                    throw new InvalidOperationException(WrongResult);
+                }
+            }
+
+            foreach (byte[] data in new byte[][]
+            {
+                [0xff],
+                [0xff, 0x82, 0x01]
+            })
+            {
+                try
+                {
+                    await module.Invoke(context, "probe", new BitString(data));
+                }
+                catch (ErlangException error) when (error.ExceptionClass == ErlangExceptionClasses.Error
+                    && error.Reason.Equals(Term.A("function_clause")))
+                {
+                    continue;
+                }
+
+                throw new InvalidOperationException(WrongResult);
+            }
+
+            return Nil.Value;
+        });
+
+        byte[] measure = Opcodes(image);
+        if (!measure.Contains(StartBinaryMatchKnown) || measure.Count(opcode => opcode == GetBinaryPosition) != 2
+            || measure.Contains(Allocate) || Opcodes(unproved).Contains(StartBinaryMatchKnown)
+            || Opcodes(exported).Contains(StartBinaryMatchKnown))
+        {
+            throw new InvalidOperationException(WrongSchedule);
+        }
+    }
+
+    private static byte[] Opcodes(byte[] image)
+    {
+        object code = Code(image);
+        string[] atoms = Items(Property(code, "Structure"), "Atoms").Cast<string>().ToArray();
+        object[] instructions = Items(code, "Instructions");
+        int start = Array.FindIndex(
+            instructions,
+            instruction => Opcode(instruction) == FunctionInfo
+                && Items(instruction, "Operands") is [_, var function, var arity]
+                && atoms[(int)(BigInteger)Property(function, "Value")] == "measure"
+                && (int)(BigInteger)Property(arity, "Value") == 1
+        );
+        if (start < 0)
+        {
+            throw new InvalidOperationException(WrongSchedule);
+        }
+
+        return instructions.Skip(start + 1).Select(Opcode).TakeWhile(opcode => opcode != FunctionInfo).ToArray();
+    }
+
+    private static byte Opcode(object instruction) => (byte)Property(Property(instruction, "Definition"), "Opcode");
+
+    private static object[] Items(object owner, string name) => ((IEnumerable)Property(owner, name)).Cast<object>().ToArray();
+}
