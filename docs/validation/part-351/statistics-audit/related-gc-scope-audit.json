            "request_system_task(Process *c_p, Eterm requester, Eterm target,",
            "\t\t    Eterm priority_req, Eterm operation)",
            "{",
            "    BIF_RETTYPE ret;",
            "    Process *rp = erts_proc_lookup_raw(target);",
            "    ErtsProcSysTask *st = NULL;",
            "    erts_aint32_t prio, fail_state = ERTS_PSFLG_EXITING;",
            "    Eterm noproc_res, req_type, priority = priority_req;",
            "    int signal = 0;",
            "",
            "    if (!rp && !is_internal_pid(target)) {",
            "\tif (!is_external_pid(target))",
            "\t    goto badarg;",
            "\tif (external_pid_dist_entry(target) != erts_this_dist_entry)",
            "\t    goto badarg;",
            "    }",
            "",
            "    switch (priority_req) {",
            "    case am_max:\tprio = PRIORITY_MAX;\tbreak;",
            "    case am_high:\tprio = PRIORITY_HIGH;\tbreak;",
            "    case am_normal:\tprio = PRIORITY_NORMAL;\tbreak;",
            "    case am_low:\tprio = PRIORITY_LOW;\tbreak;",
            "    case am_inherit: {",
            "\terts_aint32_t state = erts_atomic32_read_nob(&c_p->state);",
            "        prio = ERTS_PSFLGS_GET_USR_PRIO(state);",
            "\tswitch (prio) {",
            "\tcase PRIORITY_MAX: priority = am_max; break;",
            "\tcase PRIORITY_HIGH: priority = am_high; break;",
            "\tcase PRIORITY_NORMAL: priority = am_normal; break;"
          ]
        },
