[Image,Out,Directory]=init:get_plain_arguments(),
ok=file:set_cwd(Directory),
{ok,B}=file:read_file(Image),
{module,systools}=code:load_binary(systools,Image,B),
Term={script,{"parity","1"},[]},
ok=file:write_file("probe.script",io_lib:format("~p.~n",[Term])),
ok=systools:script2boot("probe"),ok=systools:script2boot("probe","explicit",[ignored_option]),
{ok,A}=file:read_file("probe.boot"),{ok,C}=file:read_file("explicit.boot"),
Term=binary_to_term(A), A=C,
error=systools:script2boot("missing"),error=systools:script2boot("missing","absent",[]),
Check=fun(F)->try F() of V->{value,V} catch Class:Reason:S->{Class,Reason,[{M,N,length(Args)}||{M,N,Args,_}<-S,M=:=systools,is_list(Args)]} end end,
V1=Check(fun()->systools:script2boot(3)end),
V2=Check(fun()->systools:script2boot("probe",7,[])end),
ok=file:write_file(Out,io_lib:format("~0p.~n",[{A,C,V1,V2,not filelib:is_file("absent.boot")} ])),
halt().