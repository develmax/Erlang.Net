put(source_count,0),
[{a,prefix,1},{b,prefix,2}]=beam_call_list_generator:project([{a,1},ignored,{b,2}],prefix),
1=get(source_count),
[]=beam_call_list_generator:project([],prefix),
2=get(source_count),
[one,two]=beam_call_list_generator:identity([one,two]),
3=get(source_count),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_call_list_generator:identity([one|improper])),
4=get(source_count),
[{key,one},{key,two}]=beam_call_list_generator:map([discard,one,two],key),
{'EXIT',{badarg,_}}=(catch beam_call_list_generator:map([],key)),
{tag,[{b,prefix,2},{a,prefix,1}]}=beam_call_list_generator:embedded([{a,1},{b,2}],prefix),
{tag,[]}=beam_call_list_generator:embedded([],prefix),
4=get(source_count),
io:format("13 assertions passed~n"),
halt().
