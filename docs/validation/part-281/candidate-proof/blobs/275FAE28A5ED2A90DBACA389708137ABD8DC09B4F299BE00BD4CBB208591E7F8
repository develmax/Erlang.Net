using System.Reflection;
using Erlang;

try
{
    Assembly tests = Assembly.Load(ProcessInfoDefaultFocusNames.Assembly);
    foreach (string name in ProcessInfoDefaultFocusNames.Groups)
    {
        Type type = tests.GetType(name, true)!;
        MethodInfo method = type.GetMethod(ProcessInfoDefaultFocusNames.Run,
            BindingFlags.NonPublic | BindingFlags.Public | BindingFlags.Static)!;
        await (Task)method.Invoke(null, null)!;
        Console.WriteLine(name);
    }
    var fixtures = Erlang.Differential.ProcessInfoCases.Modules
        .Concat(Erlang.Differential.ProcessInfoObservableCases.Modules)
        .Concat(Erlang.Differential.ProcessInfoLogicalCases.Modules);
    foreach (var fixture in fixtures)
    {
        using var artifact = Erlang.Differential.GeneratedModuleCompiler.Compile(fixture.Source);
        Term result = await Erlang.Differential.CompiledModuleExecution.Run(artifact, fixture.CallerContext);
        if (!result.Equals(fixture.Expected))
            throw new InvalidOperationException(ProcessInfoDefaultFocusNames.CompiledFailure + fixture.Name);
        Console.WriteLine(fixture.Name);
    }

    return 0;
}
catch (Exception exception)
{
    Console.Error.WriteLine(exception);

    return 1;
}
