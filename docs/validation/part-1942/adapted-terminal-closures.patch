diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalClosureFrames.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalClosureFrames.cs
