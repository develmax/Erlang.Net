[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Read = fun(Path) ->
    {beam_file, Module, _, _, _, Functions} = beam_disasm:file(Path),
    {Module, maps:from_list([{{Name, Arity}, Instructions}
                           || {function, Name, Arity, _, Instructions} <- Functions])}
end,
Opcode = fun
    ({test, Test, _, _}) -> {test, Test};
    (I) when is_tuple(I) -> element(1, I);
    (I) -> I
end,
Body = fun(Instructions) ->
    [Op || I <- Instructions, Op <- [Opcode(I)],
           not lists:member(Op, [label, line, func_info, executable_line, debug_line])]
end,
Allocates = fun(Op) -> lists:member(Op, [allocate, allocate_heap, allocate_zero, allocate_heap_zero]) end,
Files = lists:sort(filelib:fold_files(Generated, "[.]beam$", true, fun(Path, Acc) -> [Path | Acc] end, [])),
Totals = lists:foldl(fun(Path, Acc) ->
    Relative = lists:nthtail(length(filename:split(Generated)), filename:split(Path)),
    {Module, Old} = Read(filename:join([Reference | Relative])),
    {Module, New} = Read(Path),
    Groups = lists:foldl(fun({Mfa, Instructions}, Groups0) ->
        case {Body(Instructions), Body(maps:get(Mfa, New, []))} of
            {[{test, is_nonempty_list} | Rest], [First | _]} ->
                case Allocates(First) andalso lists:any(Allocates, Rest) of
                    true ->
                        Key = lists:sublist(Rest, 2),
                        maps:update_with(Key, fun(Entries) -> [Mfa | Entries] end, [Mfa], Groups0);
                    false -> Groups0
                end;
            _ -> Groups0
        end
    end, #{}, lists:sort(maps:to_list(Old))),
    maps:fold(fun(Key, Mfas, All) ->
        Example = {Module, lists:last(Mfas)},
        maps:update_with(Key, fun({Modules, Count, Examples}) ->
            {Modules + 1, Count + length(Mfas), lists:sublist([Example | Examples], 3)}
        end, {1, length(Mfas), [Example]}, All)
    end, Acc, Groups)
end, #{}, Files),
Ranked = lists:reverse(lists:sort([{Modules, Functions, Key, Examples}
    || {Key, {Modules, Functions, Examples}} <- maps:to_list(Totals)])),
io:format("~p different images. OTP begins with is_nonempty_list and later allocates. Generated code allocates at entry.~n", [length(Files)]),
io:format("Columns are modules, functions, two OTP operations after the test, examples.~n"),
lists:foreach(fun({Modules, Count, Ops, Examples}) ->
    io:format("~p ~p ~w ~w~n", [Modules, Count, Ops, Examples])
end, lists:sublist(Ranked, 20)),
halt().
