[ImagePath,CacheDirectory,EvalIdentity,Output]=init:get_plain_arguments(),
Normalize=fun(Is) ->
    Labels=[L || {label,L} <- Is], Map=maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    Walk=fun
        T({f,L}) -> {f,maps:get(L,Map,{outside,L})};
        T({literal,_}=V) -> V;
        T({make_fun3,M,I,_,Dst,Args}) -> {make_fun3,M,I,uniq,T(Dst),T(Args)};
        T(V) when is_tuple(V) -> list_to_tuple(T(tuple_to_list(V)));
        T([H|R]) -> [T(H)|T(R)];
        T(V) -> V
    end,
    [Walk(I) || I <- Is, not(is_tuple(I) andalso lists:member(element(1,I),[label,line,func_info]))]
end,
DisasmIdentity={erlang:system_info(version),beam_disasm:module_info(md5),beam_lib:module_info(md5)},
Read=fun(P) ->
    Name=binary_to_list(string:trim(P)),
    {ok,Image}=file:read_file(Name),
    Key=crypto:hash(sha256,term_to_binary({DisasmIdentity,EvalIdentity,crypto:hash(sha256,Image)})),
    Entry=filename:join(CacheDirectory,binary_to_list(binary:encode_hex(Key))++".etf"),
    case file:read_file(Entry) of
        {ok,Cached} ->
            {Key,Functions}=binary_to_term(Cached),
            Functions;
        {error,enoent} ->
            {beam_file,_,_,_,_,Body}=beam_disasm:file(Image),
            Functions=maps:from_list([{{F,A},Normalize(Is)}||{function,F,A,_,Is}<-Body]),
            Functions
    end
end,
Slots=fun(Is) -> [S||I<-Is,is_tuple(I),S<-case I of {allocate,N,_}->[N];{allocate_heap,N,_,_}->[N];_->[] end] end,

Body=Read(unicode:characters_to_binary(ImagePath)),
Signature=maps:map(fun(_,Ops)->{term_to_binary(Ops,[deterministic]),Slots(Ops)} end,Body),
ok=file:write_file(Output,term_to_binary(Signature,[deterministic])),
halt().
