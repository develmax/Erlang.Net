Dir = "artifacts/beam-backend/part839-images",
Module = beam_guarded_list_lookup_probe,
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    default = Module:lookup([], default),
    default = Module:lookup([{other, true}, ignored], default),
    false = Module:lookup([{other, true},{active,-1},{active,7}], default),
    false = Module:lookup([{active,0.0}], default),
    2 = Module:lookup([{active,2}], default),
    once = Module:lookup([{active,once}], default),
    ok = Module:mode(binary),
    ok = Module:mode(list),
    ok = Module:active(-32768),
    ok = Module:active(32767),
    ok = Module:active(1.5),
    ok = Module:active(true),
    ok = Module:active(false),
    ok = Module:active(once),
    {error,{options,{mode,unknown}}} = (catch Module:mode(unknown)),
    {error,{options,{active,32768}}} = (catch Module:active(32768)),
    {error,{options,{active,-32769}}} = (catch Module:active(-32769)),
    {error,{options,{active,unknown}}} = (catch Module:active(unknown)),
    {[{reuseaddr,true},{other,42}],[{active,false},{mode,binary}]} =
        Module:partition([{mode,binary},{reuseaddr,true},{active,once},{other,42},{active,false}], [], [{mode,list}]),
    [{error,{options,{not_supported,{Key,1}}}} = (catch Module:partition([{Key,1}], [], []))
        || Key <- [header,packet,packet_size]],
    {error,{options,{mode,invalid}}} = (catch Module:partition([{mode,invalid}], [], [])),
    try Module:lookup([ignored|improper], default) catch error:function_clause:Stack -> Stack end
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{Module,lookup,_,_}|_] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().

