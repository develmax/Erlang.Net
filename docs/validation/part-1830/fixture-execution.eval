[Dir] = init:get_plain_arguments(),
P = filename:join(["artifacts/leaf-gc-bif-probe",Dir,"beam_leaf_gc_bif"]),
{module,M} = code:load_abs(P),
Flag = #{flag => [first,second]},
{9,Flag} = M:adjust({state,4,Flag},5),
N = (1 bsl 240) - 1,
Expected = N + 17,
{Expected,Flag} = M:adjust({state,N,Flag},17),
{'EXIT',{badarith,_}} = (catch M:adjust({state,bad,Flag},17)),
{'EXIT',{function_clause,_}} = (catch M:adjust({bad,4,Flag},5)),
{enabled,Flag} = M:guarded({tag,2},Flag),
{disabled,Flag} = M:guarded({tag,-1},Flag),
{disabled,Flag} = M:guarded({tag,bad},Flag),
io:format("~s 7/7~n",[Dir]),halt().
