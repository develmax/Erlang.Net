diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.HeadTupleReturnFrames.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.HeadTupleReturnFrames.cs
