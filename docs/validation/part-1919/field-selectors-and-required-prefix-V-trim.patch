diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ClosedLiteralTupleDecision.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ClosedLiteralTupleDecision.cs
new file mode 100644
--- /dev/null
+++ b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ClosedLiteralTupleDecision.cs
@@ -0,0 +1,166 @@
+using static Erlang.Compiler.BeamEmissionFormat;
+
+namespace Erlang.Compiler;
+
+internal sealed partial class BeamModuleCompiler
+{
+    private sealed partial class GeneralEmitter
+    {
+        private sealed record ClosedTupleClosureDecision(
+            int Label,
+            int Field,
+            IReadOnlyList<Term> Shared,
+            LiteralTupleClosureArm? Leaf,
+            IReadOnlyList<(Term Key, ClosedTupleClosureDecision Decision)> Branches
+        );
+
+        private bool TryEmitClosedLiteralTupleDecision(FunctionDefinition function)
+        {
+            if (owner.ModuleOptimizationDisabled || !owner.SsaTypeInferenceEnabled || recursiveClosure is not null
+                || function.Arity != 1 || function.Clauses.Count < 4
+                || function.Clauses[^1] is not
+                {
+                    Guard: null, Patterns: [Pattern.Variable fallbackBinding], Body: Expr.Fun { SelfName: null } fallback
+                }
+                || HasNestedDefinitions(fallback)
+                || ClosureCaptures.Capture(fallback, new Dictionary<string, Term>(StringComparer.Ordinal)
+                { [fallbackBinding.Name] = Nil.Value }).Count != 0)
+            {
+                return false;
+            }
+
+            var patterns = new HashSet<Term>();
+            var arms = new List<LiteralTupleClosureArm>();
+            for (int index = 0; index < function.Clauses.Count - 1; index++)
+            {
+                if (function.Clauses[index] is not
+                    {
+                        Guard: null, Patterns: [Pattern.Tuple tuple], Body: Expr.Fun { SelfName: null } closure
+                    } || tuple.Items.Count is 0 or >= FirstReservedXRegister
+                    || tuple.Items.Any(item => item is not Pattern.Literal { Value: Integer })
+                    || HasNestedDefinitions(closure))
+                {
+                    return false;
+                }
+
+                Term[] fields = tuple.Items.Cast<Pattern.Literal>().Select(field => field.Value).ToArray();
+                if (!patterns.Add(Term.Tuple(fields)))
+                {
+                    return false;
+                }
+
+                arms.Add(new(fields, closure, index));
+            }
+
+            var arities = arms.GroupBy(arm => arm.Fields.Count).OrderByDescending(group => group.Key).ToArray();
+            if (arities.Length < 2 || !arities.Any(group => Enumerable.Range(0, group.Key)
+                    .Count(field => group.Any(arm => !arm.Fields[field].Equals(group.First().Fields[field]))) > 1))
+            {
+                return false;
+            }
+
+            var order = Comparer<Term>.Create((left, right) => TermOrder.Compare(left, right, exact: true));
+            var groups = arities.Select(group => (Arity: group.Key, Decision: Plan(group.ToArray(), 0))).ToArray();
+            int fallbackLabel = Label();
+            owner.EmitTupleArityDispatch(fallbackLabel, groups.Reverse().Select(group => (group.Arity, group.Decision.Label)).ToArray());
+            variables = new(StringComparer.Ordinal);
+            foreach (var (arity, decision) in groups)
+            {
+                Emit(decision, arity, preloaded: null);
+            }
+
+            Mark(fallbackLabel);
+            EmitGeneralClosure(fallback with { CoreOrdinal = fallback.CoreOrdinal ?? function.Clauses.Count - 1 });
+            owner.instructions.WriteByte(Return);
+
+            return true;
+
+            ClosedTupleClosureDecision Plan(LiteralTupleClosureArm[] candidates, int first)
+            {
+                int label = Label();
+                var shared = new List<Term>();
+                int field = first;
+                while (field < candidates[0].Fields.Count && candidates.All(arm => arm.Fields[field].Equals(candidates[0].Fields[field])))
+                {
+                    shared.Add(candidates[0].Fields[field]);
+                    field++;
+                }
+
+                if (field == candidates[0].Fields.Count)
+                {
+                    return new(
+                        label,
+                        field,
+                        shared,
+                        candidates[0],
+                        []
+                    );
+                }
+
+                var branches = candidates.GroupBy(arm => arm.Fields[field]).OrderByDescending(group => group.Key, order)
+                    .Select(group => (group.Key, Plan(group.ToArray(), field + 1))).ToArray();
+
+                return new(
+                    label,
+                    field,
+                    shared,
+                    null,
+                    branches
+                );
+            }
+
+            void Emit(ClosedTupleClosureDecision decision, int arity, int? preloaded)
+            {
+                Mark(decision.Label);
+                int field = decision.Field - decision.Shared.Count;
+                foreach (Term expected in decision.Shared)
+                {
+                    int register = Register(field, preloaded);
+                    if (preloaded is null)
+                    {
+                        owner.EmitTuplePart(0, field, register);
+                    }
+
+                    owner.Op(ExactEqualTest, LabelTag, fallbackLabel);
+                    owner.Operand(XRegisterTag, register);
+                    owner.LiteralOperand(expected);
+                    field++;
+                }
+
+                if (decision.Leaf is { } leaf)
+                {
+                    EmitGeneralClosure(leaf.Body with { CoreOrdinal = leaf.Body.CoreOrdinal ?? leaf.Ordinal });
+                    owner.instructions.WriteByte(Return);
+
+                    return;
+                }
+
+                if (preloaded is null)
+                {
+                    preloaded = field;
+                    for (int index = field; index < arity; index++)
+                    {
+                        owner.EmitTuplePart(0, index, Register(index, preloaded));
+                    }
+                }
+
+                EmitAritySelect(Register(field, preloaded), decision.Branches.Count, fallbackLabel);
+                foreach (var (key, branch) in decision.Branches.Reverse())
+                {
+                    owner.LiteralOperand(key);
+                    owner.Operand(LabelTag, branch.Label);
+                }
+
+                foreach (var (_, branch) in decision.Branches)
+                {
+                    Emit(branch, arity, preloaded);
+                }
+
+                int Register(int index, int? first) => index == arity - 1 ? 0 : first is int loaded ? index - loaded + 1 : 1;
+            }
+
+            static bool HasNestedDefinitions(Expr.Fun closure) => closure.Clauses.SelectMany(clause => LocalFunctionEntries.Walk(clause.Body))
+                .Any(expression => expression is Expr.Fun or Expr.ListComprehension or Expr.MapComprehension or Expr.BinaryComprehension);
+        }
+    }
+}
diff --git a/tests/Erlang.Tests/Compiler/Beam/BeamClosedFieldSelectorChecks.cs b/tests/Erlang.Tests/Compiler/Beam/BeamClosedFieldSelectorChecks.cs
new file mode 100644
--- /dev/null
+++ b/tests/Erlang.Tests/Compiler/Beam/BeamClosedFieldSelectorChecks.cs
@@ -0,0 +1,126 @@
+using System.Collections;
+using System.Numerics;
+using Erlang.Compiler;
+using static Erlang.Compiler.BeamEmissionFormat;
+using static Erlang.Tests.BeamBinaryHostAccess;
+
+namespace Erlang.Tests;
+
+internal static class BeamClosedFieldSelectorChecks
+{
+    internal const string TestName = "compiler/beam/lays-out-independent-field-selector-arms-in-reverse-postorder";
+    private const string Fixture = "beam_closed_field_selector_probe.erl";
+    private const string IncorrectBranches = "The closed field selector did not emit the independent target order.";
+    private const string IncorrectResults = "A closed atom selector changed branch results.";
+
+    private const string Source = """
+        -module(beam_closed_field_selector_probe).
+        -export([lookup/3, fallback/3, convert/3, identity/3]).
+
+        lookup(direct, Input, _) -> wrap(Input, [tag]);
+        lookup(external, Input, [Column|Pairs]) -> lists:keyfind(Column, Input, Pairs).
+
+        fallback(direct, Input, _) -> wrap(Input, [tag]);
+        fallback(missing, _, _) -> exit({missing, field}).
+
+        convert(key, Input, _) -> wrap(Input, [key]);
+        convert(params, Input, _) -> alternate(Input, [params]);
+        convert(private, Input, _) -> {Input,0}.
+
+        identity(key, Input, _) ->
+            Value = decode(Input),
+            wrap(Value, [key]);
+        identity(params, Input, _) ->
+            Value = decode(Input),
+            alternate(Value, [params]);
+        identity(private, Input, _) ->
+            Input.
+
+        wrap(Input, Tag) -> {Input,Tag}.
+        alternate(Input, Tag) -> {Tag,Input}.
+        decode(Input) -> {decoded,Input}.
+        """;
+
+    internal static byte[] CompileFixture() => CodeGeneration.CompileBeamModule(Source, Fixture);
+
+    internal static async Task Run()
+    {
+        byte[] image = CompileFixture();
+        object code = Code(image);
+        string[] atoms = Items(Property(code, "Structure"), "Atoms").Cast<string>().ToArray();
+        object[] instructions = Items(code, "Instructions").ToArray();
+        Check("lookup", [IsNonemptyList, TailExternalCall, TailLocalCall]);
+        Check("fallback", [TailExternalCall, TailLocalCall]);
+        Check("convert", [Return, TailLocalCall, TailLocalCall]);
+        Check("identity", [Return, TailLocalCallWithFrame, TailLocalCallWithFrame]);
+
+        var module = BeamModule.Prepare(image, new BeamDependencySelection(["lists"]));
+        await using var runtime = new ProcessRuntime();
+        await using var receiver = new RuntimeNodeFoundationHostActor(runtime);
+        await receiver.InvokeAsync(async context =>
+        {
+            Term pair = Term.Tuple(Term.I(4), Term.A("value"));
+            Term tags = Term.List(Term.A("tag"));
+            Term contextList = Term.List(Term.I(4), pair);
+            if (!pair.Equals(await module.Invoke(
+                context,
+                "lookup",
+                Term.A("external"),
+                Term.I(1),
+                contextList
+            ))
+                || !Term.Tuple(Term.I(4), tags).Equals(await module.Invoke(
+                    context,
+                    "fallback",
+                    Term.A("direct"),
+                    Term.I(4),
+                    Nil.Value
+                ))
+                || !Term.Tuple(Term.I(4), Term.I(0)).Equals(await module.Invoke(
+                    context,
+                    "convert",
+                    Term.A("private"),
+                    Term.I(4),
+                    Nil.Value
+                ))
+                || !Term.I(4).Equals(await module.Invoke(
+                    context,
+                    "identity",
+                    Term.A("private"),
+                    Term.I(4),
+                    Nil.Value
+                )))
+            {
+                throw new InvalidOperationException(IncorrectResults);
+            }
+
+            return Nil.Value;
+        });
+
+        void Check(string name, byte[] exits)
+        {
+            int start = Array.FindIndex(
+                instructions,
+                instruction => Opcode(instruction) == FunctionInfo
+                && Items(instruction, "Operands").ToArray() is [_, var atom, _] && atoms[Value(atom)] == name
+            );
+            if (start < 0)
+            {
+                throw new InvalidOperationException(IncorrectBranches);
+            }
+
+            byte[] body = instructions.Skip(start + 1).TakeWhile(instruction => Opcode(instruction) != FunctionInfo)
+                .Select(Opcode).ToArray();
+            if (body.Count(opcode => opcode == SelectValue) != 1 || !body.Where(opcode => exits.Contains(opcode)).SequenceEqual(exits))
+            {
+                throw new InvalidOperationException(IncorrectBranches);
+            }
+        }
+    }
+
