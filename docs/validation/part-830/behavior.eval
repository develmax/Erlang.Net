Dir = "artifacts/beam-backend/part830-images",
Module = beam_record_transport_probe,
Stubs = [
    {beam_fixture_transport, "-module(beam_fixture_transport).\n-export([open/2]).\nopen(0, [fixture,binary]) -> {ok,fixture_socket}; open(0, [fail,binary]) -> {error,fixture_failure}; open(0, [unexpected,binary]) -> unexpected.\n"},
    {beam_transport_fsm, "-module(beam_transport_fsm).\n-export([start_fsm/8]).\nstart_fsm(A,B,C,D,E,F,G,H) -> {A,B,C,D,E,F,G,H}.\n"}],
lists:foreach(fun({Stub, Source}) ->
    Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
    ok = file:write_file(Path, Source),
    {ok, Stub, Bytes} = compile:file(Path, [binary]),
    {module, Stub} = code:load_binary(Stub, Path, Bytes)
end, Stubs),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Callback = {beam_fixture_transport, extra},
    Self = self(),
    {client, host, 4433, {{host,4433},fixture_socket}, {ssl,emulated,undefined},
        Self, Callback, 5000} = Module:connect(host, 4433, {config,ssl,emulated,[fixture],Callback}, 5000),
    {error,fixture_failure} = Module:connect(host, 4433, {config,ssl,emulated,[fail],Callback}, 5000),
    [try Module:connect(host, 4433, Config, 5000) catch error:Reason:Stack -> {Reason,Stack} end ||
        Config <- [
            {config,ssl,emulated,[unexpected],Callback},
            {config,ssl,emulated,[fixture],invalid_callback},
            invalid_config
        ]]
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{{case_clause,unexpected},_},{badarg,_},{function_clause,_}] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
