M=beam_map_binary_slots, Run=fun(F,Args,First,Second,Next) -> erase(),put(first,First),put(second,Second),put(next,Next), Result=try apply(M,F,Args) catch error:Reason -> {error,Reason} end, {Result,get(first),get(second),get(next)} end, Results=[Run(associate,[#{},k,fresh,kept],old,second,next),Run(associate,[not_map,k,fresh,kept],old,second,next),Run(exact,[#{k=>v},k,fresh,kept],old,second,next),Run(exact,[#{},k,fresh,kept],old,second,next),Run(lookup,[replacement,k,fallback,kept],#{k=>one,fixed=>two},before,next),Run(lookup,[replacement,k,fallback,kept],#{k=>one},before,next),Run(binary,[<<2>>,258,kept],old,second,<<171>>),Run(binary,[<<2>>,258,kept],old,second,not_binary)],io:format("~0p~n",[Results]),halt().