[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, computed_argument_probe} = code:load_binary(computed_argument_probe, Path, Binary),
undefined = put(lookup, target),
{undefined, done} = computed_argument_probe:first(initial),
initial = get(target),
{initial, done} = computed_argument_probe:second(target),
target = get(target),
undefined = put(ordered, before),
{undefined, done} = computed_argument_probe:multiple(),
updated = get(ordered),
updated = get(before),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Functions,
    lists:member(Name, [first, second, multiple])],
halt().
