[Input]=init:get_plain_arguments(),
{ok,Data}=file:read_file(Input),
Paths=[binary:split(L,<<9>>,[global]) || L <- binary:split(Data,<<10>>,[global,trim_all])],
Normalize=fun(Is) ->
    Labels=[L || {label,L} <- Is], Map=maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    Walk=fun
        T({f,L}) -> {f,maps:get(L,Map,{outside,L})};
        T({literal,_}=V) -> V;
        T({make_fun3,M,I,_,Dst,Args}) -> {make_fun3,M,I,uniq,T(Dst),T(Args)};
        T(V) when is_tuple(V) -> list_to_tuple(T(tuple_to_list(V)));
        T([H|R]) -> [T(H)|T(R)];
        T(V) -> V
    end,
    [Walk(I) || I <- Is, not(is_tuple(I) andalso lists:member(element(1,I),[label,line,func_info]))]
end,
Read=fun(P) ->
    {beam_file,_,_,_,_,Body}=beam_disasm:file(binary_to_list(string:trim(P))),
    maps:from_list([{{F,A},Normalize(Is)}||{function,F,A,_,Is}<-Body])
end,
lists:foreach(fun([Ref,Before,Simple,Ordered]) ->
    Name=filename:basename(binary_to_list(string:trim(Ref))),
    R=Read(Ref), B=Read(Before), S=Read(Simple), O=Read(Ordered),
    Keys=lists:usort(maps:keys(B)++maps:keys(S)++maps:keys(O)),
    Rows=[{Key,Old=:=Expected,Raw=:=Expected,Sorted=:=Expected}
          || Key <- Keys, {ok,Expected} <- [maps:find(Key,R)],
             Old <- [maps:get(Key,B,missing)], Raw <- [maps:get(Key,S,missing)], Sorted <- [maps:get(Key,O,missing)],
             Old=/=Raw orelse Old=/=Sorted],
    io:format("~0p.~n",[{Name,Rows}])
end,Paths),
halt().
