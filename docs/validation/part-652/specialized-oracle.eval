M='ELDAPv3', P="artifacts/beam-backend/part652-eldap/ELDAPv3.release-profile.beam",
AVA={'AttributeValueAssertion',"cn","x"},
Records=[{'LDAPMessage',1,{bindRequest,{'BindRequest',3,"dn",{simple,"secret"}}},asn1_NOVALUE},{'LDAPMessage',2,{searchRequest,{'SearchRequest',"dn",wholeSubtree,neverDerefAliases,10,30,false,{'and',[{present,"cn"},{'not',{equalityMatch,AVA}}]},["cn"]}},[{'Control',"1.2",true,"v"}]},{'PartialAttribute',"cn",["a","b"]},{'BindRequest',3,"dn",{sasl,{'SaslCredentials',"PLAIN","cred"}}},{'SubstringFilter',"cn",[{initial,"a"},{any,"b"},{final,"c"}]},{'ModifyRequest',"dn",[{'ModifyRequest_changes_SEQOF',add,{'PartialAttribute',"cn",["x"]}},{'ModifyRequest_changes_SEQOF',replace,{'PartialAttribute',"cn",["y"]}}]},{'SearchRequest',"dn",singleLevel,derefAlways,0,0,true,{extensibleMatch,{'MatchingRuleAssertion',"rule",asn1_NOVALUE,"v",false}},[]}],
Results=[{N,list_to_tuple([N,C,"dn","message",Referral]++case N of 'BindResponse'->[asn1_NOVALUE]; 'ExtendedResponse'->[asn1_NOVALUE,asn1_NOVALUE]; _->[] end)}||N<-['LDAPResult','BindResponse','SearchResultDone','ModifyResponse','AddResponse','DelResponse','ModifyDNResponse','CompareResponse','ExtendedResponse'],C<-[success,other,referral],Referral<-[asn1_NOVALUE,["ldap://host"]]],
Values=[{element(1,R),R}||R<-Records]++Results++[{'Attribute',{'PartialAttribute',"cn",["v"]}},{'AuthenticationChoice',{simple,"v"}},{'AuthenticationChoice',{sasl,{'SaslCredentials',"PLAIN",asn1_NOVALUE}}},{'Filter',{'or',[{substrings,{'SubstringFilter',"cn",[{initial,"a"}]}},{approxMatch,AVA},{greaterOrEqual,AVA},{lessOrEqual,AVA}]}},{'Filter',{'not',{present,"cn"}}}],
Encode=[{list_to_atom("enc_"++atom_to_list(N)),[V,T]}||{N,V}<-Values,T<-[[],[<<48>>],[<<160>>]]],
Decode=[begin {ok,B}=M:encode(N,V),{Tlv,_}=asn1rt_nif:decode_ber_tlv(B),Tags=case N of 'Filter'->[];'AuthenticationChoice'->[];_->[element(1,Tlv)] end,{list_to_atom("dec_"++atom_to_list(N)),[Tlv,Tags]} end||{N,V}<-Values],
Invalid=[{enc_Control,[{'Control',"oid",bad,asn1_NOVALUE},[]]},{enc_LDAPResult,[{'LDAPResult',bad,"","",asn1_NOVALUE},[]]},{enc_AuthenticationChoice,[{bad,"v"},[]]},{dec_AuthenticationChoice,[{131079,<<1,2>>},[]]},{dec_Filter,[{131088,<<1,2>>},[]]}],
Cases=Encode++Decode++Invalid,
Norm=fun({error,{asn1,{R,_}}})->{error,R};(X)->X end,
Run=fun()->[try apply(M,F,A) of {V,L} when is_integer(L)->{iolist_to_binary(V),L}; V->V catch C:R->{C,R} end||{F,A}<-Cases] end,
Round=fun()->[begin E=M:encode(N,V),case E of {ok,B}->{B,Norm(M:decode(N,B))};_->Norm(E) end end||{N,V}<-Values] end,
E=Run(),ER=Round(),code:purge(M),code:delete(M),{ok,B}=file:read_file(P),{module,M}=code:load_binary(M,P,B),A=Run(),AR=Round(),
D=[{I,X,Y}||{I,X,Y}<-lists:zip3(Cases,E,A),X=/=Y],DR=[{R,X,Y}||{R,X,Y}<-lists:zip3(Values,ER,AR),X=/=Y],
io:format("~p direct calls, ~p round trips, ~p differences~n",[length(Cases),length(Values),length(D)+length(DR)]),
case D++DR of []->halt();[H|_]->io:format("~p~n",[H]),halt(1) end.