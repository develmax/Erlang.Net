[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, bif_tail_probe} = code:load_binary(bif_tail_probe, Path, Binary),
undefined = put(probe, value),
Self = self(),
Node = node(),
{value, probe, first} = bif_tail_probe:first(probe),
{probe, value, second} = bif_tail_probe:second(probe),
{tag, probe, Self} = bif_tail_probe:swap(probe, tag),
{value, tag, Node} = bif_tail_probe:multiple(probe, tag),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Functions,
    lists:member(Name, [first, second, swap, multiple])],
halt().
