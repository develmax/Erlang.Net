[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Kinds = fun(Body) ->
    case lists:reverse(Body) of
        [{'case',_,Selector,Arms}|Prefix] ->
            CallCase = case {Selector,Prefix} of
                {{call,_,_,_},_} -> true;
                {{var,_,Name},[{match,_,{var,_,Name},{call,_,_,_}}|_]} -> true;
                _ -> false
            end,
            LiteralKeys = lists:all(fun({clause,_,[{Tag,_,_}],[],_}) ->
                lists:member(Tag,[atom,integer,char]);
                (_) -> false end,Arms),
            Results = [lists:last(Expressions) || {clause,_,_,_,Expressions} <- Arms],
            Tuples = [Items || {tuple,_,Items} <- Results],
            Computed = fun(Items) -> length([Call || {call,_,_,_}=Call <- Items]) end,
            HasComputed = lists:any(fun(Items) -> Computed(Items) > 0 end,Tuples),
            HasSingle = lists:any(fun(Items) ->
                Computed(Items) =:= 1 andalso lists:all(fun(Expr) ->
                    lists:member(element(1,Expr),[call,var,atom,integer,char,float,string,nil])
                end,Items)
            end,Tuples),
            HasCons = lists:any(fun
                ({cons,_,{call,_,_,_},_}) -> true;
                ({cons,_,_,{call,_,_,_}}) -> true;
                (_) -> false
            end,Results),
            [Kind || {Kind,true} <- [
                {call_case_tuple_result,CallCase andalso Tuples =/= []},
                {call_case_tuple_call_result,CallCase andalso HasComputed},
                {call_case_single_call_tuple_result,CallCase andalso HasSingle},
                {literal_case_single_call_tuple_result,CallCase andalso LiteralKeys andalso HasSingle},
                {call_case_cons_call_result,CallCase andalso HasCons}
            ]];
        _ -> []
    end
end,
Files = lists:sort(filelib:fold_files(Generated,"[.]beam$",true,fun(Path,Acc) -> [Path|Acc] end,[])),
Totals = lists:foldl(fun(Path,Acc) ->
    Relative = lists:nthtail(length(filename:split(Generated)),filename:split(Path)),
    case beam_lib:chunks(filename:join([Reference|Relative]),[abstract_code]) of
        {ok,{Module,[{abstract_code,{raw_abstract_v1,Forms}}]}} ->
            Groups = lists:foldl(fun({Name,Arity,Clauses},G0) ->
                Shapes = lists:usort(lists:append([Kinds(Body) || {clause,_,_,_,Body} <- Clauses])),
                lists:foldl(fun(Shape,G) -> maps:update_with(Shape,fun(Mfas) ->
                    [{Name,Arity}|Mfas] end,[{Name,Arity}],G) end,G0,Shapes)
            end,#{},[{Name,Arity,Clauses} || {function,_,Name,Arity,Clauses} <- Forms]),
            maps:fold(fun(Shape,Mfas,All) ->
                Count = length(Mfas),
                Example = {Module,lists:min(Mfas)},
                maps:update_with(Shape,fun({Modules,Functions,Examples}) ->
                    {Modules+1,Functions+Count,lists:sublist([Example|Examples],3)}
                end,{1,Count,[Example]},All)
            end,Acc,Groups);
        _ -> Acc
    end
end,#{},Files),
io:format("Computed case results in top-level function clauses of ~p differing images.~n",[length(Files)]),
io:format("Counts are {modules, functions, examples}. Groups can overlap.~n~p~n",[Totals]),
halt().




