M=beam_closure_comprehension,
{F1,[{key,1},{key,2}]}=M:fun_first([1,2],key),
key=F1(),
{[{value,3}],F2}=M:fun_last([3],value),
value=F2(),
{F3,[]}=M:seq([],empty),
empty=F3(),
F4=M:branch_fun([4],branch,yes),
branch=F4(),
[{branch,4}]=M:branch_fun([4],branch,other),
{F5,[{key,5}]}=M:remote_fun([5]),
[2,1]=F5([1,2]),
{F6,nested}=M:nested_fun([6],nested),
[{nested,6}]=F6(),
{'EXIT',{{bad_generator,bad},_}}=(catch M:fun_last(bad,key)),
io:format("14 assertions passed~n"),
halt().
