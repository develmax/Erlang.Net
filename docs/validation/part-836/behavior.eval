Dir = "artifacts/beam-backend/part836-images",
Module = beam_listener_start_probe,
Stub = beam_listener_transport,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_listener_transport).\n-export([open/2,port/1,defaults/0]).\ndefaults() -> [internal].\nopen(_, [ok,internal]) -> {ok,socket}; open(_, [occupied,internal]) -> {error,eaddrinuse}; open(_, [failed,internal]) -> {error,closed}; open(_, [unexpected,internal]) -> unexpected; open(_, [bad_port,internal]) -> {ok,bad_socket}.\nport(socket) -> {ok,4433}; port(bad_socket) -> malformed.\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Owner = self(),
    Callback = {Stub,a,b,c,d},
    Config = fun(Mode) -> {config,[Mode],Callback} end,
    Good = Config(ok),
    {Good,ip,4433,socket,Owner} = Module:start(ip,0,Owner,Good),
    {Good,ip,8443,socket,Owner} = Module:start(ip,8443,Owner,Good),
    {error,already_listening} = Module:start(ip,0,Owner,Config(occupied)),
    {error,closed} = Module:start(ip,0,Owner,Config(failed)),
    unexpected = Module:start(ip,0,Owner,Config(unexpected)),
    BadPort = try Module:start(ip,0,Owner,Config(bad_port)) catch error:{badmatch,malformed}:M -> M end,
    BadRecord = try Module:start(ip,0,Owner,{other,[ok],Callback}) catch error:function_clause:F -> F end,
    BadCallback = try Module:start(ip,0,Owner,{config,[ok],{Stub}}) catch error:function_clause:C -> C end,
    {BadPort,BadRecord,BadCallback}
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
{[{Module,start,4,_}|_],[{Module,start,_,_}|_],[{Module,start,_,_}|_]} = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
