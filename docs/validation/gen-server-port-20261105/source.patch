diff --git a/tools/Validation/audit-gen-server-source.py b/tools/Validation/audit-gen-server-source.py
new file mode 100644
--- /dev/null
+++ b/tools/Validation/audit-gen-server-source.py
@@ -0,0 +1,57 @@
+"""Inventory/identity audit for the complete selectable OTP-29.1.1 gen_server port."""
+import argparse
+import hashlib
+import json
+import pathlib
+import re
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--output', required=True)
+args = parser.parse_args()
+root = pathlib.Path(__file__).resolve().parents[2]
+baseline = json.loads((root / 'reference-baseline.json').read_text(encoding='utf-8-sig'))
+assert baseline['tag'] == 'OTP-29.1.1'
+assert baseline['commit'] == 'ad05823719d77c8faee87348ea39513d4e2f99c5'
+source = subprocess.check_output(['git', '-C', str(root.parent / 'otp'), 'show', baseline['tag'] + ':lib/stdlib/src/gen_server.erl'])
+suite = subprocess.check_output(['git', '-C', str(root.parent / 'otp'), 'show', baseline['tag'] + ':lib/stdlib/test/gen_server_SUITE.erl'])
+original = root / 'src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Otp'
+assert (original / 'gen_server.erl').read_bytes() == source, 'Original source differs from the pinned upstream bytes'
+assert (root / 'tools/Validation/Erlang.GenServerCompatibility/Reference/gen_server_SUITE.erl').read_bytes() == suite
+exports = set()
+for block in re.findall(rb'-export\(\[(.*?)\]\)', source, re.S):
+    exports.update((name.decode(), int(arity)) for name, arity in re.findall(rb'([a-z][a-z_0-9]*)\s*/\s*(\d+)', block))
+exports.add(('behaviour_info', 1))
+managed = root / 'src/Otp/Managed/Erlang.Otp.Stdlib/Processes/GenServer'
+names = dict(re.findall(r'const string (\w+) = "([^"]+)";', (managed / 'GenServerFunctionNames.cs').read_text()))
+body = (managed / 'GenServerModule.cs').read_text()
+export_block = body[:body.index('    public static void Register')]
+registered = {(names[name], int(arity)) for name, arity in re.findall(r'\(GenServerFunctionNames\.(\w+),\s*(\d+)\)', export_block)}
+assert registered == exports, {'missing': sorted(exports - registered), 'extra': sorted(registered - exports)}
+assert 'EnterSourceTailCall' in body
+assert 'GenServerMachine.Initialize' in body
+assert 'GenServerMachine.EnterLoop' in body
+files = sorted(managed.glob('GenServer*.cs'))
+for file in files:
+    if file.name in ['GenServer.cs', 'GenServerMessageTags.cs']:
+        continue  # The unchanged host facade is a separate contract.
+    text = file.read_text(encoding='utf-8-sig')
+    if not file.name.endswith(('Names.cs', 'Atoms.cs', 'Formats.cs')):
+        assert not re.search(r'(?m)^[^/\n]*"(?:\\.|[^"\\])*"', text), f'Inline semantic string in {file.name}'
+
+sha = lambda data: hashlib.sha256(data).hexdigest().upper()
+receipt = {
+    'Baseline': baseline,
+    'OriginalSourceSha256': sha(source),
+    'OriginalBeamSha256': sha((original / 'gen_server.beam').read_bytes()),
+    'UpstreamSuiteSha256': sha(suite),
+    'ExplicitExportsIncludingBehaviourInfo': len(exports),
+    'Exports': [f'{name}/{arity}' for name, arity in sorted(exports)],
+    'ManagedSources': {str(p.relative_to(root)).replace('\\', '/'): sha(p.read_bytes()) for p in files},
+    'FullRegressionRun': False,
+    'UniversalOtpCompatibilityCertified': False,
+}
+output = pathlib.Path(args.output)
+output.parent.mkdir(parents=True, exist_ok=True)
+output.write_text(json.dumps(receipt, indent=2) + '\n', encoding='utf-8')
+print(f'Pinned source, unchanged suite, {len(exports)} exports and semantic string ownership verified.')
diff --git a/tools/Validation/test-gen-server-admission.ps1 b/tools/Validation/test-gen-server-admission.ps1
new file mode 100644
--- /dev/null
+++ b/tools/Validation/test-gen-server-admission.ps1
@@ -0,0 +1,32 @@
+param(
+    [string]$Repository = '.',
+    [Parameter(Mandatory)][string]$Oracle,
+    [Parameter(Mandatory)][string]$Validator,
+    [Parameter(Mandatory)][string]$Output
+)
+$ErrorActionPreference = 'Stop'
+$repositoryPath = [IO.Path]::GetFullPath($Repository)
+$oraclePath = [IO.Path]::GetFullPath($Oracle)
+$validatorPath = [IO.Path]::GetFullPath($Validator)
+$outputPath = [IO.Path]::GetFullPath($Output)
+if (Test-Path -LiteralPath $outputPath) { throw 'Choose a new negative-control directory.' }
+New-Item -ItemType Directory -Path $outputPath | Out-Null
+Get-ChildItem -LiteralPath $oraclePath -File | Where-Object {
+    $_.Extension -in '.beam', '.etf', '.json' -and $_.Name -notlike '*-report.json'
+} | Copy-Item -Destination $outputPath
+$provenancePath = Join-Path $outputPath 'provenance.json'
+$provenance = Get-Content -LiteralPath $provenancePath -Raw | ConvertFrom-Json
+$provenance.CorpusSha256 = '0' * 64
+$provenance | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $provenancePath -Encoding utf8
+$logPath = Join-Path $outputPath 'rejection.log'
+& dotnet $validatorPath $repositoryPath $outputPath Managed 2>&1 | Out-File -LiteralPath $logPath -Encoding utf8
+$code = $LASTEXITCODE
+$log = Get-Content -LiteralPath $logPath -Raw
+$rejected = $code -ne 0 -and $log.Contains('gen_server immutable oracle admission failed') -and -not $log.Contains('Prepare: ')
+[ordered]@{
+    CorruptedCorpusIdentityRejected = $rejected
+    ProductExecutionStarted = $log.Contains('Prepare: ')
+    ProcessExitCode = $code
+    Complete = $rejected
+} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $outputPath 'negative-controls.json') -Encoding utf8
+if (-not $rejected) { throw 'The invalid gen_server oracle receipt was not rejected before execution.' }
diff --git a/tools/validate-gen-server-original.ps1 b/tools/validate-gen-server-original.ps1
new file mode 100644
--- /dev/null
+++ b/tools/validate-gen-server-original.ps1
@@ -0,0 +1,57 @@
+param(
+    [string]$Admission,
+    [string]$Output
+)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Validation/GenServerValidationContract.ps1')
+if (-not $Admission) { $Admission = $GenServerOracle.DefaultAdmission }
+if (-not $Output) { $Output = $GenServerOracle.DefaultOutput }
+$repository = Split-Path $PSScriptRoot -Parent
+Push-Location $repository
+try {
+    $profile = Get-Content -LiteralPath $Admission -Raw | ConvertFrom-Json
+    if ($profile.ReleaseVersion -cne $GenServerOracle.Release -or
+        $profile.SourceCommit -cne $GenServerOracle.Commit -or
+        -not $profile.EveryExtractedFileMatchesArchive -or
+        (Get-FileHash -LiteralPath $profile.ExecutionManifestPath).Hash -cne $profile.ExecutionManifestSha256) {
+        throw $GenServerOracle.AdmissionFailure
+    }
+    $inventory = Get-Content -LiteralPath $profile.ExecutionManifestPath -Raw | ConvertFrom-Json
+    $closure = @($inventory | Where-Object {
+        $_.Path -eq $GenServerOracle.Launcher -or $_.Path -match $GenServerOracle.RuntimeClosurePattern -or
+        $_.Path -match $GenServerOracle.LibraryClosurePattern
+    })
+    if ($closure.Count -lt $GenServerOracle.MinimumClosureFiles) { throw $GenServerOracle.IncompleteClosure }
+    function Test-Closure {
+        foreach ($entry in $closure) {
+            if ((Get-FileHash -LiteralPath (Join-Path $profile.InstalledOtpRoot $entry.Path)).Hash -cne $entry.Sha256) {
+                throw $GenServerOracle.InputChanged
+            }
+        }
+    }
+    Test-Closure
+    $directory = [IO.Path]::GetFullPath($Output)
+    if (Test-Path -LiteralPath $directory) { throw $GenServerOracle.ExistingOutput }
+    New-Item -ItemType Directory -Path $directory | Out-Null
+    $relative = [IO.Path]::GetRelativePath($repository,$directory).Replace('\','/')
+    if ($relative.Contains('"') -or $relative.Contains("`n")) { throw $GenServerOracle.UnsupportedPath }
+    $expression = $GenServerOracle.CaptureExpression.Replace('{0}', $GenServerOracle.CompanionSource).Replace('{1}', $GenServerOracle.ObserverSource).Replace('{2}', $relative)
+    & (Join-Path $profile.InstalledOtpRoot $GenServerOracle.Launcher) $GenServerOracle.NoShellOption $GenServerOracle.EvalOption $expression 2>&1 | Tee-Object -FilePath (Join-Path $directory $GenServerOracle.Log)
+    if ($LASTEXITCODE -ne 0) { throw $GenServerOracle.CaptureFailure }
+    Test-Closure
+    [ordered]@{
+        SuiteSourceSha256=(Get-FileHash -LiteralPath 'tools/Validation/Erlang.GenServerCompatibility/Reference/gen_server_SUITE.erl').Hash
+        SuiteBeamSha256=(Get-FileHash -LiteralPath (Join-Path $directory 'gen_server_SUITE.beam')).Hash
+        Baseline=$profile.ReleaseTag; Commit=$profile.SourceCommit
+        ExecutionManifestSha256=$profile.ExecutionManifestSha256; Inputs=$closure
+        ObserverSourceSha256=(Get-FileHash -LiteralPath $GenServerOracle.ObserverSource).Hash
+        ObserverBeamSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.ObserverBeam)).Hash
+        CompanionSourceSha256=(Get-FileHash -LiteralPath $GenServerOracle.CompanionSource).Hash
+        CompanionBeamSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.CompanionBeam)).Hash
+        ExportsSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.Exports)).Hash
+        CorpusSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.Corpus)).Hash
+        EffectsSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.Effects)).Hash
+        FeatureBootstrapSha256=(Get-FileHash (Join-Path $directory $GenServerOracle.FeatureBootstrap)).Hash
+    } | ConvertTo-Json -Depth $GenServerOracle.ProvenanceJsonDepth | Set-Content -LiteralPath (Join-Path $directory $GenServerOracle.Provenance) -Encoding utf8
+}
+finally { Pop-Location }
