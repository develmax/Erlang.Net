[{root_defaults,["<!DOCTYPE HTML PUBLIC \"",
                 "-//W3C//DTD HTML 4.01 Transitional//EN","\"",[],">\n",
                 "hello"]},
 {root_attributes,["<!DOCTYPE HTML PUBLIC \"","Example","\"",
                   [" \"","https://example.invalid/type","\""],
                   ">\n","hello"]},
 {root_invalid_ancestor,error,function_clause,
                        [{xmerl_html,'#root#',4,
                                     [{file,"xmerl_html.erl"},{line,64}]}]},
 {void_element,[["<","br",">"],[]]},
 {normal_element,[["<","div",">"],"hello",["</","div",">"]]},
 {empty_paragraph,[["<","p",">"]," ",["</","p",">"]]},
 {ordinary_text,"a&amp;b&lt;c"},
 {cdata,"a&amp;b&lt;c"},
 {comment,"<!--adjacent-->"}].
