    {
      "Marker": "case ERTS_PI_IX_TOTAL_HEAP_SIZE:",
      "FirstLine": 2021,
      "Lines": [
        "    case ERTS_PI_IX_TOTAL_HEAP_SIZE: {",
        "\tUint total_heap_size;",
        "\tUint hsz = 0;",
        "",
        "\ttotal_heap_size = rp->heap_sz;",
        "\tif (rp->old_hend && rp->old_heap)",
        "\t    total_heap_size += rp->old_hend - rp->old_heap;",
        "",
        "\ttotal_heap_size += rp->mbuf_sz;",
        "",
        "        ASSERT(flags & ERTS_PI_FLAG_NEED_MSGQ);",
        "        if (rp->sig_qs.flags & FS_ON_HEAP_MSGQ) {",
        "            ErtsMessage *mp;",
        "            for (mp = rp->sig_qs.first; mp; mp = mp->next) {",
        "\t\tif (ERTS_SIG_IS_RECV_MARKER(mp))",
        "\t\t    continue;",
        "                ASSERT(ERTS_SIG_IS_MSG(mp));",
        "                if (mp->data.attached)",
        "                    total_heap_size += erts_msg_attached_data_size(mp);",
        "            }",
        "            *reds += (Uint) rp->sig_qs.mq_len / 4;",
        "        }",
        "",
        "\t(void) erts_bld_uint(NULL, &hsz, total_heap_size);",
        "        hp = erts_produce_heap(hfact, hsz, reserve_size);",
        "\tres = erts_bld_uint(&hp, NULL, total_heap_size);",
        "\tbreak;",
        "    }"
      ]
    },
