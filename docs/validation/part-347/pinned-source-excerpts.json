        "    case ERTS_PI_IX_GARBAGE_COLLECTION: {",
        "        DECL_AM(minor_gcs);",
        "        Eterm t, mhs_map;",
        "",
        "        mhs_map = erts_max_heap_size_map(hfact, MAX_HEAP_SIZE_GET(rp),",
        "                                         MAX_HEAP_SIZE_FLAGS_GET(rp));",
        "",
        "        hp = erts_produce_heap(hfact, 5*(3+2), reserve_size);",
        "",
        "\tt = TUPLE2(hp, AM_minor_gcs, make_small(GEN_GCS(rp))); hp += 3;",
        "\tres = CONS(hp, t, NIL); hp += 2;",
        "\tt = TUPLE2(hp, am_fullsweep_after, make_small(MAX_GEN_GCS(rp))); hp += 3;",
        "\tres = CONS(hp, t, res); hp += 2;",
        "",
        "\tt = TUPLE2(hp, am_min_heap_size, make_small(MIN_HEAP_SIZE(rp))); hp += 3;",
        "\tres = CONS(hp, t, res); hp += 2;",
        "\tt = TUPLE2(hp, am_min_bin_vheap_size, make_small(rp->min_vheap_size)); hp += 3;",
        "\tres = CONS(hp, t, res); hp += 2;",
        "",
        "\tt = TUPLE2(hp, am_max_heap_size, mhs_map); hp += 3;",
        "\tres = CONS(hp, t, res); hp += 2;",
        "\tbreak;",
        "    }",
