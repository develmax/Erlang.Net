diff --git a/tools/Erlang.Numeric372OriginalObservations/passive_etf_family.py b/tools/Erlang.Numeric372OriginalObservations/passive_etf_family.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d5a6af98664786b34396b0d4a67dda82ceb11a2
--- /dev/null
+++ b/tools/Erlang.Numeric372OriginalObservations/passive_etf_family.py
@@ -0,0 +1,168 @@
+# Passive bounded diagnostic decoder, never an Erlang evaluator.
+# Baseline decode_one copied from the hash-bound existing verifier; extension.diff
+# contains every parser change. This bounded profile rejects COMPRESSED/FUN_EXT.
+MAX_BYTES = 16 * 1024 * 1024
+MAX_DEPTH = 128
+MAX_TERMS = 8_000_000
+VERSION = 131
+
+
+def require(value, message):
+    if not value:
+        raise ValueError(message)
+
+
+
+def baseline_map_key(value):
+    # Provenance spans must never become map-key semantic identity. Restrict
+    # map keys to the original decoder profile; extended terms remain values.
+    if value[0] in ('atom', 'integer', 'binary', 'reference'):
+        return True
+    if value[0] == 'float_bits':
+        # Finite IEEE-754 keys, with negative zero explicitly outside this profile.
+        import math, struct
+        bits = value[1]
+        return len(bits) == 8 and bits != b'\x80' + b'\x00' * 7 and math.isfinite(struct.unpack('>d', bits)[0])
+    if value[0] in ('tuple', 'list'):
+        return all(baseline_map_key(item) for item in value[1])
+    if value[0] == 'improper':
+        return all(baseline_map_key(item) for item in value[1]) and baseline_map_key(value[2])
+    if value[0] == 'map':
+        return all(baseline_map_key(key) and baseline_map_key(item) for key, item in value[1])
+    return False
+
+
+def decode_one(data):
+    require(len(data) <= MAX_BYTES and len(data) > 1 and data[0] == VERSION, 'ETF version/size')
+    position = 1
+    decoded_terms = 0
+
+    def reserve_terms(count):
+        nonlocal decoded_terms
+        require(0 <= count <= MAX_TERMS - decoded_terms, 'Aggregate decoded term budget')
+        decoded_terms += count
+
+    def require_room(count):
+        require(0 <= count <= MAX_TERMS - decoded_terms, 'Container exceeds remaining term budget')
+
+    def take(count):
+        nonlocal position
+        require(count >= 0 and position + count <= len(data), 'Truncated ETF')
+        result = data[position:position + count]
+        position += count
+        return result
+
+    def count32():
+        return int.from_bytes(take(4), 'big')
+
+    def term(depth):
+        require(depth <= MAX_DEPTH, 'ETF diagnostic depth limit')
+        reserve_terms(1)
+        tag = take(1)[0]
+        if tag == 97:
+            return ('integer', take(1)[0])
+        if tag == 98:
+            return ('integer', int.from_bytes(take(4), 'big', signed=True))
+        if tag in (110, 111):
+            count = take(1)[0] if tag == 110 else count32()
+            sign = take(1)[0]
+            require(sign in (0, 1), 'Invalid big integer sign')
+            number = int.from_bytes(take(count), 'little')
+            return ('integer', -number if sign else number)
+        if tag in (100, 115, 118, 119):
+            size = take(1)[0] if tag in (115, 119) else int.from_bytes(take(2), 'big')
+            return ('atom', take(size).decode('utf-8' if tag in (118, 119) else 'latin1'))
+        if tag in (104, 105):
+            size = take(1)[0] if tag == 104 else count32()
+            require(size <= len(data) - position, 'Tuple size exceeds available data')
+            require_room(size)
+            return ('tuple', tuple(term(depth + 1) for _ in range(size)))
+        if tag == 106:
+            return ('list', ())
+        if tag == 107:
+            size = int.from_bytes(take(2), 'big')
+            reserve_terms(size)
+            return ('list', tuple(('integer', byte) for byte in take(size)))
+        if tag == 108:
+            size = count32()
+            require(size <= len(data) - position, 'List size exceeds available data')
+            require_room(size + 1)
+            items = tuple(term(depth + 1) for _ in range(size))
+            tail = term(depth + 1)
+            if tail[0] == 'list':
+                return ('list', items + tail[1])
+            if tail[0] == 'improper':
+                return ('improper', items + tail[1], tail[2])
+            return ('improper', items, tail)
+        if tag == 116:
+            size = count32()
+            require(size <= (len(data) - position) // 2, 'Map size exceeds available data')
+            require_room(size * 2)
+            pairs = [(term(depth + 1), term(depth + 1)) for _ in range(size)]
+            require(all(baseline_map_key(key) for key, _ in pairs), 'Extended identity-bearing map key outside diagnostic profile')
+            require(len({key for key, _ in pairs}) == size, 'Duplicate map key')
+            return ('map', frozenset(pairs))
+        if tag in (88, 103):
+            node = term(depth + 1)
+            require(node[0] == 'atom', 'PID node must be atom')
+            identity, serial = count32(), count32()
+            creation = count32() if tag == 88 else take(1)[0]
+            require(tag == 88 or creation <= 3, 'Legacy PID creation bits')
+            return ('pid', node, identity, serial, creation, tag)
+        if tag in (102, 89, 120):
+            node = term(depth + 1)
+            require(node[0] == 'atom', 'Port node must be atom')
+            identity = int.from_bytes(take(8 if tag == 120 else 4), 'big')
+            creation = count32() if tag != 102 else take(1)[0]
+            require(tag != 102 or creation <= 3, 'Legacy port creation bits')
+            return ('port', node, identity, creation, tag)
+        if tag in (90, 114):
+            count = int.from_bytes(take(2), 'big')
+            require(1 <= count <= 5, 'Reference word count bound')
+            node = term(depth + 1)
+            require(node[0] == 'atom', 'Reference node must be atom')
+            creation = count32() if tag == 90 else take(1)[0]
+            require(tag == 90 or creation <= 3, 'Legacy reference creation bits')
+            return ('reference', node, creation, tuple(count32() for _ in range(count)), tag)
+        if tag == 109:
+            return ('binary', take(count32()))
+        if tag == 77:
+            count = count32()
+            bits = take(1)[0]
+            require(count > 0 and 1 <= bits <= 8, 'Bit binary dimensions')
+            value = take(count)
+            require(value[-1] & ((1 << (8 - bits)) - 1) == 0, 'Bit binary padding')
+            return ('bit_binary', value, bits)
+        if tag == 70:
+            return ('float_bits', take(8))
+        if tag == 113:
+            module, function, arity = term(depth + 1), term(depth + 1), term(depth + 1)
+            require(module[0] == function[0] == 'atom' and arity[0] == 'integer' and 0 <= arity[1] <= 255, 'Export fun shape')
+            return ('export_fun', module, function, arity)
+        if tag == 112:
+            reserve_terms(16)
+            size_start = position
+            size = count32()
+            end = size_start + size
+            require(size >= 4 and end <= len(data), 'New fun declared size bound')
+            arity = take(1)[0]
+            uniq, index, count = take(16), count32(), count32()
+            require(count <= end - position, 'New fun free count bound')
+            require_room(count + 4)
+            module, old_index, old_uniq, pid = (term(depth + 1) for _ in range(4))
+            require(module[0] == 'atom' and old_index[0] == old_uniq[0] == 'integer' and pid[0] == 'pid', 'New fun fixed field types')
+            free = tuple(term(depth + 1) for _ in range(count))
+            require(position == end, 'New fun exact declared boundary')
+            # Passive original-file span: never copy nested fun encodings.
+            # The guard records the raw ETF file SHA; this span recovers exact bytes.
+            return ('new_fun', size, arity, uniq, index, module, old_index, old_uniq, pid, free, ('raw_span', size_start - 1, end - size_start + 1))
+        raise ValueError('Unsupported ETF tag: ' + str(tag))
+
+    result = term(0)
+    return result, position
+
+
+def decode_exact(data):
+    result, used = decode_one(data)
+    require(used == len(data), 'Trailing bytes in result ETF')
+    return result
diff --git a/tools/Erlang.Numeric372OriginalObservations/preloaded_provenance.py b/tools/Erlang.Numeric372OriginalObservations/preloaded_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..940d675b1f9dcb19dcb858ed300c8242ee97ccef
--- /dev/null
+++ b/tools/Erlang.Numeric372OriginalObservations/preloaded_provenance.py
@@ -0,0 +1,123 @@
+"""Linux ERTS/preloaded-module provenance; never claims disk companion is loaded code."""
+from pathlib import Path
+import hashlib,subprocess
+
+SCHEMA='erlang-preloaded-v1'
+POLICY='compiled-monitored-worker-values-and-stacks-v1'
+
+def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest().upper()
+
+def module_md5(data):
+    assert len(data)<=32*1024*1024 and data[:4]==b'FOR1' and data[8:12]==b'BEAM'
+    assert int.from_bytes(data[4:8],'big')+8==len(data)
+    chunks={};position=12
+    while position<len(data):
+        assert position+8<=len(data)
+        name=data[position:position+4].decode('ascii');size=int.from_bytes(data[position+4:position+8],'big')
+        assert name not in chunks and position+8+size<=len(data)
+        chunks[name]=data[position+8:position+8+size];position+=8+((size+3)//4)*4
+    assert position==len(data) and all(name in chunks for name in ['Code','StrT','ImpT','ExpT'])
+    significant=[]
+    for name in ['Atom','AtU8','Code','StrT','ImpT','ExpT','FunT','LitT','Meta','Recs','DbgB']:
+        if name not in chunks:continue
+        chunk=chunks[name]
+        if name=='FunT':
+            chunk=bytearray(chunk)
+            for offset in range(4,len(chunk)-23,24):chunk[offset+20:offset+24]=b'\0'*4
+            chunk=bytes(chunk)
+        significant.append(chunk)
+    return hashlib.md5(b''.join(significant)).digest()
+
+def preloaded_module_md5(data):
+    assert len(data)<=32*1024*1024 and data[:4]==b'FOR1' and data[8:12]==b'BEAM'
+    assert int.from_bytes(data[4:8],'big')+8==len(data)
+    chunks={};position=12
+    while position<len(data):
+        assert position+8<=len(data)
+        name=data[position:position+4].decode('ascii');size=int.from_bytes(data[position+4:position+8],'big')
+        assert name not in chunks and position+8+size<=len(data)
+        chunks[name]=data[position+8:position+8+size];position+=8+((size+3)//4)*4
+    assert position==len(data) and all(name in chunks for name in ['Code','StrT','ImpT','ExpT'])
+    significant=[]
+    for name in ['AtU8','Code','StrT','ImpT','ExpT','FunT','LitT']:
+        if name not in chunks:continue
+        chunk=chunks[name]
+        if name=='FunT':
+            chunk=bytearray(chunk)
+            for offset in range(4,len(chunk)-23,24):chunk[offset+20:offset+24]=b'\0'*4
+            chunk=bytes(chunk)
+        significant.append(chunk)
+    return hashlib.md5(b''.join(significant)).digest()
+
+def runtime_inputs(runtime,build,tracked,out):
+    rows=build['InstalledFiles']
+    emulator=[r for r in rows if r['Path'].endswith('/bin/beam.smp')]
+    companion=[r for r in rows if r['Path'].endswith('/erlang.beam')]
+    assert len(emulator)==len(companion)==1
+    executable=(runtime/emulator[0]['Path']).resolve();beam=(runtime/companion[0]['Path']).resolve()
+    assert executable.is_relative_to(runtime) and beam.is_relative_to(runtime)
+    assert sha(executable)==emulator[0]['Sha256'] and sha(beam)==companion[0]['Sha256']
+    raw=beam.read_bytes();(out/'erlang-preloaded-companion.beam').write_bytes(raw)
+    preload_path='erts/preloaded/ebin/erlang.beam'
+    preload_row=next(x for x in tracked['TrackedFiles'] if x['Path']==preload_path)
+    pin='ad05823719d77c8faee87348ea39513d4e2f99c5'
+    preload=subprocess.check_output(['git','-C',build['SourceRoot'],'show',pin+':'+preload_path],timeout=30)
+    assert len(preload)==preload_row['Bytes'] and hashlib.sha256(preload).hexdigest().upper()==preload_row['Sha256']
+    (out/'erlang-pinned-preload-authority.beam').write_bytes(preload)
+    predicted=preloaded_module_md5(preload).hex().upper()
+
+    return dict(PinnedPreloadBeam=preload_row,PinnedMakePreload=next(x for x in tracked['TrackedFiles'] if x['Path']=='erts/emulator/utils/make_preload'),PredictedPreloadModuleMd5=predicted,MetadataPolicy=SCHEMA,InstalledEmulatorPath=str(executable),InstalledEmulatorSha256=sha(executable),InstalledEmulatorMd5=hashlib.md5(executable.read_bytes()).hexdigest().upper(),InstalledEmulatorBytes=executable.stat().st_size,InstalledCompanionPath=str(beam),InstalledCompanionSha256=sha(beam),InstalledCompanionModuleMd5=module_md5(raw).hex().upper(),CompanionIsLoadedObjectClaimed=False,PinnedErlangSource=next(x for x in tracked['TrackedFiles'] if x['Path']=='erts/preloaded/src/erlang.erl'),PinnedBifTable=next(x for x in tracked['TrackedFiles'] if x['Path']=='erts/emulator/beam/bif.tab'))
+
+def expression_prefix(loads,module,names):
+    assert all(c.isalnum() or c=='_' for c in module+names)
+    return ('O=os:getenv("FAMILY_OUTPUT"),E=os:getenv("FAMILY_EBIN"),'+loads+
+        ',{module,erlang}=code:ensure_loaded(erlang),{ok,Executable}=file:read_link("/proc/self/exe"),'+
+        '{ok,ExecutableBytes}=file:read_file("/proc/self/exe"),'+
+        'M=#{schema=>erlang_preloaded_v1,subject=>erlang,root=>code:root_dir(),which=>code:which(erlang),loaded=>code:is_loaded(erlang),'+
+        'module_md5=>erlang:module_info(md5),exports=>erlang:module_info(exports),exe=>Executable,exe_md5=>erlang:md5(ExecutableBytes),exe_bytes=>byte_size(ExecutableBytes),'+
+        'os_pid=>os:getpid(),erts_version=>erlang:system_info(version),otp_release=>erlang:system_info(otp_release),system_architecture=>erlang:system_info(system_architecture),'+
+        'emu_flavor=>erlang:system_info(emu_flavor),build_type=>erlang:system_info(build_type),schedulers=>erlang:system_info(schedulers),schedulers_online=>erlang:system_info(schedulers_online),'+
+        'fixture_file=>code:which('+module+'),names=>'+module+':'+names+'(),value_acquisition=>"'+POLICY+'"},'+
+        'ok=file:write_file(filename:join(O,"metadata.etf"),term_to_binary(M)),')
+
+def text(node):
+    assert node[0]=='list' and all(x[0]=='integer' and 0<=x[1]<=0x10ffff for x in node[1])
+    return ''.join(chr(x[1]) for x in node[1])
+
+def fields(node):
+    assert node[0]=='map' and all(k[0]=='atom' for k,v in node[1])
+    result={k[1]:v for k,v in node[1]};assert len(result)==len(node[1])
+    return result
+
+def validate(node,inputs,runtime,fixture,ebin,pid,selected):
+    data=fields(node)
+    expected={'schema','subject','root','which','loaded','module_md5','exports','exe','exe_md5','exe_bytes','os_pid','erts_version','otp_release','system_architecture','emu_flavor','build_type','schedulers','schedulers_online','fixture_file','names','value_acquisition'}
+    assert set(data)==expected
+    assert data['schema']==('atom','erlang_preloaded_v1') and data['subject']==('atom','erlang')
+    assert data['which']==('atom','preloaded') and data['loaded']==('tuple',(('atom','file'),('atom','preloaded')))
+    assert Path(text(data['root'])).resolve()==runtime
+    assert Path(text(data['exe'])).resolve()==Path(inputs['InstalledEmulatorPath']).resolve()
+    assert data['exe_md5']==('binary',bytes.fromhex(inputs['InstalledEmulatorMd5'])) and data['exe_bytes']==('integer',inputs['InstalledEmulatorBytes'])
+    assert text(data['os_pid'])==str(pid)
+    assert data['module_md5']==('binary',bytes.fromhex(inputs['PredictedPreloadModuleMd5']))
+    assert text(data['otp_release'])=='29' and text(data['erts_version']) and text(data['system_architecture'])
+    assert data['emu_flavor'][0]==data['build_type'][0]=='atom'
+    assert data['schedulers']==data['schedulers_online']==('integer',2)
+    assert Path(text(data['fixture_file'])).resolve()==(ebin/(fixture['Module']+'.beam')).resolve()
+    assert data['names']==('list',tuple(('atom',x) for x in fixture['Names'])) and text(data['value_acquisition'])==POLICY
+    exports=data['exports'];assert exports[0]=='list'
+    table=[]
+    for row in exports[1]:
+        assert row[0]=='tuple' and len(row[1])==2 and row[1][0][0]=='atom' and row[1][1][0]=='integer'
+        table.append('erlang:'+row[1][0][1]+'/'+str(row[1][1][1]))
+    assert len(table)==len(set(table)) and set(selected)<=set(table)
+    return dict(MetadataPolicy=SCHEMA,ActualEmulatorBound=True,PreloadedModuleMd5MatchesPinnedEmbedding=True,CompanionIsLoadedObjectClaimed=False,RecordedExportCount=len(table),SelectedMfasPresent=len(selected),OsPid=pid,ValueAcquisition=POLICY)
+
+def validate_outcome(node,stacked):
+    assert node[0]=='tuple' and len(node[1])>=2
+    parts=node[1]
+    if parts[0]==('atom','ok'):assert len(parts)==2
+    else:
+        assert parts[0]==('atom','error') and len(parts)==(4 if stacked else 3)
+        assert parts[1][0]=='atom' and parts[1][1] in ['error','exit','throw']
+        if stacked:assert parts[3][0]=='list'
