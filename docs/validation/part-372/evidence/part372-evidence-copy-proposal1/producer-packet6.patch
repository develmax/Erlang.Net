new file mode 100644
index 0000000000000000000000000000000000000000..a5332456efd8c3f527e463ac934defe6e1af3a81
--- /dev/null
+++ b/tools/Erlang.Numeric372OriginalObservations/original/erlang370_observation_worker.erl
@@ -0,0 +1,29 @@
+-module(erlang370_observation_worker).
+-export([run/2,worker/1]).
+run(Module,Entry) ->
+    {Pid,Ref}=spawn_monitor(erlang370_observation_worker,worker,[{self(),Module,Entry}]),
+    wait_result(Pid,Ref).
+worker({Parent,Module,Entry}) ->
+    Rows=erlang:apply(Module,Entry,[]),
+    Parent!{self(),Rows},
+    normal.
+wait_result(Pid,Ref) ->
+    receive
+        {Pid,Rows} -> wait_down(Pid,Ref,Rows);
+        {'DOWN',Ref,process,Pid,Reason} -> erlang:error({observer_worker_failed,Reason})
+    after worker_timeout() -> abort(Pid,Ref)
+    end.
+wait_down(Pid,Ref,Rows) ->
+    receive
+        {'DOWN',Ref,process,Pid,normal} -> Rows;
+        {'DOWN',Ref,process,Pid,Reason} -> erlang:error({observer_worker_failed,Reason})
+    after cleanup_timeout() -> abort(Pid,Ref)
+    end.
+abort(Pid,Ref) ->
+    exit(Pid,kill),
+    receive
+        {'DOWN',Ref,process,Pid,_} -> erlang:error(observer_worker_timeout)
+    after cleanup_timeout() -> erlang:error(observer_worker_cleanup_timeout)
+    end.
+worker_timeout() -> 540000.
+cleanup_timeout() -> 5000.
diff --git a/tools/Erlang.Numeric372OriginalObservations/original/erlang370_pure_support.erl b/tools/Erlang.Numeric372OriginalObservations/original/erlang370_pure_support.erl
new file mode 100644
index 0000000000000000000000000000000000000000..4c441101275d3ba21c6415d5e6dfd22d955f53ca
--- /dev/null
+++ b/tools/Erlang.Numeric372OriginalObservations/original/erlang370_pure_support.erl
@@ -0,0 +1,19 @@
+-module(erlang370_pure_support).
+-export([run/2,profiles/2,invoke/2,float_bits/1]).
+run(Module,Names) -> [{Name,value(Module,Name)} || Name <- Names].
+value(Module,Name) ->
+    try erlang:apply(Module,probe,[Name]) of Value -> {ok,Value}
+    catch Class:Reason -> {error,Class,Reason} end.
+profiles(Module,Names) ->
+    Default = {default,[{Name,capture(Module,Name)} || Name <- Names]},
+    Old = erlang:system_flag(backtrace_depth,8),
+    try [Default | [at_depth(Depth,Module,Names) || Depth <- [0,1,2,8]]]
+    after erlang:system_flag(backtrace_depth,Old) end.
+at_depth(Depth,Module,Names) ->
+    erlang:system_flag(backtrace_depth,Depth),
+    {Depth,[{Name,capture(Module,Name)} || Name <- Names]}.
+capture(Module,Name) ->
+    try erlang:apply(Module,probe,[Name]) of Value -> {ok,Value}
+    catch Class:Reason:Stack -> {error,Class,Reason,Stack} end.
+invoke(Function,Arguments) -> erlang:apply(erlang,Function,Arguments).
+float_bits(Bits) -> <<Value:64/float>> = <<Bits:64>>,Value.
