index 0000000000000000000000000000000000000000..26a26b38445b54d37108d213457a7e21aa1f51b9
--- /dev/null
+++ b/tools/Erlang.Ordsets372OriginalObservations/original/ordsets_core_support.erl
@@ -0,0 +1,17 @@
+-module(ordsets_core_support).
+-export([run/2,profiles/2]).
+run(Module,Names) -> [{Name,value(Module,Name)} || Name <- Names].
+value(Module,Name) ->
+    try erlang:apply(Module,probe,[Name]) of Value -> {ok,Value}
+    catch Class:Reason -> {error,Class,Reason} end.
+profiles(Module,Names) ->
+    Default = {default,[{Name,capture(Module,Name)} || Name <- Names]},
+    Old = erlang:system_flag(backtrace_depth,8),
+    try [Default | [at_depth(Depth,Module,Names) || Depth <- [0,1,2,8]]]
+    after erlang:system_flag(backtrace_depth,Old) end.
+at_depth(Depth,Module,Names) ->
+    erlang:system_flag(backtrace_depth,Depth),
+    {Depth,[{Name,capture(Module,Name)} || Name <- Names]}.
+capture(Module,Name) ->
+    try erlang:apply(Module,probe,[Name]) of Value -> {ok,Value}
+    catch Class:Reason:Stack -> {error,Class,Reason,Stack} end.
diff --git a/tools/Erlang.Ordsets372OriginalObservations/original/ordsets_core_worker.erl b/tools/Erlang.Ordsets372OriginalObservations/original/ordsets_core_worker.erl
new file mode 100644
index 0000000000000000000000000000000000000000..56c400f87b079b4bd1a6bd2c0d28957b5e1dc28c
--- /dev/null
+++ b/tools/Erlang.Ordsets372OriginalObservations/original/ordsets_core_worker.erl
@@ -0,0 +1,29 @@
+-module(ordsets_core_worker).
+-export([run/2,worker/1]).
+run(Module,Entry) ->
+    {Pid,Ref}=spawn_monitor(ordsets_core_worker,worker,[{self(),Module,Entry}]),
+    wait_result(Pid,Ref).
+worker({Parent,Module,Entry}) ->
+    Rows=erlang:apply(Module,Entry,[]),
+    Parent!{self(),Rows},
+    normal.
+wait_result(Pid,Ref) ->
+    receive
+        {Pid,Rows} -> wait_down(Pid,Ref,Rows);
+        {'DOWN',Ref,process,Pid,Reason} -> erlang:error({observer_worker_failed,Reason})
+    after worker_timeout() -> abort(Pid,Ref)
+    end.
+wait_down(Pid,Ref,Rows) ->
+    receive
+        {'DOWN',Ref,process,Pid,normal} -> Rows;
+        {'DOWN',Ref,process,Pid,Reason} -> erlang:error({observer_worker_failed,Reason})
+    after cleanup_timeout() -> abort(Pid,Ref)
+    end.
+abort(Pid,Ref) ->
+    exit(Pid,kill),
+    receive
+        {'DOWN',Ref,process,Pid,_} -> erlang:error(observer_worker_timeout)
+    after cleanup_timeout() -> erlang:error(observer_worker_cleanup_timeout)
+    end.
+worker_timeout() -> 540000.
+cleanup_timeout() -> 5000.
