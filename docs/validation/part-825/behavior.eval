Dir = "artifacts/beam-backend/part825-images",
Stubs = [
    {ssl_config, "-module(ssl_config).\n-export([pre_1_3_session_opts/1]).\npre_1_3_session_opts(server) -> self() ! config_called, get(fixture_options).\n"},
    {ssl_server_session_cache, "-module(ssl_server_session_cache).\n-export([start_link/2]).\nstart_link(_, {Caller, new}) -> Caller ! started, {ok, spawn_link(fun() -> receive stop -> ok end end)}; start_link(_, {Caller, existing}) -> Caller ! conflict, {error,{already_started,Caller}}; start_link(_, {Caller, failed}) -> Caller ! failed, {error,fixture_failure}.\n"}],
lists:foreach(fun({Mod, Source}) ->
    Path = filename:join(Dir, atom_to_list(Mod) ++ ".erl"),
    ok = file:write_file(Path, Source),
    {ok, Mod, Stub} = compile:file(Path, [binary]),
    {module, Mod} = code:load_binary(Mod, Path, Stub)
end, Stubs),
Module = ssl_upgrade_server_session_cache_sup,
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Caller = self(),
    {ok, Normal} = Module:start_link(),
    {ok, Dist} = Module:start_link_dist(),
    Normal = whereis(Module),
    Dist = whereis(ssl_upgrade_server_session_cache_sup_dist),
    Expect = fun(Event) -> receive Event -> ok after 1000 -> error({timeout, Event}) end end,
    put(fixture_options, {Caller, new}),
    {ok, Worker} = Module:start_child(normal),
    Expect(config_called), Expect(started),
    {ok, Worker} = Module:start_child(normal),
    receive config_called -> error(unexpected_config_call) after 0 -> ok end,
    {ok, Second} = supervisor:start_child(Normal, [manual, {Caller, new}]),
    true = Worker =/= Second,
    Expect(started),
    CountFailure = try Module:start_child(normal) catch error:{case_clause,2}:S1 -> S1 end,
    [{Module,start_child,1,_}|_] = CountFailure,
    put(fixture_options, {Caller, existing}),
    {ok, Caller} = Module:start_child(dist),
    Expect(config_called), Expect(conflict),
    put(fixture_options, {Caller, failed}),
    StartFailure = try Module:start_child(dist) catch error:{case_clause,{error,fixture_failure}}:S2 -> S2 end,
    Expect(config_called), Expect(failed),
    [{Module,start_child,1,_}|_] = StartFailure,
    ok = gen_server:stop(Normal),
    ok = gen_server:stop(Dist),
    {Module:init([]), CountFailure, StartFailure}
end,
Otp = Run(code:which(Module)),
Otp = Run(filename:join(Dir, atom_to_list(Module) ++ ".beam")),
erlang:display({Module, equal}),
halt().
