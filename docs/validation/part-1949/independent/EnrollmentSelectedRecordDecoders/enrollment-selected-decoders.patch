diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.SelectedRecordSequenceDecoder.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.SelectedRecordSequenceDecoder.cs
