+                    owner.MoveToX0(XRegisterTag, 1);
+                }
+
+                owner.EmitConstant(field.Constants[0], 1);
+                owner.EmitCallLine(field.Call, previous);
+                previous = CallLocation(field.Call, previous);
+                if (index == foreignIndex)
