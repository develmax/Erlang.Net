+                        owner.MoveRegister(
+                            XRegisterTag,
+                            0,
+                            YRegisterTag,
+                            slots[index]
+                        );
+                    }
+
+                    EmitTupleShapeTest(
+                        XRegisterTag,
+                        0,
+                        2,
+                        badPair
+                    );
+                    pending = false;
