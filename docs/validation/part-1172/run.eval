[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    {function,option,1,_,Is}=lists:keyfind(option,2,Fs),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_wx_option_class_probe,Path,B),
    Initial={initial,{wx_ref,1,wxFont,[]}},
    Validator={validator,{wx_ref,1,wx,[]}},
    Position={pos,{1,2}},
    Initial=M:option(Initial),
    Validator=M:option(Validator),
    Position=M:option(Position),
    {badoption,{initial,bad}}=(try M:option({initial,bad}) catch error:R->R end),
    code:purge(M),
    code:delete(M),
    Is
end,
E=Read(P),
A=Read(Q),
io:format("Exact instructions: ~p~n~p~n~p~n",[E=:=A,E,A]),
true=E=:=A,
halt().
