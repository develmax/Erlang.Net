Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",
Actual="artifacts/beam-backend/part680-eldap/ELDAPv3.release-profile.beam",
Old="artifacts/beam-backend/part679-eldap/ELDAPv3.release-profile.beam",
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),maps:from_list([{{N,A},I}||{function,N,A,_,I}<-Fs]) end,
Norm=fun(I)->
    Labels=[L||{label,L}<-I],
    Map=maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    F=fun R({label,L})->{label,maps:get(L,Map,L)};
          R({f,L})->{f,maps:get(L,Map,L)};

          R(T) when is_tuple(T)->list_to_tuple([R(E)||E<-tuple_to_list(T)]);
          R(L) when is_list(L)->[R(E)||E<-L];
          R(X)->X end,
    [F(Op)||Op<-I]
end,
A=Read(Actual),R=Read(Release),O=Read(Old),
Rows=lists:sort([{length(OldOps)-length(New),K,length(maps:get(K,R)),length(OldOps),length(New)}||{K,New}<-maps:to_list(A),OldOps<-[maps:get(K,O)],length(OldOps)=/=length(New)]),
Equal=[K||{_,K,_,_,_}<-Rows,Norm(maps:get(K,A))=:=Norm(maps:get(K,R))],io:format("changed=~p~n~p~nequal_after_normalizing_labels=~p~n",[length(Rows),lists:reverse(Rows),Equal]),halt().