4530: static Eterm load_nif_error(Process* p, const char* atom, const char* format, ...)
4531: {
4532:     erts_dsprintf_buf_t* dsbufp = erts_create_tmp_dsbuf(0);
4533:     Eterm ret;
4534:     Eterm* hp;
4535:     Eterm** hpp = NULL;
4536:     Uint sz = 0;
4537:     Uint* szp = &sz;
4538:     va_list arglist;   
4539: 
4540:     va_start(arglist, format);
4541:     erts_vdsprintf(dsbufp, format, arglist);
4542:     va_end(arglist);
4543:     
4544:     for (;;) {
4545: 	Eterm txt = erts_bld_string_n(hpp, &sz, dsbufp->str, dsbufp->str_len);
4546: 	ret = erts_bld_tuple(hpp, szp, 2, am_error,
4547: 			     erts_bld_tuple(hpp, szp, 2, mkatom(atom), txt));
4548: 	if (hpp != NULL) {
4549: 	    break;
4550: 	}
4551: 	hp = HAlloc(p,sz);
4552: 	hpp = &hp;
4553: 	szp = NULL;
4554:     }
4555:     erts_destroy_tmp_dsbuf(dsbufp);
4556:     return ret;
4557: }
