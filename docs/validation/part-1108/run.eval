[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[{N,Is} || {function,N,_,_,Is}<-Fs,N=:=read orelse N=:=project]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_entry_tagged_projection_probe,Path,B),
    projected=M:read(entry,"projected"),
    42=M:read(entry,42),
    missing=M:read(wrong,42),
    42=M:project({entry,[],42}),
    missing=M:project({wrong,[],42}),
    {error,badarg}=try M:read(entry,[invalid]) of V->{value,V} catch error:R->{error,R} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
