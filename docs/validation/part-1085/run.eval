[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, frame_entry_probe} = code:load_binary(frame_entry_probe, Path, Binary),
{key,first,undefined} = frame_entry_probe:put_value(key,first),
{key,second,first} = frame_entry_probe:put_value(key,second),
{second,key,second} = frame_entry_probe:repeated(key,third),
{third,key,third} = frame_entry_probe:swapped(fourth,key),
{{right,left,left},left} = frame_entry_probe:fanout(left,right),
{guard_key,value} = begin put(guard_key,value), frame_entry_probe:guarded_match(guard_key) end,
{'EXIT',{{badmatch,undefined},_}} = (catch frame_entry_probe:guarded_match(missing)),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Functions, lists:member(Name,[put_value,repeated,swapped,fanout])],
halt().
