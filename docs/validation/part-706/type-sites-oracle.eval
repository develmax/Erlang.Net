A="artifacts/beam-backend/part706-eldap/ELDAPv3.release-profile.beam",O="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",{ok,_,AC}=beam_lib:all_chunks(A),{ok,_,OC}=beam_lib:all_chunks(O),{beam_file,_,_,_,_,Fs}=beam_disasm:file(O),
Types=fun R({tr,_,T}) -> [T]; R(T) when is_tuple(T)->lists:flatmap(R,tuple_to_list(T)); R(L) when is_list(L)->lists:flatmap(R,L); R(_)->[] end,
Interesting=fun(T)->element(1,T)=:=t_cons orelse element(1,T)=:=t_union end,
io:format("~p~n",[[{N,Ar,Op}||{function,N,Ar,_,Ops}<-Fs,Op<-Ops,lists:any(Interesting,Types(Op))]]),halt().
