[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, first_call_probe} = code:load_binary(first_call_probe, Path, Binary),
{keep,undefined} = first_call_probe:retain(a,key,keep),
{keep,a} = first_call_probe:retain(b,key,keep),
{keep,ok} = first_call_probe:discard(c,key,keep),
c = get(key),
{keep,ok} = first_call_probe:bound_unused(d,key,keep),
d = get(key),
{d,ok} = first_call_probe:match_again(e,key,d),
{'EXIT',{{badmatch,e},_}} = (catch first_call_probe:match_again(f,key,bad)),
f = get(key),
undefined = first_call_probe:terminal_external(g,key),
key = get(f),
{keep,{g,g}} = first_call_probe:continue_after(h,key,keep),
{h,key} = first_call_probe:keep_old(i,key),
h = get(sink),
{undefined,first} = first_call_probe:effect_order(computed),
second = get(computed),
{keep,one,keep,two} = first_call_probe:four(four,keep),
stored = get(four),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Functions, lists:member(Name,[retain,discard,bound_unused,match_again,terminal_external,continue_after,keep_old,effect_order,four])],
halt().


