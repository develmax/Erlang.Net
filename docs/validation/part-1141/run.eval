[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [Is]=[Instructions || {function,rebuild,3,_,Instructions}<-Fs],
    io:format("~s~n~p~n",[Path,Is]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_entry_tuple_probe,Path,B),
    {last,saved,7}=M:rebuild(key,[{key,7,last}],saved),
    {error,{badmatch,{key,7}}}=try M:rebuild(key,[{key,7}],saved) of V->{value,V} catch error:R->{error,R} end,
    code:delete(M),
    code:purge(M),
    Ls=[L||{label,L}<-Is],
    Map=maps:from_list(lists:zip(Ls,lists:seq(1,length(Ls)))),
    Rebase=fun R({f,L})->{f,maps:get(L,Map,L)};
                 R(T) when is_tuple(T)->list_to_tuple([R(E)||E<-tuple_to_list(T)]);
                 R(L) when is_list(L)->[R(E)||E<-L];
                 R(E)->E end,
    [Rebase(I)||I<-Is,element(1,I)=/=label]
end,
Reference=Read(P),
Reference=Read(Q),
halt().
