Dir = "artifacts/beam-backend/part837-images",
Module = dtls_socket,
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Pid = self(),
    Native = Module:emulated_options([{mode,binary},{active,false},{reuseaddr,true}]),
    Defaults = Module:emulated_options([]),
    Invalid = try Module:emulated_options([{packet,2}])
        catch throw:Reason -> Reason end,
    {error,{options,{not_supported,{packet,2}}}} = Invalid,
    Address = {{127,0,0,1},4433},
    Socket = Module:socket([Pid],gen_udp,{Address,raw_socket},callback,table),
    {sslsocket,{Address,raw_socket},Pid,Pid,gen_udp,callback,table,undefined} = Socket,
    {ok,Address} = Module:peername(gen_udp,{Address,raw_socket}),
    {Native, Defaults, Invalid, Socket}
end,
Otp = Run(code:which(Module)),
Otp = Run(filename:join(Dir,"dtls_socket.beam")),
erlang:display({Module, selected_cases_equal}),
halt().
