Dir = "artifacts/beam-backend/part837-images",
Module = beam_listener_ownership_probe,
Stub = beam_listener_stub,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_listener_stub).\n-export([prepare/2,start_child/1,controlling_process/2,register_listener/3,check/2]).\nprepare(O,D) -> self() ! {prepare,O,D}, prepared.\nstart_child(Args) -> self() ! {start,Args}, case get(fixture_mode) of reject -> {error,rejected}; _ -> {ok,self()} end.\ncontrolling_process(S,P) -> self() ! {control,S,P}, case get(fixture_mode) of transfer_failure -> denied; _ -> ok end.\nregister_listener(Handle,IP,Port) -> self() ! {register,Handle,IP,Port}, ok.\ncheck(O,S) -> self() ! {check,O,S}, ok.\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    {0,0,0,0} = Module:default_ip([]),
    {0,0,0,0,0,0,0,0} = Module:default_ip([inet6]),
    Pid = self(),
    Info = {Stub,a,b,c,d},
    Config = {config,ssl,opts,Info},
    Expected = {socket,{Pid,4433},fixture_table,Config},
    Start = fun(Mode) -> put(fixture_mode,Mode), Module:start(Config,ip,4433,raw,Pid) end,
    Expect = fun(Event) -> receive Received -> Event = Received after 1000 -> error({missing,Event}) end end,
    ExpectStart = fun() -> Expect({prepare,opts,[]}), Expect({start,[Pid,4433,Info,prepared,ssl,raw]}) end,
    {ok,Expected} = Start(success),
    ExpectStart(), Expect({control,raw,Pid}), Expect({register,{Pid,Pid},ip,4433}), Expect({check,opts,Expected}),
    {error,rejected} = Start(reject),
    ExpectStart(),
    Error = try Start(transfer_failure) catch error:{badmatch,denied}:Stack -> Stack end,
    ExpectStart(), Expect({control,raw,Pid}),
    receive Unexpected -> error({unexpected,Unexpected}) after 0 -> ok end,
    Error
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{Module,start,5,_}|_] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
