@@ -0,0 +1,24 @@
+import hashlib,json,os,pathlib,subprocess
+TOOL=pathlib.Path(__file__).resolve().parent
+ROOT=TOOL.parents[2]
+BASE='0386ff27bc32e036afb44de1bc8bf531f98715cb'
+PREFIXES=['tools/Validation/Erlang.DescriptorPollVmValidation/','tools/Validation/Erlang.DescriptorPollIntegratedValidation/']
+def git(*args):return subprocess.check_output(['git',*args],cwd=ROOT,text=True).strip()
+def verify():
+    plan=json.loads((TOOL/'source-plan.json').read_text())
+    head=git('rev-parse','HEAD');assert head==os.environ['GITHUB_SHA']
+    inputs={r['Path'] for r in plan['Inputs']}
+    expected=inputs|{PREFIXES[0]+'source-plan.json'}
+    changed=set(git('diff','--name-only',BASE,'HEAD').splitlines())
+    assert changed==expected,('Unexpected or missing committed changes',changed^expected)
+    for row in plan['Inputs']:
+        data=(ROOT/row['Path']).read_bytes()
+        assert len(data)==row['Bytes'] and hashlib.sha256(data).hexdigest().upper()==row['Sha256'],row['Path']
+    tracked=set(git('ls-files',*[p.rstrip('/') for p in PREFIXES]).splitlines())
+    assert tracked=={p for p in expected if any(p.startswith(prefix) for prefix in PREFIXES)}
+    assert not git('diff','--name-only','HEAD'),'Tracked source mutation'
+    return {'Head':head,'Baseline':BASE,'ProductionSourceTree':git('rev-parse','HEAD:src'),'Inputs':plan['Inputs'],'IntegratedRuntime':True,'OriginalOtpEqualityClaimed':False}
+if __name__=='__main__':
+    result=verify();out=ROOT/'artifacts/poll558-integrated';out.mkdir(parents=True,exist_ok=True)
+    (out/'admission.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps({'Head':result['Head'],'Inputs':len(result['Inputs']),'Passed':True}))
