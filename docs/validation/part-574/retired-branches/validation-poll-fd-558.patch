@@ -0,0 +1,56 @@
+import importlib.util,json,os,pathlib,signal,subprocess,time
+TOOL=pathlib.Path(__file__).resolve().parent;ROOT=TOOL.parents[2]
+OUT=ROOT/'artifacts/poll558-integrated';OUT.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('admission',TOOL/'verify-ci.py');admission=importlib.util.module_from_spec(spec);spec.loader.exec_module(admission)
+before=admission.verify();rows=[];errors=[]
+EXPECTED={
+ 'vm':['eager-two-vms','dispose-isolation','halt-no-flush','initializer-no-host-dispose','fail-before-start','fail-before-accounting','fail-entered-before-ready'],
+ 'engine':['poll-thread-identity','read-write-ready','cancel-native-snapshot','retire-reuse-fd','same-fd-two-owners','invalid-fd','hangup-eof','stop-active-snapshot','stop-before-start','lost-wake']}
+def run(label,args,seconds=420):
+    start=time.monotonic();timed=False;forced=False
+    with (OUT/(label+'.stdout.log')).open('wb') as stdout,(OUT/(label+'.stderr.log')).open('wb') as stderr:
+        p=subprocess.Popen([str(x) for x in args],cwd=ROOT,stdout=stdout,stderr=stderr,start_new_session=True)
+        try:p.wait(timeout=seconds)
+        except subprocess.TimeoutExpired:
+            timed=True;forced=True;os.killpg(p.pid,signal.SIGTERM)
+            try:p.wait(timeout=5)
+            except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
+        active=False
+        try:os.killpg(p.pid,0);active=True
+        except ProcessLookupError:pass
+        if active:forced=True;os.killpg(p.pid,signal.SIGKILL)
+    row={'Name':label,'Command':[str(x) for x in args],'ExitCode':p.returncode,'TimedOut':timed,'ForcedCleanup':forced,'ProcessGroupAliveAfterNaturalExit':active,'ElapsedSeconds':round(time.monotonic()-start,3)}
+    rows.append(row);(OUT/(label+'.exit.json')).write_text(json.dumps(row,indent=2)+'\n');return row
+def clean(row):return row['ExitCode']==0 and not(row['TimedOut'] or row['ForcedCleanup'] or row['ProcessGroupAliveAfterNaturalExit'])
+try:
+    for profile in ['Debug','Release']:
+        runtime=OUT/'runtime'/profile
+        r=run(profile+'-runtime-build',['dotnet','build','src/Runtime/Erlang.Runtime/Erlang.Runtime.csproj','-c',profile,'--output',runtime,'-m:1','--disable-build-servers','--nologo'])
+        if not clean(r):errors.append(profile+': runtime preparation failed; dependent observers skipped');continue
+        for kind,folder,project in [('vm','Erlang.DescriptorPollVmValidation','Erlang.DescriptorPollVmValidation.csproj'),('engine','Erlang.DescriptorPollIntegratedValidation','Erlang.DescriptorPollIntegratedValidation.csproj')]:
+            label=profile+'-'+kind;binary=OUT/'observers'/label;intermediate=OUT/'obj'/label
+            r=run(label+'-build',['dotnet','build',ROOT/'tools/Validation'/folder/project,'-c',profile,'-p:RuntimeReferenceDirectory='+str(runtime),'-p:BaseIntermediateOutputPath='+str(intermediate)+'/','--output',binary,'-m:1','--disable-build-servers','--nologo'])
+            if not clean(r):errors.append(label+': observer preparation failed; dependent execution skipped');continue
+            report=OUT/(label+'.json')
+            r=run(label+'-run',['dotnet','exec','--fx-version','10.0.11','--roll-forward','Disable',binary/'Erlang.AsyncMicrostateValidation.dll','all',report],300)
+            try:
+                data=json.loads(report.read_text());assert clean(r) and data['Passed'] is True and data['Runtime']=='10.0.11'
+                assert [case['Name'] for case in data['Cases']]==EXPECTED[kind]
+                assert all(case['Passed'] is True for case in data['Cases'])
+                for case in data['Cases']:
+                    result=case['Result']
+                    if kind=='engine':
+                        assert result['PhysicalLifetimeEnded'] is True and result['ActualThreadJoined']==(case['Name']!='stop-before-start')
+                    elif case['Name'].startswith('fail-'):
+                        assert result['ExactSentinelRetained'] is True and result['PhysicalWakeResourcesClosed'] is True
+                        assert result['ProofAtConstructorThrowBeforeHostDispose'] is True and result['HookCalls']==1
+                        assert result['ActualPollThreadJoined']==(case['Name']!='fail-before-start')
+                    else:assert result['AllOwnedPollersJoined'] is True
+            except Exception as error:errors.append(label+': actual outcome rejected: '+repr(error))
+except Exception as error:errors.append('collector: '+repr(error))
+finally:
+    try:after=admission.verify();assert before==after
+    except Exception as error:after={'Failed':repr(error)};errors.append('source stability: '+repr(error))
+    summary={'Passed':not errors,'Head':before['Head'],'Rows':rows,'Errors':errors,'SourceBefore':before,'SourceAfter':after,'ExpectedCasesPerProfile':EXPECTED,'OriginalOtpEqualityClaimed':False,'Scope':'Actual production Linux poll service and VM lifetime controls. Blocking transfer cancellation and active external borrowed-FD reuse are not accepted by this observer.'}
+    (OUT/'summary.json').write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps({'Passed':not errors,'Errors':errors,'Rows':len(rows)}))
+raise SystemExit(0 if not errors else 1)
