+using System.Runtime.InteropServices;
+using System.Text.Json;
+using Erlang.Differential;
+
+if (args.Length != 3 || !OperatingSystem.IsLinux()) return 2;
+string mode = args[0], oracle = args[1], report = args[2];
+bool passed = false;
+Exception? failure = null;
+string? details = null;
+try
+{
+    if (mode == "compare")
+    {
+        details = report + ".details.json";
+        int code = await DescriptorIoContracts.RunReference(oracle, details);
+        passed = code == 0;
+    }
+    else if (mode == "cancel")
+    {
+        await DescriptorIoContracts.RunCancellation();
+        passed = true;
+    }
+    else throw new ArgumentException(nameof(mode));
+}
+catch (Exception error)
+{
+    failure = error;
+}
+string json = JsonSerializer.Serialize(new
+{
+    Passed = passed,
+    Mode = mode,
+    Runtime = Environment.Version.ToString(),
+    Architecture = RuntimeInformation.ProcessArchitecture.ToString(),
+    OriginalComparisonCount = mode == "compare" ? DescriptorIoCases.All.Count : 0,
+    ExistingCancellationCase = mode == "cancel" ? DescriptorIoNames.CancellationTest : null,
+    DetailsPath = details,
+    ErrorType = failure?.GetType().FullName,
+    Error = failure?.ToString(),
+    Scope = "Existing eight fd OTP/SDK comparisons or existing idle borrowed-reader regression; no duplicate fixtures."
+}, new JsonSerializerOptions { WriteIndented = true });
+Console.WriteLine(json);
+await File.WriteAllTextAsync(report, json);
+return passed ? 0 : 1;
