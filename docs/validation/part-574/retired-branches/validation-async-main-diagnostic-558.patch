+# Artifact proposal only. Root may place helpers under .github/recipes/async0386
+# in a diagnostic workflow branch. The tested checkout is separately exact0386.
+name: Focused exact-main async0386 diagnostic
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  actual-async0386:
+    runs-on: windows-latest
+    timeout-minutes: 30
+    steps:
+      - name: Read diagnostic recipe without changing subject tree
+        uses: actions/checkout@v7
+        with:
+          path: recipe
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          sparse-checkout: .github/recipes/async0386
+          persist-credentials: false
+      - name: Checkout exact failed main source
+        uses: actions/checkout@v7
+        with:
+          ref: 0386ff27bc32e036afb44de1bc8bf531f98715cb
+          path: subject
+          fetch-depth: 1
+          sparse-checkout: |
+            src
+            tools
+            tests
+          persist-credentials: false
+      - uses: actions/setup-dotnet@v6
+        with:
+          global-json-file: subject/global.json
+      - name: Require exact admitted CLR profile
+        shell: pwsh
+        run: |
+          $runtimes = dotnet --list-runtimes
+          if ($LASTEXITCODE -ne 0 -or -not ($runtimes -match '^Microsoft.NETCore.App 10\.0\.11 ')) { throw 'Required source-admitted CLR10.0.11 missing' }
+      - name: Run unchanged complete async23 and preserve actual error summary
+        working-directory: subject
+        shell: pwsh
+        run: |
+          & ../recipe/.github/recipes/async0386/run-focused.ps1 -PackageRecipe "$env:GITHUB_WORKSPACE/recipe/.github/recipes/async0386/prepare-package.ps1"
+      - name: Always retain complete actual async and package diagnostics
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: focused-async0386
+          if-no-files-found: error
+          path: |
+            subject/artifacts/async-microstates/**
+            subject/artifacts/async-focused0386/**
+            subject/artifacts/library376-official-compiler/official-admission.json
+            subject/artifacts/library376-official-compiler/execution-files.json
+            subject/artifacts/library376-official-compiler/ci-provider-ready.json
