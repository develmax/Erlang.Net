--- /dev/null
+++ b/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollOwner1554.cs
@@ -0,0 +1,23 @@
+namespace Erlang;
+
+// Borrowed FD identity only. Retirement fences this engine's poll snapshots,
+// not external close/reuse or the caller's later blocking data transfer.
+internal sealed class LinuxDescriptorPollOwner1554
+{
+    internal LinuxDescriptorPollOwner1554(LinuxDescriptorPollService1554 service, ulong generation, int descriptor)
+    {
+        Service = service;
+        Generation = generation;
+        Descriptor = descriptor;
+    }
+
+    internal LinuxDescriptorPollService1554 Service { get; }
+    internal ulong Generation { get; }
+    internal int Descriptor { get; }
+    internal bool Closing;
+    internal int Pending;
+    internal readonly ObjectDisposedException Closed = new(nameof(LinuxDescriptorPollOwner1554));
+    internal readonly TaskCompletionSource Retired = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+    internal Task BeginRetire() => Service.Retire(this);
+}
diff --git a/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollService1554.cs b/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollService1554.cs
new file mode 100644
index 000000000..ef6e08b27
--- /dev/null
+++ b/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollService1554.cs
@@ -0,0 +1,416 @@
+using System.Runtime.InteropServices;
+
+namespace Erlang;
+
+// Artifact candidate: one actual Linux thread per owning logical VM. No data
+// transfers and no ownership of supplied raw FDs. Start is explicit so caller
+// can retain this owner before a partially successful Thread.Start attempt.
+internal sealed class LinuxDescriptorPollService1554 : IAsyncDisposable
+{
+    private readonly object gate = new();
+    private readonly RuntimeMicrostateAccounting accounting;
+    private readonly LinuxDescriptorPollProbe1557? probe;
+    private readonly Thread thread;
+    private readonly Dictionary<ulong, LinuxDescriptorPollWait1554> waits = new();
+    private readonly HashSet<LinuxDescriptorPollOwner1554> owners = new();
+    private readonly TaskCompletionSource ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private int wakeRead, wakeWrite;
+    private ulong nextOwner, nextRequest;
+    private bool startAttempted, stopping, wakeClosed, physicalLifetimeEnded, actualThreadJoined;
+    private Exception? failure;
+    private Task? shutdown;
+    private int actualThreadId;
+
+    internal LinuxDescriptorPollService1554(RuntimeMicrostateAccounting accounting, LinuxDescriptorPollProbe1557? probe = null)
+    {
+        if (!OperatingSystem.IsLinux()) throw new PlatformNotSupportedException();
+        ArgumentNullException.ThrowIfNull(accounting);
+        this.accounting = accounting;
+        this.probe = probe;
+        thread = new Thread(Run)
+        {
+            Name = LinuxDescriptorPollNames1554.ThreadName,
+            IsBackground = true
+        };
+        int[] descriptors = [LinuxDescriptorPollNames1554.InvalidDescriptor, LinuxDescriptorPollNames1554.InvalidDescriptor];
+        if (LinuxPortNative.pipe2(descriptors, LinuxPortParameters.NonBlocking | LinuxPortParameters.CloseOnExec) != 0)
+            throw new NativePortIOException(Marshal.GetLastPInvokeError());
+        wakeRead = descriptors[LinuxDescriptorPollNames1554.PipeReadIndex];
+        wakeWrite = descriptors[LinuxDescriptorPollNames1554.PipeWriteIndex];
+    }
+
+    internal Task Ready => ready.Task;
+
+    internal int ActualThreadId
+    {
+        get { lock (gate) return actualThreadId; }
+    }
+
+    internal bool PhysicalLifetimeEnded
+    {
+        get { lock (gate) return physicalLifetimeEnded; }
+    }
+
+    internal bool ActualThreadJoined
+    {
+        get { lock (gate) return actualThreadJoined; }
+    }
+
+    internal void Start()
+    {
+        lock (gate)
+        {
+            ObjectDisposedException.ThrowIf(stopping || wakeClosed, this);
+            if (startAttempted) throw new InvalidOperationException(LinuxDescriptorPollNames1554.DuplicateStart);
+            startAttempted = true;
+            bool suppress = !ExecutionContext.IsFlowSuppressed();
+            AsyncFlowControl flow = default;
+            try
+            {
+                if (suppress) flow = ExecutionContext.SuppressFlow();
+                thread.Start();
+            }
+            catch (Exception error)
+            {
+                failure ??= error;
+                stopping = true;
+                WakeUnderGate();
+                // Caller still owns this object and must join/close via Dispose.
+                throw;
+            }
+            finally
+            {
+                if (suppress) flow.Undo();
+            }
+        }
+    }
+
+    internal LinuxDescriptorPollOwner1554 RegisterBorrowed(int descriptor)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(descriptor);
+        lock (gate)
+        {
+            RequireReadyUnderGate();
+            ulong generation = checked(nextOwner + 1);
+            var owner = new LinuxDescriptorPollOwner1554(this, generation, descriptor);
+            owners.Add(owner);
+            nextOwner = generation;
+
+            return owner;
+        }
+    }
+
+    internal Task<short> WaitReadyAsync(
+        LinuxDescriptorPollOwner1554 owner,
+        short events,
+        CancellationToken cancellation
+    )
+    {
+        ArgumentNullException.ThrowIfNull(owner);
+        cancellation.ThrowIfCancellationRequested();
+        if (events == 0 || (events & ~LinuxDescriptorPollNames1554.AllowedEvents) != 0)
+            throw new ArgumentOutOfRangeException(nameof(events));
+        var wait = new LinuxDescriptorPollWait1554(owner, events, cancellation);
+        // Registration allocation is before admission. An already-canceled
+        // callback may only mark this not-yet-admitted request, never complete it.
+        wait.CancellationRegistration = cancellation.UnsafeRegister(static state =>
+        {
+            var actual = (LinuxDescriptorPollWait1554)state!;
+            actual.Owner.Service.Cancel(actual);
+        }, wait);
+        try
+        {
+            lock (gate)
+            {
+                RequireReadyUnderGate();
+                RequireOwnerUnderGate(owner);
+                if (owner.Closing) throw owner.Closed;
+                wait.Generation = checked(nextRequest + 1);
+                waits.Add(wait.Generation, wait);
+                nextRequest = wait.Generation;
+                owner.Pending++;
+                wait.Admitted = true;
+                // After admission only the actual poll thread settles the call.
+                WakeUnderGate();
+            }
+        }
+        catch
+        {
+            wait.CancellationRegistration.Dispose();
+            throw;
+        }
+
+        return wait.Completion.Task;
+    }
+
+    internal Task Retire(LinuxDescriptorPollOwner1554 owner)
+    {
+        bool complete;
+        lock (gate)
+        {
+            if (!ReferenceEquals(owner.Service, this))
+                throw new InvalidOperationException(LinuxDescriptorPollNames1554.ForeignOwner);
+            if (owner.Closing) return owner.Retired.Task;
+            RequireOwnerUnderGate(owner);
+            owner.Closing = true;
+            complete = owner.Pending == 0;
+            if (complete) owners.Remove(owner);
+            else WakeUnderGate();
+        }
+        if (complete) owner.Retired.TrySetResult();
+
+        return owner.Retired.Task;
+    }
+
+    private void RequireReadyUnderGate()
+    {
+        if (failure is not null) throw new IOException(LinuxDescriptorPollNames1554.Closed, failure);
+        ObjectDisposedException.ThrowIf(stopping || wakeClosed, this);
+        if (!startAttempted || !ready.Task.IsCompletedSuccessfully)
+            throw new InvalidOperationException(LinuxDescriptorPollNames1554.NotReady);
+    }
+
+    private void RequireOwnerUnderGate(LinuxDescriptorPollOwner1554 owner)
+    {
+        if (!ReferenceEquals(owner.Service, this) || !owners.Contains(owner))
+            throw new InvalidOperationException(LinuxDescriptorPollNames1554.ForeignOwner);
+    }
+
+    private void Cancel(LinuxDescriptorPollWait1554 wait)
+    {
+        lock (gate)
+        {
+            wait.CancellationRequested = true;
+            if (wait.Admitted && waits.TryGetValue(wait.Generation, out var current)
+                && ReferenceEquals(current, wait)) WakeUnderGate();
+        }
+    }
+
+    private unsafe void WakeUnderGate()
+    {
+        if (wakeClosed) return;
+        byte value = LinuxDescriptorPollNames1554.WakeSignalValue;
+        while (true)
+        {
+            nint count = LinuxPortNative.write(wakeWrite, (nint)(&value), LinuxDescriptorPollNames1554.WakeSignalBytes);
+            if (count == LinuxDescriptorPollNames1554.WakeSignalBytes) return;
+            int error = Marshal.GetLastPInvokeError();
+            if (count < 0 && error == LinuxPortParameters.Interrupted) continue;
+            if (count < 0 && error == LinuxPortParameters.WouldBlock) return; // Existing unread wake.
+            failure ??= new NativePortIOException(count == 0 ? LinuxPortParameters.BrokenPipe : error);
+            stopping = true;
+            // A failed wake is not proof that an existing kernel poll returned.
+            // Keep physical join pending if the OS cannot wake this owned pipe.
+            return;
+        }
+    }
+
+    private unsafe void DrainWake()
+    {
+        byte* buffer = stackalloc byte[LinuxDescriptorPollNames1554.WakeBufferBytes];
+        while (true)
+        {
+            nint count = LinuxPortNative.read(wakeRead, (nint)buffer, LinuxDescriptorPollNames1554.WakeBufferBytes);
+            if (count > 0) continue;
+            int error = Marshal.GetLastPInvokeError();
+            if (count < 0 && error == LinuxPortParameters.Interrupted) continue;
+            if (count < 0 && error == LinuxPortParameters.WouldBlock) return;
+            throw new NativePortIOException(count == 0 ? LinuxPortParameters.BrokenPipe : error);
+        }
+    }
+
+    private void Run()
+    {
+        try
+        {
+            RuntimeMicrostateThreadIdentity physical = RuntimeMicrostateThreadIdentity.Current;
+            using var attachment = RuntimeMicrostateExecution.AttachConfiguredWorker(
+                accounting,
+                LinuxDescriptorPollNames1554.PollType,
+                RuntimeMicrostate.CheckIo,
+                physical,
+                LinuxDescriptorPollNames1554.PollIdentity
+            );
+            lock (gate) actualThreadId = physical.OperatingSystemId;
+            ready.TrySetResult();
+            RunPollLoop();
+        }
+        catch (Exception error)
+        {
+            lock (gate)
+            {
+                failure ??= error;
+                stopping = true;
+            }
+            ready.TrySetException(error);
+            _ = ready.Task.Exception;
+        }
+        finally
+        {
+            // No native poll invocation remains on this thread at this point.
+            LinuxDescriptorPollWait1554[] remaining;
+            LinuxDescriptorPollOwner1554[] idle;
+            lock (gate)
+            {
+                stopping = true;
+                remaining = waits.Values.ToArray();
+                waits.Clear();
+                foreach (var wait in remaining) SelectTerminalUnderGate(wait, failure);
+                idle = owners.Where(owner => owner.Pending == 0).ToArray();
+                foreach (var owner in owners) owner.Closing = true;
+                foreach (var owner in idle) owners.Remove(owner);
+            }
+            CompleteOutsideGate(remaining);
+            foreach (var owner in idle) owner.Retired.TrySetResult();
+        }
+    }
+
+    private void RunPollLoop()
+    {
+        while (true)
+        {
+            LinuxDescriptorPollWait1554[] snapshot;
+            DescriptorPollState[] descriptors;
+            bool stop;
+            lock (gate)
+            {
+                stop = stopping;
+                snapshot = waits.Values.ToArray();
+                descriptors = new DescriptorPollState[snapshot.Length + LinuxDescriptorPollNames1554.FirstRequestIndex];
+                descriptors[LinuxDescriptorPollNames1554.WakePollIndex] = new()
+                {
+                    Descriptor = wakeRead,
+                    Events = DescriptorPortParameters.PollInput
+                };
+                for (int index = 0; index < snapshot.Length; index++)
+                    descriptors[index + LinuxDescriptorPollNames1554.FirstRequestIndex] = new()
+                    {
+                        Descriptor = snapshot[index].Owner.Descriptor,
+                        Events = snapshot[index].Events
+                    };
+            }
+            if (stop) return;
+            probe?.BeforeNativePoll(snapshot.Length);
+            int result;
+            int error;
+            using (RuntimeMicrostateExecution.EnterState(accounting, RuntimeMicrostate.Sleep))
+            {
+                result = LinuxDescriptorPollNative1554.poll(
+                    descriptors,
+                    (nuint)descriptors.Length,
+                    LinuxDescriptorPollNames1554.InfiniteTimeout
+                );
+                error = result < 0 ? Marshal.GetLastPInvokeError() : 0;
+            }
+            if (result < 0 && error != LinuxPortParameters.Interrupted)
+                throw new NativePortIOException(error);
+            short wakeEvents = descriptors[LinuxDescriptorPollNames1554.WakePollIndex].Returned;
+            if ((wakeEvents & (LinuxDescriptorPollNames1554.Error | LinuxDescriptorPollNames1554.Hangup
+                | DescriptorPortParameters.PollInvalid)) != 0)
+                throw new NativePortIOException(LinuxPortParameters.BadDescriptor);
+            if ((wakeEvents & DescriptorPortParameters.PollInput) != 0) DrainWake();
+            var completed = new List<LinuxDescriptorPollWait1554>();
+            lock (gate)
+            {
+                for (int index = 0; index < snapshot.Length; index++)
+                {
+                    var wait = snapshot[index];
+                    if (!waits.TryGetValue(wait.Generation, out var current) || !ReferenceEquals(current, wait)) continue;
+                    short returned = descriptors[index + LinuxDescriptorPollNames1554.FirstRequestIndex].Returned;
+                    if (stopping || wait.Owner.Closing || wait.CancellationRequested || wait.Cancellation.IsCancellationRequested)
+                        SelectTerminalUnderGate(wait, failure);
+                    else if (result < 0 || returned == 0) continue;
+                    else if ((returned & DescriptorPortParameters.PollInvalid) != 0)
+                        wait.Error = new NativePortIOException(LinuxPortParameters.BadDescriptor);
+                    else wait.ReadyEvents = returned; // HUP/ERR are advisory readiness; actual transfer decides EOF/EPIPE.
+                    waits.Remove(wait.Generation);
+                    completed.Add(wait);
+                }
+            }
+            // Every completed row's exact native snapshot has physically returned.
+            CompleteOutsideGate(completed);
+        }
+    }
+
+    private static void SelectTerminalUnderGate(LinuxDescriptorPollWait1554 wait, Exception? error)
+    {
+        if (error is not null) wait.Error = error;
+        else if (wait.CancellationRequested || wait.Cancellation.IsCancellationRequested) wait.CancelResult = true;
+        else wait.Error = wait.Owner.Closed;
+    }
+
+    private void CompleteOutsideGate(IEnumerable<LinuxDescriptorPollWait1554> completed)
+    {
+        foreach (var wait in completed)
+        {
+            Exception? unregister = null;
+            try { wait.CancellationRegistration.Dispose(); }
+            catch (Exception error) { unregister = error; }
+            if (unregister is not null)
+            {
+                if (wait.Error is not null) unregister = new AggregateException(wait.Error, unregister);
+                wait.Completion.TrySetException(unregister);
+                lock (gate) failure ??= unregister;
+            }
+            else if (wait.CancelResult) wait.Completion.TrySetCanceled(wait.Cancellation);
+            else if (wait.Error is not null) wait.Completion.TrySetException(wait.Error);
+            else wait.Completion.TrySetResult(wait.ReadyEvents);
+            bool retired;
+            lock (gate)
+            {
+                wait.Admitted = false;
+                wait.Owner.Pending--;
+                retired = wait.Owner.Closing && wait.Owner.Pending == 0;
+                if (retired) owners.Remove(wait.Owner);
+            }
+            if (retired) wait.Owner.Retired.TrySetResult();
+        }
+    }
+
+    public ValueTask DisposeAsync()
+    {
+        if (ReferenceEquals(Thread.CurrentThread, thread))
+            throw new InvalidOperationException(LinuxDescriptorPollNames1554.SelfJoin);
+        lock (gate)
+        {
+            if (shutdown is not null) return new(shutdown);
+            stopping = true;
+            WakeUnderGate();
+            bool suppress = !ExecutionContext.IsFlowSuppressed();
+            AsyncFlowControl flow = default;
+            try
+            {
+                if (suppress) flow = ExecutionContext.SuppressFlow();
+                shutdown = Task.Run(JoinAndClose);
+            }
+            finally
+            {
+                if (suppress) flow.Undo();
+            }
+
+            return new(shutdown);
+        }
+    }
+
+    private void JoinAndClose()
+    {
+        // Join the actual thread, not a completion-shaped substitute task.
+        bool started = (thread.ThreadState & ThreadState.Unstarted) == 0;
+        if (started) thread.Join();
+        var errors = new List<Exception>();
+        lock (gate)
+        {
+            physicalLifetimeEnded = true;
+            actualThreadJoined = started;
+            wakeClosed = true; // Stops all future cancellation callback writes before close/reuse.
+            if (failure is not null) errors.Add(failure);
+            int read = wakeRead, write = wakeWrite;
+            wakeRead = wakeWrite = LinuxDescriptorPollNames1554.InvalidDescriptor;
+            if (LinuxDescriptorPollNative1554.close(read) != 0) errors.Add(new NativePortIOException(Marshal.GetLastPInvokeError()));
+            if (LinuxDescriptorPollNative1554.close(write) != 0) errors.Add(new NativePortIOException(Marshal.GetLastPInvokeError()));
+        }
+        ready.TrySetException(new ObjectDisposedException(LinuxDescriptorPollNames1554.Closed));
+        _ = ready.Task.Exception;
+        if (errors.Count != 0) throw new AggregateException(errors);
+    }
+}
