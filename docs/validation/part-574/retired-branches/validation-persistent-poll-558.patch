+namespace Erlang;
+
+// Borrowed FD identity only. Retirement fences this engine's poll snapshots,
+// not external close/reuse or the caller's later blocking data transfer.
+internal sealed class LinuxDescriptorPollOwner1554
+{
+    internal LinuxDescriptorPollOwner1554(LinuxDescriptorPollService1554 service, ulong generation, int descriptor)
+    {
+        Service = service;
+        Generation = generation;
+        Descriptor = descriptor;
+    }
+
+    internal LinuxDescriptorPollService1554 Service { get; }
+    internal ulong Generation { get; }
+    internal int Descriptor { get; }
+    internal bool Closing;
+    internal int Pending;
+    internal readonly ObjectDisposedException Closed = new(nameof(LinuxDescriptorPollOwner1554));
+    internal readonly TaskCompletionSource Retired = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+    internal Task BeginRetire() => Service.Retire(this);
+}
diff --git a/tools/Validation/Erlang.DescriptorPollValidation/versions/green1558/LinuxDescriptorPollService1554.cs b/tools/Validation/Erlang.DescriptorPollValidation/versions/green1558/LinuxDescriptorPollService1554.cs
