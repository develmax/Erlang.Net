+BASE='36132d511c73d3377210d98e0e01d9e938956964'
+def git(*a): return subprocess.check_output(['git',*a],cwd=ROOT,text=True).strip()
+def verify():
+ plan=json.loads((TOOL/'source-plan.json').read_text())
+ assert git('rev-parse','HEAD')==os.environ['GITHUB_SHA']
+ assert git('rev-parse','HEAD:src')==git('rev-parse',BASE+':src'),'Production source tree changed'
+ changed=git('diff','--name-only',BASE,'HEAD').splitlines()
+ assert changed and all(p.startswith('tools/Validation/Erlang.DescriptorPollValidation/') or p=='.github/workflows/allocation-diagnostic.yml' for p in changed)
+ for row in plan['Inputs']:
+  p=ROOT/row['Path'];data=p.read_bytes();assert len(data)==row['Bytes'] and hashlib.sha256(data).hexdigest().upper()==row['Sha256'],row['Path']
+ tracked=git('ls-files','tools/Validation/Erlang.DescriptorPollValidation').splitlines()
+ assert set(tracked)==set(r['Path'] for r in plan['Inputs'] if r['Path'].startswith('tools/'))|{'tools/Validation/Erlang.DescriptorPollValidation/source-plan.json'}
+ assert not git('diff','--name-only','HEAD'),'Tracked source mutation'
+ return {'Head':git('rev-parse','HEAD'),'ProductionSourceTree':git('rev-parse','HEAD:src'),'Baseline':BASE,'InputCount':len(plan['Inputs']),'InputsStable':True,'IntegratedIntoRuntime':False,'OriginalOtpEqualityClaimed':False}
+if __name__=='__main__':
+ result=verify();out=ROOT/'artifacts/poll558';out.mkdir(parents=True,exist_ok=True);(out/'admission.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
