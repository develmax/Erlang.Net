+
+internal static class LinuxDescriptorPollNative1554
+{
+    [DllImport(LinuxPortParameters.Library, SetLastError = true)]
+    internal static extern int poll([In, Out] DescriptorPollState[] descriptors, nuint count, int timeout);
+
+    [DllImport(LinuxPortParameters.Library, SetLastError = true)]
+    internal static extern int close(int descriptor);
+}
diff --git a/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollOwner1554.cs b/tools/Validation/Erlang.DescriptorPollValidation/versions/old1554/LinuxDescriptorPollOwner1554.cs
