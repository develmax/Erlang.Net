+import json,os,pathlib,signal,subprocess,time,importlib.util
+TOOL=pathlib.Path(__file__).resolve().parent;ROOT=TOOL.parents[2];OUT=ROOT/'artifacts/poll558';OUT.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('admission',TOOL/'verify-ci.py');admission=importlib.util.module_from_spec(spec);spec.loader.exec_module(admission)
+EXPECTED=['poll-thread-identity','read-write-ready','cancel-native-snapshot','retire-reuse-fd','same-fd-two-owners','invalid-fd','hangup-eof','stop-active-snapshot','stop-before-start','lost-wake']
+rows=[];errors=[];before=admission.verify()
+def run(label,args,seconds=420):
+ start=time.monotonic();timed=False;forced=False
+ with (OUT/(label+'.stdout.log')).open('wb') as stdout,(OUT/(label+'.stderr.log')).open('wb') as stderr:
+  p=subprocess.Popen([str(x) for x in args],cwd=ROOT,stdout=stdout,stderr=stderr,start_new_session=True)
+  try:p.wait(timeout=seconds)
+  except subprocess.TimeoutExpired:
+   timed=True;forced=True;os.killpg(p.pid,signal.SIGTERM)
+   try:p.wait(timeout=5)
+   except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
+  active=False
+  try:os.killpg(p.pid,0);active=True
+  except ProcessLookupError:pass
+  if active:
+   forced=True;os.killpg(p.pid,signal.SIGKILL)
+ result={'Name':label,'Command':[str(x) for x in args],'ExitCode':p.returncode,'TimedOut':timed,'ForcedCleanup':forced,'ProcessGroupAliveAfterNaturalExit':active,'ElapsedSeconds':round(time.monotonic()-start,3)}
+ rows.append(result);(OUT/(label+'.exit.json')).write_text(json.dumps(result,indent=2)+'\n');return result
+def clean(r,code=0):return r['ExitCode']==code and not(r['TimedOut'] or r['ForcedCleanup'] or r['ProcessGroupAliveAfterNaturalExit'])
+try:
+ for profile in ['Debug','Release']:
+  runtime=OUT/'runtime'/profile
+  r=run(profile+'-runtime-build',['dotnet','build','src/Runtime/Erlang.Runtime/Erlang.Runtime.csproj','-c',profile,'--output',runtime,'-m:1','--disable-build-servers','--nologo'])
+  if not clean(r):errors.append(profile+': runtime preparation failed; dependent helper builds/executions skipped');continue
+  for version in ['green1558','old1554']:
+   label=profile+'-'+version;binary=OUT/'observers'/label;intermediate=OUT/'obj'/label
+   r=run(label+'-build',['dotnet','build',TOOL/'Erlang.DescriptorPollValidation.csproj','-c',profile,'-p:EngineVersion='+version,'-p:RuntimeReferenceDirectory='+str(runtime),'-p:BaseIntermediateOutputPath='+str(intermediate)+'/', '--output',binary,'-m:1','--disable-build-servers','--nologo'])
+   if not clean(r):errors.append(label+': helper preparation failed; dependent execution skipped');continue
+   report=OUT/(label+'.json');mode='all' if version=='green1558' else 'lost-wake'
+   r=run(label+'-run',['dotnet','exec','--fx-version','10.0.11','--roll-forward','Disable',binary/'Erlang.AsyncMicrostateValidation.dll',mode,report],240)
+   try:
+    data=json.loads(report.read_text());assert data['Runtime']=='10.0.11' and data['Architecture']=='X64'
+    if version=='green1558':
+     assert clean(r) and data['Passed'] is True and [c['Name'] for c in data['Cases']]==EXPECTED
+     assert all(c['Passed'] is True and c['Result']['PhysicalLifetimeEnded'] is True and c['Result']['ActualThreadJoined']==(c['Name']!='stop-before-start') for c in data['Cases'])
+    else:
+     assert clean(r,1) and data['Passed'] is False and len(data['Cases'])==1
+     case=data['Cases'][0];assert case['Name']=='lost-wake' and case['Passed'] is False and case['ErrorType']=='System.TimeoutException'
+     assert all(case.get(k) is True for k in ['LostWakePendingBeforeCleanup','CleanupSucceeded','PhysicalLifetimeEnded','ActualThreadJoined'])
+   except Exception as error: errors.append(label+': actual outcome rejected: '+repr(error))
+except Exception as error:errors.append('collector: '+repr(error))
+finally:
+ try:after=admission.verify();assert before==after
+ except Exception as error:after={'Failed':repr(error)};errors.append('source stability: '+repr(error))
+ summary={'Passed':not errors,'Head':before['Head'],'Rows':rows,'Errors':errors,'SourceBefore':before,'SourceAfter':after,'ExpectedGreenCasesPerProfile':10,'ExpectedPreFixRejectedCasesPerProfile':1,'IntegratedIntoProcessRuntime':False,'OriginalOtpEqualityClaimed':False,'Scope':'Actual Linux x64 component engine only. No VM/public-port integration, external active borrowed-FD reuse or blocking transfer cancellation acceptance.'}
+ (OUT/'summary.json').write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps({'Passed':summary['Passed'],'Errors':errors,'Rows':len(rows)}))
+raise SystemExit(0 if not errors else 1)
