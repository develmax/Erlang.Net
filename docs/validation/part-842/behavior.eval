Dir = "artifacts/beam-backend/part842-images",
Module = beam_maybe_listener_probe,
Stub = beam_maybe_transport,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_maybe_transport).\n-export([open/2,merge/3,setopts/2]).\nopen(Family,Kind) -> self() ! {open,Family,Kind}, get(open_result).\nmerge(Options,Added,Tail) -> self() ! {merge,Options,Added,Tail}, Options ++ Added ++ Tail.\nsetopts(Socket,Options) -> self() ! {setopts,Socket,Options}, get(set_result).\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Expect = fun(Event) -> receive Next -> Event = Next after 1000 -> error({missing,Event}) end end,
    Invoke = fun(Open, Set, Options) ->
        put(open_result, Open), put(set_result, Set),
        try Module:listen_open({address,inet}, Options) catch error:Reason:Stack -> {Reason,Stack} end
    end,
    ExpectOpen = fun() -> Expect({open,inet,stream}) end,
    ExpectSet = fun(Opts) -> ExpectOpen(), Expect({merge,Opts,[{nodelay,true}],[]}),
        Expect({setopts,listener,Opts ++ [{nodelay,true}]}) end,
    {ok,{listener,128}} = Invoke({ok,listener},ok,[]),
    ExpectSet([]),
    {ok,{listener,256}} = Invoke({ok,listener},ok,[{backlog,256}]),
    ExpectSet([{backlog,256}]),
    {error,open_failed} = Invoke({error,open_failed},ok,[]),
    ExpectOpen(),
    {error,set_failed} = Invoke({ok,listener},{error,set_failed},[]),
    ExpectSet([]),
    BadOpen = Invoke(invalid_open,ok,[]), ExpectOpen(),
    {{else_clause,invalid_open},_} = BadOpen,
    BadSet = Invoke({ok,listener},invalid_set,[]), ExpectSet([]),
    {{else_clause,invalid_set},_} = BadSet,
    receive Unexpected -> error({unexpected,Unexpected}) after 0 -> ok end,
    {BadOpen,BadSet}
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
