      "SourceContent": "namespace Erlang;\n\ninternal static class GarbageCollectionResultNames\n{\n    internal const string Function = \"gather_gc_info_result\";\n    internal const int Arity = 1;\n    internal const string Schedulers = \"schedulers\";\n    internal const int ReplyArity = 2;\n    internal const int ReferenceIndex = 0;\n    internal const int StatisticsIndex = 1;\n    internal const int StatisticsArity = 3;\n    internal const int CollectionsIndex = 1;\n    internal const int ReclaimedIndex = 2;\n    internal const int InitialCollections = 0;\n    internal const int InitialReclaimed = 0;\n    internal const int ReservedResult = 0;\n}\n"
