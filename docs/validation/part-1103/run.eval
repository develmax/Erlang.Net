[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [{N,A,[I || I<-Is, not (is_tuple(I) andalso element(1,I)=:=line)]}
     || {function,N,A,_,Is}<-lists:sublist(Fs,2)]
end,
Expected=Read(P),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_call_case_comparison_probe,Path,B),
    true=M:same(1,1),
    false=M:same(1,1.0),
    true=M:different(1,1.0),
    false=M:different(1,1),
    true=M:fresh(1),
    {error,probe_failure}=try M:same(fail,1) of V->{value,V} catch error:R->{error,R} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
io:format("~p~n",[Expected]),
halt().
