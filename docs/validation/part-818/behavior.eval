Dir = "artifacts/beam-backend/part818-images",
Module = dtls_listener_sup,
Live = spawn(fun() -> receive stop -> ok end end),
{Dead,Ref} = spawn_monitor(fun() -> ok end),
receive {'DOWN',Ref,process,Dead,normal} -> ok end,
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok,Bytes} = file:read_file(File),
    {module,Module} = code:load_binary(Module,File,Bytes),
    NoTable = Module:lookup_listener(ip,0),
    {ok,_} = Module:init([]),
    Missing = Module:lookup_listener(ip,1),
    true = Module:register_listener({Live,Live},ip,2),
    Occupied = Module:lookup_listener(ip,2),
    true = Module:register_listener({undefined,Live},ip,3),
    {ok,Live} = Module:lookup_listener(ip,3),
    true = Module:register_listener({Dead,Live},ip,4),
    {ok,Live} = Module:lookup_listener(ip,4),
    true = Module:register_listener({Live,Dead},ip,5),
    Removed = {Module:lookup_listener(ip,5),ets:lookup(Module,{ip,5})},
    true = Module:register_listener(malformed,ip,6),
    Malformed = try Module:lookup_listener(ip,6) catch Class:Reason -> {Class,Reason} end,
    true = Module:register_listener({undefined,not_a_pid},ip,7),
    Invalid = try Module:lookup_listener(ip,7) catch Class2:Reason2 -> {Class2,Reason2} end,
    true = ets:delete(Module),
    [NoTable,Missing,Occupied,live_without_owner,live_with_dead_owner,Removed,Malformed,Invalid]
end,
Otp = Run(ReleasePath),
Otp = Run(filename:join(Dir,"dtls_listener_sup.beam")),
Live ! stop,
io:format("~p~n",[Otp]),
halt().
