Check=fun(M)-> A=filename:join("artifacts/beam-backend/part744-verified-images",atom_to_list(M)++".beam"),O=code:which(M),{ok,Beam}=file:read_file(A),{ok,Original}=file:read_file(O),true=(Beam=:=Original),{beam_file,_,_,_,_,AC}=beam_disasm:file(A),{beam_file,_,_,_,_,OC}=beam_disasm:file(O),true=(AC=:=OC), Cs=[[],[{version3,v3}],[{version3,old}]], Vs=[1,2,3,4,dynamic], Cases=[{N,[C,V,X]}||N<-[encode_message,encode_transaction,encode_action_requests,encode_action_request,encode_action_reply,decode_message,decode_mini_message],C<-Cs,V<-Vs,X<-[[],<<>>,bad]]++[{N,[C,X]}||N<-[version_of,encode_message,decode_message],C<-Cs,X<-[[],<<>>,bad]], Apply=fun(N,Args)->try {ok,apply(M,N,Args)} catch K:R->{K,R} end end, Expected=[Apply(N,Args)||{N,Args}<-Cases],{module,M}=code:load_binary(M,A,Beam),Expected=[Apply(N,Args)||{N,Args}<-Cases],io:format("module=~p~nbytes_equal=true~nsize=~p~nsha256=~s~nfunction_instructions_equal=true~ninput_cases=~p~n",[M,byte_size(Beam),binary:encode_hex(crypto:hash(sha256,Beam)),length(Cases)]) end, [Check(M)||M<-[megaco_ber_encoder,megaco_per_encoder]],halt().
