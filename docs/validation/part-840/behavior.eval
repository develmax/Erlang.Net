Dir = "artifacts/beam-backend/part840-images",
Module = beam_active_socket_probe,
Stub = beam_active_transport,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_active_transport).\n-export([get_all_opts/1]).\nget_all_opts(bad) -> malformed; get_all_opts(Value) -> {ok,{socket_options,Value},[]} .\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Socket = fun(Value) -> {socket,{Value,4433},{config,[]}} end,
    Call = fun(N, Active) -> Module:check([{active,N}], Socket(Active)) end,
    ok = Module:check([], Socket(bad)),
    ok = Call(once, bad),
    ok = Call(1, once),
    ok = Call(32767, 0),
    ok = Call(0, 32767),
    Passive1 = {ssl_passive,Socket(once)},
    Passive1 = Call(0, once),
    receive Passive1 -> ok after 1000 -> error(missing_atom_message) end,
    Passive2 = {ssl_passive,Socket(3)},
    Passive2 = Call(-3, 3),
    receive Passive2 -> ok after 1000 -> error(missing_integer_message) end,
    Passive3 = {ssl_passive,Socket(0)},
    Passive3 = Call(-32768, 0),
    receive Passive3 -> ok after 1000 -> error(missing_minimum_message) end,
    einval = (catch Call(-32769, bad)),
    einval = (catch Call(32768, bad)),
    einval = (catch Call(1, 32767)),
    receive Unexpected -> error({unexpected,Unexpected}) after 0 -> ok end,
    try Call(0, bad) catch error:{badmatch,malformed}:Stack -> Stack end
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{Module,check,2,_}|_] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
