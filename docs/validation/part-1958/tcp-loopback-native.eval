[Name,Image,Output]=init:get_plain_arguments(),
M=list_to_existing_atom(Name),
_=code:unstick_mod(M), {ok,Bin}=file:read_file(Image),
{module,M}=code:load_binary(M,Image,Bin),
{Family,Address}=case M of inet_tcp->{inet,{127,0,0,1}}; inet6_tcp->{inet6,{0,0,0,0,0,0,0,1}} end,
{ok,L}=gen_tcp:listen(0,[Family,binary,{active,false},{ip,Address}]),
{ok,{Address,Port}}=inet:sockname(L),
{ok,C}=M:connect(Address,Port,[binary,{active,false}],1500),
{ok,A}=M:accept(L,1000),
ok=gen_tcp:send(C,<<"round trip">>),
{ok,<<"round trip">>}=gen_tcp:recv(A,0,1000),
ok=gen_tcp:close(A), ok=gen_tcp:close(C), ok=gen_tcp:close(L),
Reject=try M:connect(Address,Port,[],invalid_timeout) of Value->{value,Value} catch Class:Reason->{Class,Reason} end,
ok=file:write_file(Output,io_lib:format("~p.~n",[{loopback_round_trip,Reject}])),halt().