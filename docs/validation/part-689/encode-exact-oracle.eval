Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",
Actual="artifacts/beam-backend/part689-eldap/ELDAPv3.release-profile.beam",
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),[I]=[Ops||{function,encode,2,_,Ops}<-Fs],I end,
R=Read(Release),A=Read(Actual),
Delta=[{K,U,V}||{{U,V},K}<-lists:zip(lists:zip(R,A,trim),lists:seq(1,min(length(R),length(A)))),U=/=V],
io:format("OTP=~p managed=~p exact_disassembly_equal=~p first_deltas=~p~n",[length(R),length(A),R=:=A,lists:sublist(Delta,6)]),case R=:=A of true->halt();false->halt(1) end.