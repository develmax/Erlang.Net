Dir = "artifacts/beam-backend/part834-images",
Module = beam_socket_address_probe,
Stub = beam_address_transport,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_address_transport).\n-export([peername/1,sockname/1,port/1]).\npeername(S) -> {peer,S}.\nsockname(S) -> {name,S}.\nport(S) -> {port,S}.\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Pid = self(),
    {error,enotconn} = Module:peername(Stub,undefined),
    {ok,address} = Module:peername(gen_udp,{Pid,{address,raw}}),
    {ok,address} = Module:peername(gen_udp,{address,raw}),
    {peer,raw} = Module:peername(Stub,raw),
    {name,raw} = Module:sockname(gen_udp,{Pid,{address,raw}}),
    {name,{address,raw}} = Module:sockname(gen_udp,{not_pid,{address,raw}}),
    {name,raw} = Module:sockname(gen_udp,{address,raw}),
    {name,raw} = Module:sockname(gen_udp,raw),
    {name,raw} = Module:sockname(Stub,raw),
    {port,raw} = Module:port(gen_udp,{address,raw}),
    {port,raw} = Module:port(Stub,raw),
    try Module:peername(nonexistent_address_transport,raw) catch error:undef:Stack -> Stack end
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{nonexistent_address_transport,peername,_,_}|_] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
