Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",
Actual="artifacts/beam-backend/part675-eldap/ELDAPv3.release-profile.beam",
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),[I]=[Ops||{function,encode,2,_,Ops}<-Fs],I end,
Success=fun(I)->A=lists:dropwhile(fun(O)->O=/={call,2,{'ELDAPv3',encode_disp,2}} end,I),
    {Head,[Tuple|_]}=lists:splitwith(fun(O)->element(1,O)=/=put_tuple2 end,A),
    [case O of {try_end,{y,_}}->{try_end,{y,token}};_->O end||O<-Head++[Tuple]] end,
R=Read(Release),A=Read(Actual),Equal=Success(R)=:=Success(A),
io:format("release_instructions=~p managed_instructions=~p protected_success_equal_except_token=~p~n",[length(R),length(A),Equal]),
case Equal of true->halt();false->halt(1) end.