[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, saved_case_probe} = code:load_binary(saved_case_probe, Path, Binary),
undefined = put(old,initial),
{initial,first} = saved_case_probe:terminal(old,expected,first),
initial = get(follow),
{first,second} = saved_case_probe:sequenced(old,expected,second),
second = get(mark),
{old,expected,{second,third}} = saved_case_probe:nested(old,expected,third),
{old,third,fourth} = saved_case_probe:alias_live(old,expected,fourth),
{'EXIT',{{case_clause,{old,wrong}},_}} = (catch saved_case_probe:terminal(old,wrong,unused)),
fourth = get(old),
{same,kept} = saved_case_probe:repeated(same,same,kept),
same = get(repeated),
{'EXIT',{{case_clause,{right,left}},_}} = (catch saved_case_probe:repeated(left,right,kept)),
{other,match} = saved_case_probe:existing(match,other,match),
{'EXIT',{{case_clause,{wrong,other}},_}} = (catch saved_case_probe:existing(wrong,other,match)),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [Item]) || Item = {function, Name, _, _, _} <- Functions, Name =/= module_info],
halt().

