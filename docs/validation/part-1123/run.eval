[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [F||F={function,run,1,_,_}<-Fs]
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_nested_inline_list_probe,Path,B),
    {ok,[head|tail]}=M:run([head|tail]),
    {7,[head|tail]}=M:forward([head|tail],[7]),
    {head,[head|tail]}=M:same([head|tail]),
    {error,{badmatch,[]}}=try M:run([]) of V->{value,V} catch error:R->{error,R} end,
    {error,badarg}=try M:forward([head],[]) of V2->{value,V2} catch error:R2->{error,R2} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
