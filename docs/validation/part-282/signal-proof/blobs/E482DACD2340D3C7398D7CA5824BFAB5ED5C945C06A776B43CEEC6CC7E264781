      "SourceContent": "from pathlib import Path\r\nimport json,hashlib,shutil,subprocess,sys\r\nbase=Path(sys.argv[1]).resolve();area=Path(sys.argv[2]).resolve();assert not area.exists();area.mkdir(parents=True)\r\ncases=['wrong-argument-count','wrong-pin','wrong-tag','not-built','wrong-root','wrong-log-hash','wrong-version','wrong-source-hash','duplicate-artifact','wrong-scenario','wrong-plan-pin','existing-output','wrong-fresh-vm-metadata','wrong-oracle-metadata'];rows=[]\r\nclosure=[{'Path':x.relative_to(base).as_posix(),'Sha256':hashlib.sha256(x.read_bytes()).hexdigest().upper()} for x in sorted(base.rglob('*')) if x.is_file()]\r\nfor name in cases:\r\n case=area/name;case.mkdir();binary=case/'tool';shutil.copytree(base,binary);otp=case/'fake-otp';versions=otp/'releases/29';versions.mkdir(parents=True);(versions/'OTP_VERSION').write_bytes(b'29.1.1')\r\n log=case/'fake-build.log';log.write_bytes(b'SYNTHETIC REFUSAL ONLY; NOT ORIGINAL OTP EXECUTION.\\n')\r\n evidence={'SourceCommit':'ad05823719d77c8faee87348ea39513d4e2f99c5','SourceTag':'OTP-29.1.1','SourceBuildCompleted':True,'InstalledOtpRoot':str(otp),'SourceBuildLog':str(log),'SourceBuildLogSha256':hashlib.sha256(log.read_bytes()).hexdigest().upper()}\r\n plan=json.loads((binary/'source-plan.json').read_text())\r\n if name=='wrong-pin':evidence['SourceCommit']='wrong'\r\n if name=='wrong-tag':evidence['SourceTag']='OTP-29.1.0'\r\n if name=='not-built':evidence['SourceBuildCompleted']=False\r\n if name=='wrong-root':evidence['InstalledOtpRoot']=str(case/'other-root')\r\n if name=='wrong-log-hash':evidence['SourceBuildLogSha256']='0'*64\r\n if name=='wrong-version':(versions/'OTP_VERSION').write_bytes(b'29.1.0')\r\n if name=='wrong-source-hash':x=binary/'distribution_signal_observer.erl';x.write_bytes(x.read_bytes()+b'\\n')\r\n if name=='duplicate-artifact':plan['RequiredArtifacts'][-1]=plan['RequiredArtifacts'][0]\r\n if name=='wrong-scenario':plan['Scenarios']=['other']\r\n if name=='wrong-plan-pin':plan['Pin