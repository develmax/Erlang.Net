A="artifacts/beam-backend/part746-images/cdv_gen_cb.beam", O=code:which(cdv_gen_cb), {ok,Beam}=file:read_file(A),{ok,Original}=file:read_file(O),true=(Beam=:=Original),{beam_file,_,_,_,_,AC}=beam_disasm:file(A),{beam_file,_,_,_,_,OC}=beam_disasm:file(O),true=(AC=:=OC), Parse=fun(S)->{ok,Ts,_}=erl_scan:string(S),{ok,F}=erl_parse:parse_form(Ts),F end, Forms=[Parse(S)||S<-["-module(crashdump_viewer).","-export([general_info/0,to_proplist/2]).","general_info() -> get(test_response).","to_proplist(Fields, Info) -> {Fields, Info}."]], {ok,crashdump_viewer,Stub}=compile:forms(Forms), {module,crashdump_viewer}=code:load_binary(crashdump_viewer,"oracle_stub",Stub), Inputs=[{ok,sample,warning},{error,bad},unexpected], Call=fun(I)->put(test_response,I),try {ok,cdv_gen_cb:get_info()} catch error:E->{error,E} end end, Reference=[Call(I)||I<-Inputs], {module,cdv_gen_cb}=code:load_binary(cdv_gen_cb,A,Beam),Reference=[Call(I)||I<-Inputs], [{ok,{_,{[created|_],sample},warning}},{error,{badmatch,{error,bad}}},{error,{badmatch,unexpected}}]=Reference, io:format("bytes_equal=true~nsize=~p~nsha256=~s~nfunction_instructions_equal=true~nstub_success_and_badmatch=true~n",[byte_size(Beam),binary:encode_hex(crypto:hash(sha256,Beam))]),halt().
