M=beam_catch_stack_slots, Exit=list_to_atom("EXIT"), Clean=fun C({X,{Reason,[{Mod,F,Arity,_}|_]}}) when X=:=Exit->{caught_error,Reason,{Mod,F,Arity}}; C(T) when is_tuple(T)->list_to_tuple([C(E)||E<-tuple_to_list(T)]); C(T) when is_list(T)->[C(E)||E<-T]; C(Other)->Other end, Run=fun(F,Args,Start,Work,Last)->erase(),put(start,Start),put(work,Work),put(done,old_done),put(last,Last), Result=try apply(M,F,Args) catch error:Reason->{outer_error,Reason} end, Clean({Result,[get(K)||K<-[start,work,done,last]]}) end, Pair=[input,{keep,1}], Triple=[input,{keep,2},{other,3}], Results=[Run(run,Pair,{ok,old_start},{ok,worked},old_last),Run(run,Pair,start_val,{throw,thrown},old_last),Run(run,Pair,start_val,{exit,exited},old_last),Run(run,Pair,start_val,bad_work,old_last),Run(twice,Triple,{ok,one},bad_work,old_last),Run(after_catch,Pair,{throw,inside},work_val,{ok,after_value}),Run(after_catch,Pair,{ok,inside},work_val,bad_after)],io:format("~0p~n",[Results]),halt().