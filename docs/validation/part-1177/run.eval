[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, tuple_register_entry_probe} = code:load_binary(tuple_register_entry_probe, Path, Binary),
{undefined,value,extra} = tuple_register_entry_probe:read({tag,42,unused,value},extra),
Check = fun(Args) ->
    try apply(tuple_register_entry_probe, read, Args) of
        _ -> error(expected_function_clause)
    catch error:function_clause:Stack ->
        [{tuple_register_entry_probe,read,Args,_}|_] = Stack
    end
end,
Check([{tag,41,unused,value},extra]),
Check([{wrong,42,unused,value},extra]),
Check([{tag,42,unused},extra]),
Check([other,extra]),
value = get(tuple_register_key),
{beam_file,_,_,_,_,Functions} = beam_disasm:file(Path),
[io:format("~p~n",[F]) || F = {function,read,2,_,_} <- Functions],
halt().
