[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, bif_tuple_probe} = code:load_binary(bif_tuple_probe, Path, Binary),
undefined = put(probe, value),
Self = self(),
Node = node(),
{value, first} = bif_tuple_probe:first(probe),
{tag, value, middle} = bif_tuple_probe:middle(probe, tag),
{probe, Self, value} = bif_tuple_probe:keep(probe, ignored),
{value, Self, value} = bif_tuple_probe:repeated(probe),
{Self, Node, undefined} = bif_tuple_probe:empty(),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [F]) || F = {function, Name, _, _, _} <- Functions,
    lists:member(Name, [first, middle, keep, repeated, empty])],
halt().
