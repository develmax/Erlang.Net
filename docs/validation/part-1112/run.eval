[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    lists:sublist(Fs,2)
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_nested_entry_survivor_probe,Path,B),
    {third,{first,second}}=M:one(first,second,third),
    {second,{third,{first,second}}}=M:two(first,second,third),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
