[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,[{function,run,2,_,Is}|_]}=beam_disasm:file(Path),
    lists:sublist(Is,13)
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_guarded_bif_tail_probe,Path,B),
    {-2,3}=M:run(-1.5,3.75),
    {unchanged,5}=M:run(unchanged,5),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
