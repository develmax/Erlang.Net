[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[{N,Is} || {function,N,2,_,Is}<-Fs,N=:=single_tail orelse N=:=tagged_single_tail]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    {[1|2],saved}=M:single_tail({1,2},saved),
    {{1,saved},saved}=M:tagged_single_tail({item,1,7},saved),
    function_clause=(try M:tagged_single_tail({item,1,8},saved) catch error:R -> R end),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
