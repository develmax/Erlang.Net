Dir = "artifacts/beam-backend/part841-images",
Module = dtls_socket,
Stubs = [
    {dtls_listener_sup, "-module(dtls_listener_sup).\n-export([lookup_listener/2,register_listener/3]).\nlookup_listener(IP,Port) -> self() ! {lookup,IP,Port}, get(fixture_lookup).\nregister_listener(Owner,IP,Port) -> self() ! {register,Owner,IP,Port}, ok.\n"},
    {dtls_packet_demux, "-module(dtls_packet_demux).\n-export([new_owner/2,set_all_opts/2]).\nnew_owner(L,O) -> self() ! {owner,L,O}, ok.\nset_all_opts(L,O) -> self() ! {opts,L,O}, ok.\n"},
    {beam_listener_transport, "-module(beam_listener_transport).\n-export([open/2]).\nopen(Port,Opts) -> self() ! {open,Port,Opts}, {error,eaddrinuse}.\n"}],
lists:foreach(fun({Stub, Source}) ->
    Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
    ok = file:write_file(Path, Source),
    {ok, Stub, Bytes} = compile:file(Path, [binary]),
    {module, Stub} = code:load_binary(Stub, Path, Bytes)
end, Stubs),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Pid = self(),
    Ip = {127,0,0,1},
    Port = 4433,
    Config = {config,ssl,[{reuseaddr,true}],[],undefined,[{ip,Ip}],{beam_listener_transport,a,b,c,d},cb,tab},
    Expect = fun(Event) -> receive Next -> Event = Next after 1000 -> error({missing,Event}) end end,
    put(fixture_lookup,{ok,listener}),
    {ok,{sslsocket,{listener,Port},undefined,undefined,undefined,undefined,dtls_listen,Config}} = Module:listen(Port,Config),
    Expect({lookup,Ip,Port}), Expect({owner,listener,Pid}),
    Expect({opts,listener,{[{reuseaddr,true}],{socket_options,list,0,0,0,true},ssl}}),
    Expect({register,{Pid,listener},Ip,Port}),
    put(fixture_lookup,undefined),
    {error,already_listening} = Module:listen(Port,Config),
    Expect({lookup,Ip,Port}), Expect({open,Port,[{reuseaddr,true},{active,false},{mode,binary}]}),
    put(fixture_lookup,{error,fixture}),
    {error,fixture} = Module:listen(Port,Config),
    Expect({lookup,Ip,Port}),
    receive Unexpected -> error({unexpected,Unexpected}) after 0 -> ok end,
    try Module:listen(Port,invalid) catch error:function_clause:Stack -> Stack end
end,
Otp = Run(code:which(Module)),
[{Module,listen,_,_}|_] = Otp,
Otp = Run(filename:join(Dir,"dtls_socket.beam")),
erlang:display({Module, listen_cases_equal}),
halt().
