            "        const Eterm *log = erts_maps_get(am_error_logger, arg);",
            "        const Eterm *incl_bins = erts_maps_get(am_include_shared_binaries, arg);",
            "        if (size && is_small(*size)) {",
            "            sz = signed_val(*size);",
            "        } else {",
            "            /* size is mandatory */",
            "            return 0;",
            "        }",
            "        if (kill) {",
            "            if (*kill == am_true)",
            "                *max_heap_flags |= MAX_HEAP_SIZE_KILL;",
