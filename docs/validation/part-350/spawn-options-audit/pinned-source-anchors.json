            "{",
            "    Sint sz;",
            "    *max_heap_flags = H_MAX_FLAGS;",
            "    if (is_small(arg)) {",
            "        sz = signed_val(arg);",
            "        *max_heap_flags = H_MAX_FLAGS;",
            "    } else if (is_map(arg)) {",
            "        const Eterm *size = erts_maps_get(am_size, arg);",
