          "Lines": [
            "erts_parse_spawn_opts(ErlSpawnOpts *sop, Eterm opts_list, Eterm *tag,",
            "                      int message_opt)",
            "{",
            "    /*",
            "     * Returns:",
            "     * - 0 on success",
            "     * - <0 on badopt",
            "     * - >0 on badarg (not proper list)",
            "     */",
            "    int result = 0;",
            "    Eterm ap = opts_list;",
            "    ",
            "    ERTS_SET_DEFAULT_SPAWN_OPTS(sop);",
            "    if (tag)",
            "        *tag = sop->tag;",
            "    ",
            "    /*",
            "     * Store default values for options.",
            "     */",
            "    sop->multi_set      = 0;",
            "    sop->min_heap_size  = H_MIN_SIZE;",
            "    sop->min_vheap_size = BIN_VH_MIN_SIZE;",
            "    sop->max_heap_size  = H_MAX_SIZE;",
            "    sop->max_heap_flags = H_MAX_FLAGS;",
            "    sop->priority       = PRIORITY_NORMAL;",
            "    sop->max_gen_gcs    = (Uint16) erts_atomic32_read_nob(&erts_max_gen_gcs);",
            "    sop->scheduler      = 0;",
            "",
            "    /*",
            "     * Walk through the option list.",
            "     */",
            "    while (is_list(ap)) {",
            "\tEterm arg = CAR(list_val(ap));",
            "\tap = CDR(list_val(ap));",
            "\tif (arg == am_link) {",
            "            if (sop->flags & SPO_LINK)",
            "                sop->multi_set = !0;",
            "\t    sop->flags |= SPO_LINK;",
            "\t} else if (arg == am_monitor) {",
            "            if (sop->flags & SPO_MONITOR)",
            "                sop->multi_set = !0;",
            "\t    sop->flags |= SPO_MONITOR;",
            "            sop->monitor_tag = THE_NON_VALUE;",
            "            sop->monitor_oflags = 0;",
            "\t} else if (is_tuple(arg)) {",
            "\t    Eterm* tp2 = tuple_val(arg);",
            "\t    Eterm val;",
            "\t    if (*tp2 != make_arityval(2)) {",
            "                result = -1;",
            "                continue;",
            "            }",
            "\t    arg = tp2[1];",
            "\t    val = tp2[2];",
            "\t    if (arg == am_priority) {",
            "                if (sop->flags & SPO_PRIORITY)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_PRIORITY;",
            "\t\tif (val == am_max)",
            "\t\t    sop->priority = PRIORITY_MAX;",
            "\t\telse if (val == am_high)",
            "\t\t    sop->priority = PRIORITY_HIGH;",
            "\t\telse if (val == am_normal)",
            "\t\t    sop->priority = PRIORITY_NORMAL;",
            "\t\telse if (val == am_low)",
            "\t\t    sop->priority = PRIORITY_LOW;",
            "\t\telse",
            "                    result = -1;",
            "            } else if (arg == am_async_dist) {",
            "                if (val == am_true) {",
            "                    if (sop->flags & SPO_ASYNC_DIST)",
            "                        sop->multi_set = !0;",
            "                    else",
            "                        sop->flags |= SPO_ASYNC_DIST;",
            "                }",
            "                else if (val == am_false) {",
            "                    if (!(sop->flags & SPO_ASYNC_DIST))",
            "                        sop->multi_set = !0;",
            "                    else",
            "                        sop->flags &= ~SPO_ASYNC_DIST;",
            "                }",
            "                else {",
            "                    result = -1;",
            "                }",
            "\t    } else if (arg == am_message_queue_data) {",
            "                if (sop->flags & (SPO_OFF_HEAP_MSGQ|SPO_ON_HEAP_MSGQ))",
            "                    sop->multi_set = !0;",
            "\t\tswitch (val) {",
            "\t\tcase am_on_heap:",
            "\t\t    sop->flags &= ~SPO_OFF_HEAP_MSGQ;",
            "\t\t    sop->flags |= SPO_ON_HEAP_MSGQ;",
            "\t\t    break;",
            "\t\tcase am_off_heap:",
            "\t\t    sop->flags &= ~SPO_ON_HEAP_MSGQ;",
            "\t\t    sop->flags |= SPO_OFF_HEAP_MSGQ;",
            "\t\t    break;",
            "\t\tdefault:",
            "                    result = -1;",
            "                    break;",
            "\t\t}",
            "\t    } else if (arg == am_min_heap_size && is_small(val)) {",
            "\t\tSint min_heap_size = signed_val(val);",
            "                if (sop->flags & SPO_MIN_HEAP_SIZE)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_MIN_HEAP_SIZE;",
            "\t\tif (min_heap_size < 0) {",
            "                    result = -1;",
            "\t\t} else if (min_heap_size < H_MIN_SIZE) {",
            "\t\t    sop->min_heap_size = H_MIN_SIZE;",
            "\t\t} else {",
            "\t\t    sop->min_heap_size = erts_next_heap_size(min_heap_size, 0);",
            "\t\t}",
            "            } else if (arg == am_max_heap_size) {",
            "                if (sop->flags & SPO_MAX_HEAP_SIZE)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_MAX_HEAP_SIZE;",
            "                if (!erts_max_heap_size(val, &sop->max_heap_size, &sop->max_heap_flags))",
            "                    result = -1;",
            "\t    } else if (arg == am_min_bin_vheap_size && is_small(val)) {",
            "\t\tSint min_vheap_size = signed_val(val);",
            "                if (sop->flags & SPO_MIN_VHEAP_SIZE)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_MIN_VHEAP_SIZE;",
            "\t\tif (min_vheap_size < 0) {",
            "\t\t    result = -1;",
            "\t\t} else if (min_vheap_size < BIN_VH_MIN_SIZE) {",
            "\t\t    sop->min_vheap_size = BIN_VH_MIN_SIZE;",
            "\t\t} else {",
            "\t\t    sop->min_vheap_size = erts_next_heap_size(min_vheap_size, 0);",
            "\t\t}",
            "\t    } else if (arg == am_fullsweep_after && is_small(val)) {",
            "\t\tSint max_gen_gcs = signed_val(val);",
            "                if (sop->flags & SPO_MAX_GEN_GCS)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_MAX_GEN_GCS;",
            "\t\tif (max_gen_gcs < 0) {",
            "\t\t    result = -1;",
            "\t\t} else {",
            "\t\t    sop->max_gen_gcs = max_gen_gcs;",
            "\t\t}",
            "\t    } else if (arg == am_scheduler && is_small(val)) {",
            "\t\tSint scheduler = signed_val(val);",
            "                if (sop->flags & SPO_SCHEDULER)",
            "                    sop->multi_set = !0;",
            "                sop->flags |= SPO_SCHEDULER;",
            "\t\tif (scheduler < 0 || erts_no_schedulers < scheduler)",
            "                    result = -1;",
            "                else",
            "                    sop->scheduler = (int) scheduler;",
            "            } else if (arg == am_reply) {",
            "                if (!message_opt)",
            "                    result = -1;",
            "                else if (val == am_error_only) {",
            "                    sop->flags |= SPO_NO_SMSG;",
            "                    sop->flags &= ~SPO_NO_EMSG;",
            "                }",
            "                else if (val == am_success_only) {",
            "                    sop->flags &= ~SPO_NO_SMSG;",
            "                    sop->flags |= SPO_NO_EMSG;",
            "                }",
            "                else if (val == am_no) {",
            "                    sop->flags |= SPO_NO_SMSG;",
            "                    sop->flags |= SPO_NO_EMSG;",
            "                }",
            "                else if (val == am_yes) {",
            "                    sop->flags &= ~SPO_NO_SMSG;",
            "                    sop->flags &= ~SPO_NO_EMSG;",
            "                }",
            "                else",
            "                    result = -1;",
            "            } else if (arg == am_reply_tag) {",
            "                if (!tag)",
            "                    result = -1;",
            "                else",
            "                    *tag = val;",
            "            } else if (arg == am_link) {",
            "                Uint32 oflags = erts_link_opts(val, NULL);",
            "                if (oflags == (Uint32) ~0)",
            "                    result = -1;",
            "                else {",
            "                    sop->link_oflags = oflags;",
            "                    if (sop->flags & SPO_LINK)",
            "                        sop->multi_set = !0;",
            "                    sop->flags |= SPO_LINK;",
            "                }",
            "            } else if (arg == am_monitor) {",
            "                Eterm monitor_tag;",
            "                Uint32 oflags = erts_monitor_opts(val, &monitor_tag);",
            "                if (oflags == (Uint32) ~0)",
            "                    result = -1;",
            "                else {",
            "                    sop->monitor_oflags = oflags;",
            "                    if (sop->flags & SPO_MONITOR)",
            "                        sop->multi_set = !0;",
            "                    sop->flags |= SPO_MONITOR;",
            "                    sop->monitor_tag = monitor_tag;",
            "                }",
            "\t    } else {",
            "                result = -1;",
            "\t    }",
            "\t} else {",
            "            result = -1;",
            "\t}",
            "    }",
            "    if (is_not_nil(ap)) {",
            "\treturn 1;",
            "    }",
            ""
          ]
        }
      ]
    },
