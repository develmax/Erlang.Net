A="artifacts/beam-backend/part732-images/xmerl_text.beam", O=code:which(xmerl_text), {ok,Actual}=file:read_file(A), {ok,Original}=file:read_file(O), {ok,_,AC}=beam_lib:all_chunks(A), {ok,_,OC}=beam_lib:all_chunks(O), io:format("bytes_equal=~p~nsize=~p~nsha256=~s~nsections_equal=~p~n",[Actual=:=Original,byte_size(Actual),binary:encode_hex(crypto:hash(sha256,Actual)),AC=:=OC]), {module,xmerl_text}=code:load_binary(xmerl_text,A,Actual), Root=list_to_atom("#root#"), Data=[<<"a">>,<<"b">>], Data=apply(xmerl_text,Root,[Data,ignored,[],ignored]), Reject=fun(Input)->try apply(xmerl_text,Root,[Data,ignored,Input,ignored]),false catch error:function_clause->true end end, true=lists:all(Reject,[[parent],wrong]), io:format("root_pattern_contract=true~n"), halt().
