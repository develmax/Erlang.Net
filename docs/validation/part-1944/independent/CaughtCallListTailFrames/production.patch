diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CaughtListTailFrames.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CaughtListTailFrames.cs
