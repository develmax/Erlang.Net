A="artifacts/beam-backend/part733-images/mnesia_ext_sup.beam", O=code:which(mnesia_ext_sup), {ok,Actual}=file:read_file(A), {ok,Original}=file:read_file(O), {ok,_,AC}=beam_lib:all_chunks(A), {ok,_,OC}=beam_lib:all_chunks(O), io:format("bytes_equal=~p~nsize=~p~nsha256=~s~nsections_equal=~p~n",[Actual=:=Original,byte_size(Actual),binary:encode_hex(crypto:hash(sha256,Actual)),AC=:=OC]), {module,mnesia_ext_sup}=code:load_binary(mnesia_ext_sup,A,Actual), {ok,Sup}=mnesia_ext_sup:start(), {ok,P}=mnesia_ext_sup:start_proc(sample,gen_event,start_link,[],[{shutdown,2500}]), true=is_pid(P), {ok,#{restart:=transient,shutdown:=2500,type:=worker,modules:=[gen_event]}}=supervisor:get_childspec(Sup,sample), ok=mnesia_ext_sup:stop_proc(sample), {ok,R}=mnesia_ext_sup:start_proc(sample,gen_event,start_link,[]), true=is_pid(R) andalso R=/=P, ok=gen_server:stop(Sup), io:format("supervisor_options_and_restart=true~n"), halt().
