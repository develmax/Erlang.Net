Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",Actual="artifacts/beam-backend/part700-eldap/ELDAPv3.release-profile.beam",
Norm=fun(I)->{label,Base}=hd(I),Recur=fun F({label,L})->{label,L-Base};F({f,L}) when L>0->{f,L-Base};F(T) when is_tuple(T)->list_to_tuple([F(X)||X<-tuple_to_list(T)]);F(L) when is_list(L)->[F(X)||X<-L];F(X)->X end,[Recur(X)||X<-I,element(1,X)=/=line] end,
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),maps:from_list([{{N,A},I}||{function,N,A,_,I}<-Fs]) end,
R=Read(Release),A=Read(Actual),
Rows=[{length(M)-length(I),K,length(I),length(M)}||{K,I}<-maps:to_list(R),{ok,M}<-[maps:find(K,A)],Norm(I)=/=Norm(M)],
io:format("different_normalized_functions=~p~nlargest_instruction_surpluses=~p~n",[length(Rows),lists:sublist(lists:reverse(lists:sort(Rows)),8)]),halt().
