A="artifacts/beam-backend/part700-eldap/ELDAPv3.release-profile.beam",O="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",{ok,_,AC}=beam_lib:all_chunks(A),{ok,_,OC}=beam_lib:all_chunks(O),Decode=fun R(_,0,_,Acc)->lists:reverse(Acc);
           R(<<B,Rest/binary>>,N,F,Acc)->
              {V,Tail}=case B band 24 of
                   8 -> <<L,T/binary>>=Rest,{((B band 224) bsl 3) bor L,T};
                   24 -> Size=(B bsr 5)+2,<<Bytes:Size/binary,T/binary>>=Rest,{binary:decode_unsigned(Bytes),T};
                   _ -> {B bsr 4,Rest}
              end,
              case B band 7 of
                   1 -> R(Tail,N-1,F,[{F,V}|Acc]);
                   2 -> R(Tail,N,V,Acc)
              end
       end,
Locations=fun(Cs)->{"Line", <<_:96,N:32,_:32,B/binary>>}=lists:keyfind("Line",1,Cs),Decode(B,N,0,[]) end,
OList=Locations(OC),AList=Locations(AC),
D=[{I,X,Y} || {I,{X,Y}}<-lists:zip(lists:seq(1,length(OList)),lists:zip(OList,AList)),X=/=Y],
io:format("different_positions=~p~nfirst_differences=~p~nmissing_managed=~p~nextra_managed=~p~n",[length(D),lists:sublist(D,5),OList--AList,AList--OList]),halt().
