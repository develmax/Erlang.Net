diff --git a/tests/Erlang.Tests/Compiler/Beam/BeamReflexiveExactTestsChecks.cs b/tests/Erlang.Tests/Compiler/Beam/BeamReflexiveExactTestsChecks.cs
new file mode 100644
--- /dev/null
+++ b/tests/Erlang.Tests/Compiler/Beam/BeamReflexiveExactTestsChecks.cs
@@ -0,0 +1,70 @@
+using System.Collections;
+using System.Numerics;
+using Erlang.Compiler;
+using static Erlang.Compiler.BeamEmissionFormat;
+using static Erlang.Tests.BeamBinaryHostAccess;
+
+namespace Erlang.Tests;
+
+internal static class BeamReflexiveExactTestsChecks
+{
+    internal const string TestName = "compiler/beam/removes-exact-guards-reading-one-register-twice";
+    private const string Fixture = "beam_reflexive_exact_probe.erl";
+    private const string ReflexiveGuardRemains = "A tuple pattern retained an exact comparison of one register with itself.";
+    private const string DifferentOperandGuardMissing = "A tuple pattern lost the exact comparison between different registers.";
+
+    private const string Source = """
+        -module(beam_reflexive_exact_probe).
+        -export([choice/1, same/2]).
+        choice({item, Direct, Indirect, Descriptor, Encoding} = Original) ->
+            Tag =
+                case {Direct, Indirect} of
+                    {Direct, missing} -> {direct, Direct};
+                    {missing, Indirect} -> {indirect, Indirect};
+                    _ -> {both, Indirect, Direct}
+                end,
+            case Encoding of
+                {octets, Bytes} when is_list(Bytes); is_binary(Bytes) ->
+                    {item, Tag, Descriptor, Bytes};
+                _ -> Original
+            end.
+
+        same(First, Second) ->
+            case {First, Second} of
+                {First, First} -> equal;
+                _ -> different
+            end.
+        """;
+
+    internal static Task Run()
+    {
+        object code = Code(CodeGeneration.CompileBeamModule(Source, Fixture));
+        object[] comparisons = Items(code, "Instructions").Where(instruction =>
+            (byte)Property(Property(instruction, "Definition"), "Opcode") == ExactEqualTest).ToArray();
+        bool hasDifferentRegisters = false;
+        foreach (object comparison in comparisons)
+        {
+            object[] operands = Items(comparison, "Operands").ToArray();
+            if (operands is [_, var left, var right]
+                && (string)Property(left, "Kind") == "x" && (string)Property(right, "Kind") == "x")
+            {
+                if ((BigInteger)Property(left, "Value") == (BigInteger)Property(right, "Value"))
+                {
+                    throw new InvalidOperationException(ReflexiveGuardRemains);
+                }
+
+                hasDifferentRegisters = true;
+            }
+        }
+
+        if (!hasDifferentRegisters)
+        {
+            throw new InvalidOperationException(DifferentOperandGuardMissing);
+        }
+
+        return Task.CompletedTask;
+    }
+
+    private static IEnumerable<object> Items(object owner, string name) =>
+        ((IEnumerable)Property(owner, name)).Cast<object>();
+}
diff --git a/tests/Erlang.Tests/Compiler/Beam/BeamProvedExactCopiesChecks.cs b/tests/Erlang.Tests/Compiler/Beam/BeamProvedExactCopiesChecks.cs
new file mode 100644
--- /dev/null
+++ b/tests/Erlang.Tests/Compiler/Beam/BeamProvedExactCopiesChecks.cs
@@ -0,0 +1,83 @@
+using System.Collections;
+using System.Numerics;
+using Erlang.Compiler;
+using static Erlang.Compiler.BeamEmissionFormat;
+using static Erlang.Tests.BeamBinaryHostAccess;
+
+namespace Erlang.Tests;
+
+internal static class BeamProvedExactCopiesChecks
+{
+    internal const string TestName = "compiler/beam/elides-copies-after-a-proven-exact-match";
+    private const string Fixture = "beam_proved_exact_copy_probe.erl";
+    private const string RepeatedCopyRemains = "An exact guard leaves an unnecessary copy of the matched value.";
+    private const string UnprovedCopyMissing = "A copy needed on the successful guard edge was removed.";
+
+    private const string Source = """
+        -module(beam_proved_exact_copy_probe).
+        -export([fixed/2, changed/2, absolute/1, different/3]).
+        fixed(Fun, State) ->
+            case Fun(State) of
+                State -> State;
+                Updated -> fixed(Fun, Updated)
+            end.
+
+        changed(Fun, State) ->
+            case Fun(State) of
+                State -> {unchanged, State};
+                Updated -> {changed, Updated}
+            end.
+
+        absolute(Value) ->
+            case erlang:abs(Value) of
+                Value -> Value;
+                Other -> {changed, Other}
+            end.
+
+        different(Fun, State, Result) ->
+            case Fun(State) of
+                State -> Result;
+                Updated -> {next, Updated}
+            end.
+        """;
+
+    internal static Task Run()
+    {
+        object code = Code(CodeGeneration.CompileBeamModule(Source, Fixture));
+        object[] instructions = Items(code, "Instructions").ToArray();
+        bool keepsOtherCopy = false;
+        for (int index = 0; index + 1 < instructions.Length; index++)
+        {
+            object instruction = instructions[index];
+            object next = instructions[index + 1];
+            if (Opcode(instruction) == ExactEqualTest && Opcode(next) == Move
+                && Items(instruction, "Operands").ToArray() is [_, var left, var right]
+                && Items(next, "Operands").ToArray() is [var source, var destination]
+                && SameOperand(left, destination))
+            {
+                if (SameOperand(right, source))
+                {
+                    throw new InvalidOperationException(RepeatedCopyRemains);
+                }
+
+                keepsOtherCopy = true;
+            }
+        }
+
+        if (!keepsOtherCopy)
+        {
+            throw new InvalidOperationException(UnprovedCopyMissing);
+        }
+
+        return Task.CompletedTask;
+    }
+
+    private static bool SameOperand(object left, object right) =>
+        (string)Property(left, "Kind") == (string)Property(right, "Kind")
+        && (BigInteger)Property(left, "Value") == (BigInteger)Property(right, "Value");
+
+    private static byte Opcode(object instruction) => (byte)Property(Property(instruction, "Definition"), "Opcode");
+
+    private static IEnumerable<object> Items(object owner, string name) =>
+        ((IEnumerable)Property(owner, name)).Cast<object>();
+}
