diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ExactRegisterProofs.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ExactRegisterProofs.cs
