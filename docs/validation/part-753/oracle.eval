Path = "tests/Erlang.Tests/Resources/Beam/named_fun_source_probe.erl",
{ok,named_fun_source_probe,Beam} = compile:file(Path,[binary,deterministic]),
{module,named_fun_source_probe} = code:load_binary(named_fun_source_probe,Path,Beam),
{Outer,Loop} = named_fun_source_probe:make(7),
Self = named_fun_source_probe:self_fun(),
Nested = named_fun_source_probe:nested(),
Inner = Nested(),
{env,LoopEnvironment} = erlang:fun_info(Loop,env),
{env,SelfEnvironment} = erlang:fun_info(Self,env),
Result = {Outer,Loop(2000,0),length(LoopEnvironment),length(SelfEnvironment),
    Self =:= Self(),Nested =:= Inner(),named_fun_source_probe:shadow()},
{outer,2001007,1,0,true,true,{matched,other}} = Result,
io:format("~p~n",[Result]),
halt().
