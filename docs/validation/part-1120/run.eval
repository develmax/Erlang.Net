[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [F||F={function,choose,2,_,_}<-Fs]
end,
io:format("OTP: ~p~nC#: ~p~n",[Read(P),Read(Q)]),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_guarded_bif_tail_probe,Path,B),
    4=M:choose(8,2),
    1=M:choose(8,3),
    14=M:preserve(10,8,2),
    -8=M:preserve(10,8,3),
    {error,badarith}=try M:choose(8,0) of V->{value,V} catch error:R->{error,R} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
