      "SourceContent": "name: Pinned OTP distribution trace observations\r\non:\r\n  workflow_dispatch:\r\npermissions:\r\n  contents: read\r\njobs:\r\n  observations:\r\n    runs-on: ubuntu-latest\r\n    timeout-minutes: 45\r\n    steps:\r\n      - uses: actions/checkout@v7\r\n        with:\r\n          persist-credentials: false\r\n      - uses: actions/setup-dotnet@v6\r\n        with:\r\n          global-json-file: global.json\r\n      - name: Build standalone trace observation tool\r\n        id: trace-tool\r\n        shell: bash\r\n        env:\r\n          DOTNET_PROCESSOR_COUNT: 2\r\n        run: |\r\n          set -euo pipefail\r\n          mkdir -p artifacts\r\n          dotnet build tools/Erlang.DistributionTraceObservations -m:1 --disable-build-servers -p:UseSharedCompilation=false 2>&1 | tee artifacts/trace-observation-tool-build.log\r\n      - name: Build and attest the pinned development compiler\r\n        id: pinned-build\r\n        if: ${{ !cancelled() && steps.trace-tool.outcome == 'success' }}\r\n        shell: bash\r\n        run: |\r\n          set -euo pipefail\r\n          {\r\n            echo \"PINNED_BEAM_SOURCE_BEGIN $GITHUB_SHA\"\r\n            git clone --depth 1 --branch OTP-29.1.1 https://github.com/erlang/otp.git artifacts/beam-otp-source\r\n            source_commit=\"$(git -C artifacts/beam-otp-source rev-parse HEAD)\"\r\n            test \"$source_commit\" = ad05823719d77c8faee87348ea39513d4e2f99c5\r\n            echo \"PINNED_BEAM_SOURCE_VERIFIED $source_commit\"\r\n            cd artifacts/beam-otp-source\r\n            echo 'PINNED_BEAM_CONFIGURE --without-javac --without-wx --without-odbc --without-debugger --without-observer --without-et'\r\n            ./configure --prefix=\"$GITHUB_WORKSPACE/artifacts/beam-otp-oracle\" --without-javac --without-wx --without-odbc --without-debugger --without-observer --without-et\r\n            echo 'PINNED_BEAM_MAKE -j2'\r\n            make -j2\r\n            echo 'PINNED_BEAM_INSTALL'\r\n            make install\r\n            test \"$(cat \"$GITHUB_WORKSPACE/artifacts/beam-otp-oracle/lib/erlang/releases/29/OTP_VERSION\")\" = 29.1.1\r\n            echo 'PINNED_BEAM_INSTALL_VERIFIED 29.1.1'\r\n          } 2>&1 | tee artifacts/beam-otp-build.log\r\n          python3 - <<'PY'\r\n          import hashlib, json, os, pathlib\r\n          root = pathlib.Path(os.environ['GITHUB_WORKSPACE'])\r\n          log = root / 'artifacts/beam-otp-build.log'\r\n          evidence = {\r\n              'SourceCommit': 'ad05823719d77c8faee87348ea39513d4e2f99c5',\r\n              'SourceTag': 'OTP-29.1.1',\r\n              'SourceBuildCompleted': True,\r\n              'InstalledOtpRoot': str(root / 'artifacts/beam-otp-oracle/lib/erlang'),\r\n              'SourceBuildLog': str(log),\r\n              'SourceBuildLogSha256': hashlib.sha256(log.read_bytes()).hexdigest().upper(),\r\n              'HarnessCommit': os.environ['GITHUB_SHA'],\r\n              'RunId': os.environ['GITHUB_RUN_ID'],\r\n              'RunAttempt': os.environ['GITHUB_RUN_ATTEMPT'],\r\n              'Job': os.environ['GITHUB_JOB'],\r\n              'RunnerOs': os.environ['RUNNER_OS'],\r\n              'ConfigureOptions': ['--without-javac','--without-wx','--without-odbc','--without-debugger','--without-observer','--without-et'],\r\n              'BuildArguments': ['make','-j2'],\r\n              'InstallArguments': ['make','install']\r\n          }\r\n          (root / 'artifacts/beam-source-build-evidence.json').write_text(json.dumps(evidence, indent=2) + '\\n')\r\n          PY\r\n      - name: Capture eight original trace scenarios in independent fresh VMs\r\n        if: ${{ !cancelled() && steps.trace-tool.outcome == 'success' && steps.pinned-build.outcome == 'success' }}\r\n        shell: bash\r\n        run: |\r\n          set -euo pipefail\r\n          dotnet run --project tools/Erlang.DistributionTraceObservations --no-build -- artifacts/beam-otp-oracle/lib/erlang artifacts/distribution-trace-observations artifacts/beam-source-build-evidence.json\r\n      - uses: actions/upload-artifact@v7\r\n        if: always()\r\n        with:\r\n          name: pinned-distribution-trace-observations\r\n          path: |\r\n            artifacts/distribution-trace-observations\r\n            artifacts/beam-otp-build.log\r\n            artifacts/beam-source-build-evidence.json\r\n            artifacts/trace-observation-tool-build.log\r\n"
