      "SourceContent": "{\r\n  \"Stage\": \"SOURCE_ONLY_NATIVE_OBSERVER_NOT_EXECUTED\",\r\n  \"OtpTag\": \"OTP-29.1.1\",\r\n  \"OtpCommit\": \"ad05823719d77c8faee87348ea39513d4e2f99c5\",\r\n  \"Probe\": \"distribution_trace_probe.erl\",\r\n  \"ProbeSha256\": \"30FD1EA415E99155641E747F51E3381C0573C9DCFD0DDEFD880612ABCC36429D\",\r\n  \"Entrypoint\": \"distribution_trace_probe:run(Case,Output)\",\r\n  \"FreshVmRequiredPerCase\": true,\r\n  \"Cases\": [\r\n    \"send\",\r\n    \"registered\",\r\n    \"nil\",\r\n    \"undefined\",\r\n    \"wide_flags\",\r\n    \"exit_link\",\r\n    \"exit2_trap\",\r\n    \"exit2_normal\"\r\n  ],\r\n  \"RequiredOutputs\": [\r\n    \"stage.etf\",\r\n    \"outer.etf\",\r\n    \"setup.etf\",\r\n    \"receiver-ready.etf\",\r\n    \"links-before.etf\",\r\n    \"token-before.etf\",\r\n    \"input.etf\",\r\n    \"input.packet\",\r\n    \"input-result.etf\",\r\n    \"queued.etf\",\r\n    \"ignored-exit-state.etf\",\r\n    \"completion-input.etf\",\r\n    \"selected.etf\",\r\n    \"tracer-mailbox.etf\",\r\n    \"receiver-identities.etf\",\r\n    \"receiver-cleanup.etf\",\r\n    \"controller-cleanup.etf\",\r\n    \"tracer-setting.etf\",\r\n    \"tracer-cleanup.etf\"\r\n  ],\r\n  \"SemanticAssertions\": false,\r\n  \"NoGuessedExpectedResults\": true,\r\n  \"Scope\": [\r\n    \"canonical LP64 flags/sender tuple\",\r\n    \"nil and undefined raw marker\",\r\n    \"suspended actual mailbox snapshot before selection\",\r\n    \"linked trapped exit\",\r\n    \"explicit trapped exit\",\r\n    \"untrapped ignored normal arbitrary token never selected\"\r\n  ],\r\n  \"Unproven\": [\r\n    \"fresh source has not been compiled or executed\",\r\n    \"native readiness/timeout/cleanup and tracer ordering not yet measured\",\r\n    \"noncanonical token selection intentionally excluded unsafe native assertion domain\",\r\n    \"outbound language SEND TT propagation excluded\",\r\n    \"physical ABI of target must be captured independently\"\r\n  ],\r\n  \"Revision\": \"Explicit monitored owned tracer cleanup; old observer1 source preserved.\"\r\n}\r\n"
