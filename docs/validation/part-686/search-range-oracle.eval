Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",
Actual="artifacts/beam-backend/part686-eldap/ELDAPv3.release-profile.beam",
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),[I]=[Ops||{function,dec_SearchRequest,2,_,Ops}<-Fs],I end,
Ranges=fun(I)->A=lists:dropwhile(fun(O)->O=/=return end,I),lists:sublist([O||O<-tl(A),element(1,O)=/=label],6) end,
R=Read(Release),A=Read(Actual),Equal=Ranges(R)=:=Ranges(A),
io:format("release_instructions=~p managed_instructions=~p out_of_line_range_blocks_equal=~p~n~p~n",[length(R),length(A),Equal,Ranges(A)]),
case Equal of true->halt();false->halt(1) end.