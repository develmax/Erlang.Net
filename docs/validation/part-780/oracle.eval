lists:foreach(fun(Module) ->
    Original = code:which(Module),
    Generated = filename:join("artifacts/beam-backend/part780-images", atom_to_list(Module) ++ ".beam"),
    {ok,Bytes} = file:read_file(Original),
    {ok,Bytes} = file:read_file(Generated),
    {beam_file,Module,_,_,_,Functions} = beam_disasm:file(Generated),
    Counts = [{Name,Arity,length(Instructions)} ||
        {function,Name,Arity,_,Instructions} <- Functions],
    io:format("~p whole_image_equal=true bytes=~p functions=~w sha256=~s~n",
        [Module,byte_size(Bytes),Counts,binary:encode_hex(crypto:hash(sha256,Bytes))])
end, [cdv_timer_cb,cdv_fun_cb]),
halt().
