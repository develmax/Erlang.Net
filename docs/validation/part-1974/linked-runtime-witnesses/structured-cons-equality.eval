[Image]=init:get_plain_arguments(),
M=beam_structured_cons_equality_comprehension,
{ok,Bin}=file:read_file(Image),
{module,M}=code:load_binary(M,Image,Bin),
{[last],[]}=M:probe([same,last],[same]),
Single=[{single,first},{single,second}],
SingleExpected=Single++[last],
{SingleExpected,Single}=M:probe([same,last],[same,first,second]),
Other=[{other,1.0},{other,second}],
OtherExpected=Other++[1,last],
{OtherExpected,Other}=M:probe([1,last],[1.0,second]),
put(seen,[]),
[{same,value}]=M:bare(same,same,[value]),
[{other,value}]=M:mixed(same,[different],[value]),
io:format("~p.~n",[{passed,[equal_heads,ordered_effects,numeric_nonidentical_heads,bare_equality,mixed_equality]}]),
halt(0).
