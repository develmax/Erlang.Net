[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Kinds = fun(Patterns,Body) ->
    case lists:reverse(Body) of
        [{'case',_,Value,_}|Prefix] ->
            Selector = case {Value,Prefix} of
                {{call,_,_,Args},_} -> Args;
                {{var,_,Name},[{match,_,{var,_,Name},{call,_,_,Args}}|_]} -> Args;
                _ -> []
            end,
            Inputs = [Name || {var,_,Name} <- Selector],
            RecordFields = [Name || {record,_,_,Fields} <- Patterns,
                {record_field,_,_,{var,_,Name}} <- Fields, Name =/= '_'],
            TupleFields = [Name || {tuple,_,Fields} <- Patterns,
                {var,_,Name} <- Fields, Name =/= '_'],
            Used = fun(Fields) -> lists:any(fun(F) -> lists:member(F,Inputs) end,Fields) end,
            [Kind || {Kind,true} <- [
                {entry_record_field_in_case_call,Used(RecordFields)},
                {entry_tuple_field_in_case_call,Used(TupleFields)},
                {single_entry_record_field_in_case_call,length(RecordFields) =:= 1 andalso Used(RecordFields)},
                {single_entry_tuple_field_in_case_call,length(TupleFields) =:= 1 andalso Used(TupleFields)}
            ]];
        _ -> []
    end
end,
Files = lists:sort(filelib:fold_files(Generated,"[.]beam$",true,fun(Path,Acc) -> [Path|Acc] end,[])),
Totals = lists:foldl(fun(Path,Acc) ->
    Relative = lists:nthtail(length(filename:split(Generated)),filename:split(Path)),
    case beam_lib:chunks(filename:join([Reference|Relative]),[abstract_code]) of
        {ok,{Module,[{abstract_code,{raw_abstract_v1,Forms}}]}} ->
            Groups = lists:foldl(fun({Name,Arity,Clauses},G0) ->
                Shapes = lists:usort(lists:append([Kinds(Patterns,Body) || {clause,_,Patterns,_,Body} <- Clauses])),
                lists:foldl(fun(Shape,G) -> maps:update_with(Shape,fun(Mfas) ->
                    [{Name,Arity}|Mfas] end,[{Name,Arity}],G) end,G0,Shapes)
            end,#{},[{Name,Arity,Clauses} || {function,_,Name,Arity,Clauses} <- Forms]),
            maps:fold(fun(Shape,Mfas,All) ->
                Count = length(Mfas),
                Example = {Module,lists:min(Mfas)},
                maps:update_with(Shape,fun({Modules,Functions,Examples}) ->
                    {Modules+1,Functions+Count,lists:sublist([Example|Examples],3)}
                end,{1,Count,[Example]},All)
            end,Acc,Groups);
        _ -> Acc
    end
end,#{},Files),
io:format("Entry fields used by case selector calls of ~p differing images.~n",[length(Files)]),
io:format("Counts are {modules, functions, examples}. Groups can overlap.~n~p~n",[Totals]),
halt().




