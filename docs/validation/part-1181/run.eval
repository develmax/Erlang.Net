[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, tuple_guard_entry_probe} = code:load_binary(tuple_guard_entry_probe, Path, Binary),
{undefined,value,extra} = tuple_guard_entry_probe:read({tag,atom,value},extra),
Inputs = [{tag,42,value},{wrong,atom,value},{tag,atom},other],
[{fallback,Input,extra} = tuple_guard_entry_probe:read(Input,extra) || Input <- Inputs],
value = get(tuple_guard_key),
{beam_file,_,_,_,_,Functions} = beam_disasm:file(Path),
[io:format("~p~n",[F]) || F = {function,read,2,_,_} <- Functions],
halt().
