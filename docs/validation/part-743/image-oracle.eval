A="artifacts/beam-backend/part743-final-images/megaco_config_misc.beam", O=code:which(megaco_config_misc), {ok,Beam}=file:read_file(A),{ok,Original}=file:read_file(O),true=(Beam=:=Original), {beam_file,_,_,_,_,AC}=beam_disasm:file(A),{beam_file,_,_,_,_,OC}=beam_disasm:file(O),true=(AC=:=OC), Functions=[{N,Ar}||{function,N,Ar,_,_}<-OC,N=/=module_info], Values=[infinity,-2,0,3,99999999999999999999999999,0.5,true,false,bad,[]], Args=fun Recur(0)->[[]]; Recur(N)->[[V|T]||V<-Values,T<-Recur(N-1)] end, Cases=[{N,As}||{N,Ar}<-Functions,As<-Args(Ar)], Results=[apply(megaco_config_misc,N,As)||{N,As}<-Cases], {module,megaco_config_misc}=code:load_binary(megaco_config_misc,A,Beam), Results=[apply(megaco_config_misc,N,As)||{N,As}<-Cases], io:format("bytes_equal=true~nsize=~p~nsha256=~s~nfunction_instructions_equal=true~nfunctions=~p~ninput_cases=~p~n",[byte_size(Beam),binary:encode_hex(crypto:hash(sha256,Beam)),length(Functions),length(Cases)]),halt().
