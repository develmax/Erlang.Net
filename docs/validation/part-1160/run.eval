[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[Is || {function,cons_tuple_fallback,2,_,Is}<-Fs]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    {[{1,{item,1,7}}|tail],saved}=M:cons_tuple_fallback([{item,1,7}|tail],saved),
    [{item,1,8}|tail]=M:cons_tuple_fallback([{item,1,8}|tail],saved),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
