[Paths,Witness,Out]=init:get_plain_arguments(),
{ok,Raw}=file:read_file(Paths),{ok,Expected}=file:consult(Witness),
Checks=maps:groups_from_list(fun(T)->element(1,T) end,Expected),
Decode=fun(B)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(binary_to_list(B)),
 sets:from_list([{N,A}||{function,N,A,_,_}<-Fs]) end,
Records=[binary:split(L,<<9>>,[global])||L<-binary:split(Raw,<<10>>,[global,trim_all])],
{ok,F}=file:open(Out,[write]),
lists:foreach(fun([Path,RP,OP,GP])->
    Ref=Decode(RP),Old=Decode(OP),New=Decode(GP),
    Er=fun(Set)->lists:sort([K||K={N,_}<-sets:to_list(Set),binary:match(atom_to_binary(N,utf8),<<"lc$^">>)=/=nomatch]) end,
    Gain=Er(sets:intersection([sets:subtract(New,Old),Ref])),
    Loss=Er(sets:intersection([sets:subtract(Old,New),Ref])),
    T=lists:sort([element(2,E)||E<-maps:get(binary_to_list(Path),Checks,[])]),
    W=[K||K<-Gain,lists:member(K,T)],
    io:format(F,"~0p.~n",[{Path,length(T),Gain,Loss,W}])
end,Records),ok=file:close(F),halt().