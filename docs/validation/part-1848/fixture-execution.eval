[Path]=init:get_plain_arguments(),
Name=beam_guarded_non_gc_bif,
{ok,Image}=file:read_file(Path),
{module,Name}=code:load_binary(Name,Path,Image),
true=code:add_patha("."),
Calls=[{classify,[{yes,1},kept]},
       {classify,[{no,1},kept]},
       {classify,[wrong,kept]},
       {classify,[{},kept]},
       {choose,[1,{yes},a]},
       {choose,[0,{yes},b]},
       {choose,[2,{no,yes},c]},
       {choose,[2,{yes},d]},
       {second,[{tag,yes},kept]},
       {second,[{yes},kept]},
       {tuple_tag,[{a,b},kept]},
       {tuple_tag,[{a,b,c},kept]}],
io:format("~0p.~n",[[{F,Args,apply(Name,F,Args)} || {F,Args}<-Calls]]),
halt().
