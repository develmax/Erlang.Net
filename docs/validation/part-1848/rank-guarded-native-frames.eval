[Input,CacheDirectory,EvalIdentity,Release]=init:get_plain_arguments(),
{ok,Data}=file:read_file(Input),
Paths=[binary:split(L,<<9>>,[global]) || L <- binary:split(Data,<<10>>,[global,trim_all])],
Normalize=fun(Is) ->
    Labels=[L || {label,L} <- Is], Map=maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    Walk=fun
        T({f,L}) -> {f,maps:get(L,Map,{outside,L})};
        T({literal,_}=V) -> V;
        T({make_fun3,M,I,_,Dst,Args}) -> {make_fun3,M,I,uniq,T(Dst),T(Args)};
        T(V) when is_tuple(V) -> list_to_tuple(T(tuple_to_list(V)));
        T([H|R]) -> [T(H)|T(R)];
        T(V) -> V
    end,
    [Walk(I) || I <- Is, not(is_tuple(I) andalso lists:member(element(1,I),[label,line,func_info]))]
end,
DisasmIdentity={erlang:system_info(version),beam_disasm:module_info(md5),beam_lib:module_info(md5)},
Read=fun(P) ->
    Name=binary_to_list(string:trim(P)),
    {ok,Image}=file:read_file(Name),
    Key=crypto:hash(sha256,term_to_binary({DisasmIdentity,EvalIdentity,crypto:hash(sha256,Image)})),
    Entry=filename:join(CacheDirectory,binary_to_list(binary:encode_hex(Key))++".etf"),
    case file:read_file(Entry) of
        {ok,Cached} ->
            {Key,Functions}=binary_to_term(Cached),
            Functions;
        {error,enoent} ->
            {beam_file,_,_,_,_,Body}=beam_disasm:file(Image),
            Functions=maps:from_list([{{F,A},Normalize(Is)}||{function,F,A,_,Is}<-Body]),
            ok=file:write_file(Entry,term_to_binary({Key,Functions})),
            Functions
    end
end,
Slots=fun(Is) -> [N || I <- Is,is_tuple(I),N <- case I of {allocate,S,_}->[S];{allocate_heap,S,_,_}->[S];_->[] end] end,
Bifs=fun(Is) -> [{Name, length(Ss)} || {bif,Name,{f,L},Ss,_} <- Is, is_integer(L)] end,
Forbidden=[call,call_ext,call_fun,call_fun2,apply,apply_last,try_end,try_case,catch_end,loop_rec,loop_rec_end,wait,wait_timeout,raise,raw_raise,build_stacktrace],
Pairs=[binary:split(L,<<9>>,[global]) || L <- binary:split(Data,<<10>>,[global,trim_all])],
lists:foreach(fun([Name,Before]) ->
    P=filename:join(Release,binary_to_list(string:trim(Name))),
    R=Read(list_to_binary(P)), B=Read(Before),
    Rows=lists:filtermap(fun({M,Is}) ->
        Expected=maps:get(M,R,[]),
        Fs=Bifs(Is),
        case Slots(Is)=/=[] andalso Slots(Expected)=:=[] andalso Fs=/=[] andalso
            not lists:any(fun(I)->is_tuple(I) andalso lists:member(element(1,I),Forbidden) end,Is) of
            true -> {true,{M,Fs,Slots(Is)}};
            false -> false
        end
    end,maps:to_list(B)),
    case Rows of []->ok;_->io:format("~0p.~n",[{Name,Rows}]) end
end,Pairs),
halt().
