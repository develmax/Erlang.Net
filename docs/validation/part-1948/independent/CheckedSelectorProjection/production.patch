diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedSelectorProjection.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedSelectorProjection.cs
