[Path,Image]=init:get_plain_arguments(),
M=beam_structural_closure_generators,
{ok,Beam}=file:read_file(Image),
{module,M}=code:load_binary(M,Path,Beam),
{beam_file,_,_,_,_,Fs}=beam_disasm:file(Beam),
Owned=[T||T={function,F,_,_,_}<-Fs,F=:=tuple_branch orelse F=:=cons_branch orelse lists:prefix("-tuple_branch/",atom_to_list(F)) orelse lists:prefix("-cons_branch/",atom_to_list(F))],
[io:format("body ~0tp~n",[T])||T<-Owned],
io:format("functions ~0tp~n",[[{F,A}||{function,F,A,_,_}<-Owned]]),
Checks=[{tuple_rows,[first,{other,second}],fun()->M:tuple_branch({entries,[{row,first},second]}) end},
 {untouched_tuple,{status,third},fun()->M:tuple_branch({status,third}) end},
 {variable_default,{unknown,none},fun()->M:tuple_branch(none) end},
 {empty_default,[],fun()->M:cons_branch([],tag) end},
 {captured_rows,[{tag,first},{tag,last}],fun()->M:cons_branch([first,last],tag) end},
 {invalid_tail,{error,{bad_generator,bad_tail}},fun()->M:cons_branch([first|bad_tail],tag) end},
 {invalid_clause,{error,function_clause},fun()->M:cons_branch(invalid,tag) end}],
[begin Value=try F() catch error:R:Stack->io:format("stack ~w ~0tp~n",[K,hd(Stack)]),{error,R} end,
    io:format("~w ~0tp~n",[K,Value]),Expected=Value end||{K,Expected,F}<-Checks],
halt().
