[Path,Image]=init:get_plain_arguments(),
M=beam_literal_identity_case_probe,
{ok,Beam}=file:read_file(Image),
{module,M}=code:load_binary(M,Path,Beam),
{beam_file,_,_,_,_,Fs}=beam_disasm:file(Beam),
[io:format("body ~0tp~n",[T])||T={function,F,_,_,_}<-Fs,F=/=module_info],
Cases=[{member,[zulu,any],zulu},{member,['écho',any],'écho'},{member,[gamma,[]],{error,{case_clause,gamma}}},
 {selected_second,[alpha,south],south},{selected_second,[north,0],{error,{case_clause,0}}},
 {guarded,[gamma,true],gamma},{guarded,[gamma,false],{error,{case_clause,gamma}}},{guarded,[delta,false],delta},
 {singleton,[single],single},{singleton,[gamma],{error,{case_clause,gamma}}},
 {boolean,[true],true},{boolean,[false],false},{boolean,[other],{error,{case_clause,other}}},
 {mapped,[zulu],other},{explicit_default,[not_a_member],fallback}],
[begin Value=try erlang:apply(M,N,Args) catch error:R:S->io:format("stack ~w ~0tp~n",[N,hd(S)]),{error,R} end,
     io:format("value ~w ~0tp ~0tp~n",[N,Args,Value]),Expected=Value end||{N,Args,Expected}<-Cases],
halt().
