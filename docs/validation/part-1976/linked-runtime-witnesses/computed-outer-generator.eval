[Path,Image]=init:get_plain_arguments(),
M=beam_computed_outer_generators,
{ok,Beam}=file:read_file(Image),
{module,M}=code:load_binary(M,Path,Beam),
{beam_file,_,_,_,_,Fs}=beam_disasm:file(Beam),
Own=fun(F)->lists:prefix("-joined/",atom_to_list(F)) orelse lists:prefix("-each/",atom_to_list(F)) end,
[io:format("body ~0tp~n",[T])||T={function,F,_,_,_}<-Fs,F=:=joined orelse F=:=each orelse Own(F)],
[{each,2},{'-each/2-lc$^0/1-0-',2},{'-each/2-lc$^1/1-1-',4}]=[{F,A}||{function,F,A,_,_}<-Fs,F=:=each orelse lists:prefix("-each/",atom_to_list(F))],
[{joined,2},{'-joined/2-lc$^0/1-0-',2},{'-joined/2-lc$^1/1-1-',4}]=[{F,A}||{function,F,A,_,_}<-Fs,F=:=joined orelse lists:prefix("-joined/",atom_to_list(F))],
Read=fun F(A)->receive {observed,Event}->F([Event|A]) after 0->lists:reverse(A) end end,
Run=fun(Label,F,Want,Events)->
  Value=try {ok,F()} catch C:R:S -> {C,R,hd(S)} end,
  Measured=Read([]),
  io:format("~w ~0tp ~0tp~n",[Label,Value,Measured]),
  Want=case Value of {error,Reason,_}->{error,Reason}; _->Value end,
  Events=Measured
end,
Run(joined,fun()->M:joined([first,empty,last],#{first=>[1,2],last=>[3]}) end,{ok,[{first,1},{first,2},{last,3}]},[outer,first,empty,last]),
Run(bad_outer,fun()->M:joined(bad_outer,#{}) end,{error,{bad_generator,bad_outer}},[outer]),
Run(bad_inner,fun()->M:joined([first,bad,last],#{first=>[1],bad=>bad_inner}) end,{error,{bad_generator,bad_inner}},[outer,first,bad]),
Run(unreached_bad_inner,fun()->M:each([],bad_inner) end,{ok,[]},[outer]),
Run(evaluated_bad_inner,fun()->M:each([first],bad_inner) end,{error,{bad_generator,bad_inner}},[outer]),
Run(independent,fun()->M:each([first,last],[1,2]) end,{ok,[{first,1},{first,2},{last,1},{last,2}]},[outer]),
halt().
