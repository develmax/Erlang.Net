[Path,Image]=init:get_plain_arguments(),
M=beam_terminal_literal_mapping,
{ok,Beam}=file:read_file(Image),
{module,M}=code:load_binary(M,Path,Beam),
{beam_file,_,_,_,_,Fs}=beam_disasm:file(Beam),
[io:format("body ~0tp~n",[T])||T={function,F,_,_,_}<-Fs,F=/=module_info],
Run=fun(N,Args,Expected)->
  Value=try erlang:apply(M,N,Args) catch error:R:S->io:format("stack ~w ~0tp~n",[N,hd(S)]),{error,R} end,
  io:format("value ~w ~0tp ~0tp~n",[N,Args,Value]),Expected=Value end,
undefined=erlang:get(fallback_called),
Run(convert,[east],4),Run(convert,[south],10),Run(convert,[west],{error,unknown_cardinal}),
Run(render,[pi,kept],"p"),Run(fallback_effect,[],undefined),
Run(render,[unchanged,kept],{unchanged,kept}),Run(fallback_effect,[],{unchanged,kept}),
Run(case_map,[cedar,unused],["shared"]),Run(case_map,[alpha,unused],["shared"]),
Run(case_map,[delta,unused],["distinct",{entry,4}]),Run(case_map,[beta,unused],[]),
Run(case_map,[none,unused],{error,{case_clause,none}}),
Run(guarded,[alpha,true],"g"),Run(guarded,[alpha,false],{error,{case_clause,alpha}}),
Run(two_columns,[beta,secondary],2),Run(two_columns,[beta,primary],{error,wrong_column}),
halt().
