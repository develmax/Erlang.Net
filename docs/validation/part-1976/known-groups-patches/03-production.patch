diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.AtomGuardAlternatives.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.AtomGuardAlternatives.cs
