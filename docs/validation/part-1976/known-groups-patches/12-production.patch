@@ -160,6 +160,91 @@
                 constant = projected;
 
                 return true;
+            }
+        }
+
+        private bool HasExactAtomOrTaggedTupleResult(EntryCall selector, Atom tag, int arity)
+        {
+            if (selector.Module is not null || selector.Call is not { Module: null, DynamicRemote: false })
+            {
+                return false;
+            }
+
+            var active = new HashSet<(string Name, int Arity)>();
+            var known = new Dictionary<(string Name, int Arity), int>();
+
+            return Read(selector.Call) == (AtomTypeBits | TupleTypeBits);
+
+            int Read(Expr expression)
+            {
+                switch (expression)
+                {
+                    case Expr.Literal { Value: Atom }:
+                        return AtomTypeBits;
+                    case Expr.Literal { Value: TupleTerm literal }:
+                        return literal.Items.Count == arity && tag.Equals(literal.Items[0]) ? TupleTypeBits : AnyTypeBits;
+                    case Expr.Tuple tuple:
+                        return tuple.Items.Count == arity
+                            && AttributeLiteral.TryNormalizeConstant(tuple.Items[0], out Term first) && tag.Equals(first)
+                            ? TupleTypeBits : AnyTypeBits;
+                    case Expr.RecordConstruction { Wildcard: null } record:
+                        return Read(RecordExpressions.Create(record));
+                    case Expr.Sequence { Items.Count: > 0 } sequence:
+                        return Read(sequence.Items[^1]);
+                    case Expr.Block block:
+                        return Read(block.Body);
+                    case Expr.Match match:
+                        return Read(match.Value);
+                    case Expr.Case decision:
+                        return ReadBranches(decision.Clauses);
+                    case Expr.If decision:
+                        return ReadBranches(decision.Clauses);
+                    case Expr.Call { Module: null, DynamicRemote: false } call
+                        when localFunctions.TryGetValue((call.Function, call.Arguments.Count), out var definition):
+                        var signature = (call.Function, call.Arguments.Count);
+                        if (owner.IsDeclaredNative(signature))
+                        {
+                            return AnyTypeBits;
+                        }
+
+                        if (known.TryGetValue(signature, out int result))
+                        {
+                            return result;
+                        }
+
+                        if (!active.Add(signature))
+                        {
+                            return AnyTypeBits;
+                        }
+
+                        result = ReadBranches(definition.Clauses);
+                        active.Remove(signature);
+                        known.Add(signature, result);
+
+                        return result;
+                    case Expr.Call { Module: null or ErlangModuleNames.Module, DynamicRemote: false } raises
+                        when (raises.Function, raises.Arguments.Count) is
+                            (AutoImportNames.Error, 1 or 2 or 3) or (AutoImportNames.Exit or AutoImportNames.Throw, 1)
+                            && owner.ResolvesErlangBif(raises):
+                        return 0;
+                    default:
+                        return AnyTypeBits;
+                }
+            }
+
+            int ReadBranches(IReadOnlyList<Clause> clauses)
+            {
+                int result = 0;
+                foreach (Clause clause in clauses)
+                {
+                    result |= Read(clause.Body);
+                    if (result == AnyTypeBits)
+                    {
+                        break;
+                    }
+                }
+
+                return result;
             }
         }
 
