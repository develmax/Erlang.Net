--- /dev/null
+++ b/tests/Erlang.Tests/Compiler/Beam/Calls/BeamNestedSingletonCaptureChecks.cs
@@ -0,0 +1,83 @@
+using System.Numerics;
+using Erlang.Compiler;
+using static Erlang.Compiler.BeamEmissionFormat;
+using static Erlang.Tests.BeamBinaryHostAccess;
+
+namespace Erlang.Tests;
+
+internal static class BeamNestedSingletonCaptureChecks
+{
+    internal const string TestName = "compiler/beam/keeps-private-singleton-nested-capture-arity";
+    private const string Fixture = "beam_known_nested_capture.erl";
+    private const string ExpectedCapture = "A known capture must be literal at the parent call and in the inner tuple without changing helper arity.";
+    private const string UnexpectedCapture = "Mixed, exported and escaping locals must retain a variable capture.";
+    private const string Source = """
+        -module(beam_known_nested_capture).
+        -export([uniform/1, uniform_again/1, varied/2, fixed_varied/1, escaped/0, fixed_escaped/1, exported/2, fixed_export/1]).
+
+        uniform(Input) -> closed(error, Input).
+        uniform_again(Input) -> closed(error, Input).
+        varied(Tag, Input) -> mixed(Tag, Input).
+        fixed_varied(Input) -> mixed(error, Input).
+        escaped() -> fun dynamic/2.
+        fixed_escaped(Input) -> dynamic(error, Input).
+        fixed_export(Input) -> exported(error, Input).
+
+        closed(Tag, Input) ->
+            lists:sort([{Tag, Item} || {_Key, Values} <- Input, Item <- Values]).
+        mixed(Tag, Input) ->
+            lists:sort([{Tag, Item} || {_Key, Values} <- Input, Item <- Values]).
+        dynamic(Tag, Input) ->
+            lists:sort([{Tag, Item} || {_Key, Values} <- Input, Item <- Values]).
+        exported(Tag, Input) ->
+            lists:sort([{Tag, Item} || {_Key, Values} <- Input, Item <- Values]).
+        """;
+
+    internal static Task Run()
+    {
+        object code = Code(CodeGeneration.CompileBeamModule(Source, Fixture));
+        object[] instructions = Items(code, "Instructions").ToArray();
+        string[] atoms = Items(Property(code, "Structure"), "Atoms").Cast<string>().ToArray();
+        int errorAtom = Array.IndexOf(atoms, "error");
+        if (!Body("closed", 2).Any(instruction => Opcode(instruction) == Move
+                && Items(instruction, "Operands").ToArray() is [var source, var destination]
+                && IsErrorAtom(source) && (string)Property(destination, "Kind") == "x" && Value(destination) == 1)
+            || !Body("-closed/2-lc$^1/1-1-", 3).Any(ConstructsErrorPair)
+            || !Body("-closed/2-lc$^0/1-0-", 2).Any())
+        {
+            throw new InvalidOperationException(ExpectedCapture);
+        }
+
+        foreach (string owner in new[] { "mixed", "dynamic", "exported" })
+        {
+            string inner = $"-{owner}/2-lc$^1/1-1-";
+            object[] body = Body(inner, 3).ToArray();
+            if (body.Length == 0 || body.Any(ConstructsErrorPair))
+            {
+                throw new InvalidOperationException(UnexpectedCapture);
+            }
+        }
+
+        return Task.CompletedTask;
+
+        bool ConstructsErrorPair(object instruction) =>
+            Opcode(instruction) == PutTuple && Items(instruction, "Operands").Skip(2).Any(IsErrorAtom);
+
+        bool IsErrorAtom(object operand) => (string)Property(operand, "Kind") == "atom" && Value(operand) == errorAtom;
+
+        IEnumerable<object> Body(string name, int arity)
+        {
+            int first = Array.FindIndex(instructions, instruction => Opcode(instruction) == FunctionInfo
+                && Items(instruction, "Operands").ToArray() is [_, var atom, var count]
+                && atoms[Value(atom)] == name && Value(count) == arity);
+
+            return first < 0
+                ? []
+                : instructions.Skip(first + 1).TakeWhile(instruction => Opcode(instruction) != FunctionInfo);
+        }
+    }
+
+    private static byte Opcode(object instruction) => (byte)Property(Property(instruction, "Definition"), "Opcode");
+
+    private static int Value(object operand) => (int)(BigInteger)Property(operand, "Value");
+}
