param([ValidateSet('Dispatch','Status','Download')][string]$Mode='Status')
$ErrorActionPreference = 'Stop'
$repository = 'https://api.github.com/repos/develmax/Erlang.Net'
$frozenPath = 'artifacts/part-278-native269-queue-frozen-head.txt'
$dispatchPath = 'artifacts/part-278-native269-queue-reference-dispatch.json'
$baseline = '911c73f67c6339149f6eadd7b7a6255400abd053'
$required = @('.github/workflows/distribution-queue-contrasts.yml', 'tools/Erlang.DistributionQueueContrasts/Erlang.DistributionQueueContrasts.csproj', 'tools/Erlang.DistributionQueueContrasts/source-plan.json', 'tools/Erlang.DistributionQueueContrasts/distribution_queue_stat_probe.erl', 'tools/Erlang.DistributionQueueContrasts/distribution_queue_stat_fresh_probe.erl', 'tools/Erlang.DistributionQueueContrasts/distribution_queue_stat_additive_probe.erl', 'docs/validation/part-278/evidence-receipt.json')
if ($Mode -eq 'Dispatch') {
    $candidateHead = (git rev-parse HEAD).Trim()
    if ($LASTEXITCODE -ne 0 -or $candidateHead -eq $baseline) { throw 'Part278 must be committed and published before dispatch' }
    foreach ($path in $required) {
        git cat-file -e "$($candidateHead):$path"
        if ($LASTEXITCODE -ne 0) { throw "Committed278 source missing: $path" }
    }
    py artifacts/native269-checkpoint278-queue-committed-source-guard.py $candidateHead
    if ($LASTEXITCODE -ne 0) { throw 'Committed queue source/plan closure differs from reviewed inputs' }
    git diff --quiet HEAD -- src tests tools .github/workflows
    if ($LASTEXITCODE -ne 0) { throw 'Committed278 source bindings failed' }
    if (Test-Path -LiteralPath $dispatchPath) { throw 'Part278 queue dispatch attempt receipt already exists; never duplicate dispatch' }
    if ((Test-Path -LiteralPath $frozenPath) -and [IO.File]::ReadAllText($frozenPath).Trim() -cne $candidateHead) { throw 'Never replace frozen278 head' }
    $head = $candidateHead
} else {
    $head = [IO.File]::ReadAllText($frozenPath).Trim()
}
if ($head -notmatch '^[0-9a-f]{40}$') { throw 'Unexpected278 implementation head' }
$credentialLines = "protocol=https`nhost=github.com`n`n" | git credential fill
if ($LASTEXITCODE -ne 0) { throw 'Credential provider failed' }
$passwordLine = $credentialLines | Where-Object { $_ -like 'password=*' } | Select-Object -First 1
if ($null -eq $passwordLine) { throw 'Credential provider returned no token' }
$secret = $passwordLine.Substring(9)
$headers = @{ 'User-Agent'='Erlang.Net-development-validation'; Authorization="Bearer $secret"; Accept='application/vnd.github+json' }
try {
    if ($Mode -eq 'Dispatch') {
        $branch = Invoke-RestMethod -Uri "$repository/branches/main" -Headers $headers
        if ($branch.commit.sha -cne $head) { throw 'Published remote main differs from committed278 head' }
        if (!(Test-Path -LiteralPath $frozenPath)) { [IO.File]::WriteAllText($frozenPath,$head+[char]10) }
        $receipt = [ordered]@{ Head=$head; QueueFreshScenarioVms=7; QueueMetadataVms=1; QueuePinnedBuilds=1; RequiredCaseArtifacts=132; NativeCorpusPlanned=0; FdPlanned=0; Original275Rerun=$false; PriorQueueRetry=$false; SdkExpectedUsed=$false; PhysicalQueueAbiParityClaim=$false; Workflows=@() }
        # Write before each mutation so an unknown dispatch outcome cannot silently repeat it.
        foreach ($workflow in @('distribution-queue-contrasts.yml')) {
            $row = [ordered]@{ Workflow=$workflow; Status='DispatchAttemptRecorded'; Utc=[DateTime]::UtcNow.ToString('o') }
            $receipt.Workflows += $row
            [IO.File]::WriteAllText($dispatchPath,($receipt | ConvertTo-Json -Depth 8)+[char]10)
            Invoke-RestMethod -Method Post -Uri "$repository/actions/workflows/$workflow/dispatches" -Headers $headers -ContentType 'application/json' -Body '{"ref":"main"}' | Out-Null
            $row.Status = 'DispatchAccepted'
            [IO.File]::WriteAllText($dispatchPath,($receipt | ConvertTo-Json -Depth 8)+[char]10)
            Write-Output "Dispatched $workflow at $head"
        }
    }
    $runs = Invoke-RestMethod -Uri "$repository/actions/runs?head_sha=$head&per_page=30" -Headers $headers
    foreach ($run in $runs.workflow_runs) {
        if ($run.head_sha -cne $head) { throw 'Run head differs from frozen278' }
        $artifactNames = switch ($run.name) {
            'Pinned OTP distribution queue observations' { @('pinned-distribution-queue-contrasts') }
            default { $null }
        }
        if ($null -eq $artifactNames) { continue }
        $jobs = Invoke-RestMethod -Uri "$($run.url)/jobs" -Headers $headers
        [pscustomobject]@{ Run=$run.id; Name=$run.name; Status=$run.status; Conclusion=$run.conclusion; Head=$run.head_sha; Jobs=@($jobs.jobs | ForEach-Object { [pscustomobject]@{ Id=$_.id; Status=$_.status; Conclusion=$_.conclusion; Active=@($_.steps | Where-Object status -eq 'in_progress' | ForEach-Object name) } }) } | ConvertTo-Json -Depth 6
        if ($Mode -ne 'Download' -or $run.status -ne 'completed') { continue }
        foreach ($artifactName in @($artifactNames)) {
        $metadataPath = "artifacts/part-278-native269-queue-$artifactName-metadata.json"
        if (Test-Path -LiteralPath $metadataPath) {
            $saved = Get-Content -LiteralPath $metadataPath -Raw | ConvertFrom-Json
            if ($saved.Run.id -ne $run.id -or $saved.Run.head_sha -cne $head) { throw 'Existing278 download is bound to a different run; never replace' }
            continue
        }
        $artifacts = Invoke-RestMethod -Uri "$($run.url)/artifacts" -Headers $headers
        $artifact = @($artifacts.artifacts | Where-Object name -eq $artifactName)
        if ($artifact.Count -ne 1 -or $artifact[0].expired) { throw 'Missing/expired278 artifact' }
        $zip = "artifacts/part-278-native269-queue-$artifactName.zip"
        $destination = "artifacts/part-278-native269-queue-$artifactName"
        if ((Test-Path -LiteralPath $zip) -or (Test-Path -LiteralPath $destination)) { throw 'Partial278 download exists; inspect rather than overwrite' }
        Invoke-WebRequest -Uri $artifact[0].archive_download_url -Headers $headers -OutFile $zip
        Expand-Archive -LiteralPath $zip -DestinationPath $destination
        [pscustomobject]@{ Run=$run; Jobs=$jobs.jobs; Artifact=$artifact[0]; ZipSHA256=(Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash } | ConvertTo-Json -Depth 18 | Set-Content -LiteralPath $metadataPath
        Write-Output "Downloaded $artifactName artifact $($artifact[0].id)"
        }
    }
} finally {
    $secret=$null; $passwordLine=$null; $credentialLines=$null; $headers=$null
}

