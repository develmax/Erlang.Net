[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    hd(Fs)
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_entry_tag_dispatch_probe,Path,B),
    {one,two}=M:same_arity({left,one,two}),
    {two,one}=M:same_arity({right,one,two}),
    missing=M:same_arity({unknown,one,two}),
    missing=M:same_arity({left,one}),
    missing=M:same_arity(not_a_tuple),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
