[{a,prefix,1},{b,prefix,2}]=beam_tuple_list_comprehension:project([{a,1},ignored,{bad,shape,3},{b,2}],prefix),
[]=beam_tuple_list_comprehension:project([],prefix),
[{same,a},{same,1}]=beam_tuple_list_comprehension:repeated([{a,a},{b,c},{1,1.0},{1,1},ignored]),
[{a,1},{b,2}]=beam_tuple_list_comprehension:identity([{a,1},ignored,{b,2}]),
[first,second]=beam_tuple_list_comprehension:nested([{tag,{first,ignored}},{other,{ignored,ignored}},{tag,{second,value}},{tag,malformed}]),
put(seen,[]),
[{prefix,k1,1},{prefix,k2,2}]=beam_tuple_list_comprehension:called([{k1,1},wrong,{k2,2}],prefix),
[k2,k1]=get(seen),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_tuple_list_comprehension:project([wrong|improper],prefix)),
{'EXIT',{{bad_generator,invalid},_}}=(catch beam_tuple_list_comprehension:identity(invalid)),
put(seen,[]),
{'EXIT',{{bad_generator,improper},_}}=(catch beam_tuple_list_comprehension:called([{k1,1},wrong|improper],prefix)),
[k1]=get(seen),
io:format("11 assertions passed~n"),
halt().
