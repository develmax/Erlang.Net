[Image,Output]=init:get_plain_arguments(),
{ok,Bytes}=file:read_file(Image),
true=code:unstick_mod(erl_syntax),
{module,erl_syntax}=code:load_binary(erl_syntax,Image,Bytes),
S=erl_syntax,
Atom=S:atom(sample),
Variable=S:variable('Value'),
Integer=S:integer(42),
Literal=S:abstract(#{title=>{value,42}}),
Tail=S:variable('Tail'),
Binary=S:binary([S:binary_field(Integer)]),
Tuple=S:tuple([Atom,Integer]),
List=S:list([Atom,Integer],Tail),
Operator=S:operator('+'),
Expression=S:infix_expr(Integer,Operator,Variable),
Application=S:application(Atom,[Variable,Tuple]),
Clause=S:clause([Variable],none,[Application]),
Case=S:case_expr(Variable,[Clause]),
Block=S:block_expr([Application,Case]),
Nodes=[Atom,Variable,Integer,Literal,Binary,Tuple,List,Operator,Expression,Application,Clause,Case,Block],
Rows=[{S:type(Node),S:get_pos(Node),S:revert(Node)}||Node<-Nodes],
ok=file:write_file(Output,term_to_binary(Rows)),
io:format("~B observations~n",[length(Rows)]),
halt(0).