diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TupleHeadListAccumulator.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TupleHeadListAccumulator.cs
