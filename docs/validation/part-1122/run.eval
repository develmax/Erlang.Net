[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    []=[Name || {function,Name,_,_,_}<-Fs,Name=:=checked],
    [Instructions]=[Is || {function,run,1,_,Is}<-Fs],
    io:format("~s~n~p~n",[Path,Instructions]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_nested_inline_list_probe,Path,B),
    {ok,[head|tail]}=M:run([head|tail]),
    {ok,[head]}=M:run([head]),
    {error,{badmatch,[]}}=try M:run([]) of V->{value,V} catch error:R->{error,R} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
