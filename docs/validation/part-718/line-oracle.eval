A="artifacts/beam-backend/part718-eldap/ELDAPv3.release-profile.beam",O="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",{ok,_,AC}=beam_lib:all_chunks(A),{ok,_,OC}=beam_lib:all_chunks(O),Read=fun(Cs)->{"Line", B}=lists:keyfind("Line",1,Cs),<<V:32,F:32,I:32,L:32,N:32,_/binary>>=B,{B,{V,F,I,L,N}} end,
{OB,OH}=Read(OC),{AB,AH}=Read(AC),
