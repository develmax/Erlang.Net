[D]=init:get_plain_arguments(),
Names=[nested_cleanup_dep,nested_call_result_cleanup],
lists:foreach(fun(M)->P=filename:join(D,atom_to_list(M)),
                    {module,M}=code:load_abs(P) end, Names),
M=nested_call_result_cleanup,
{saved,stable}=M:run({found,accept},stable),
undefined=erase(last_cleanup),
{error,inner}=M:run({found,{error,inner}},stable),
{inner,stable}=erase(last_cleanup),
{error,outer}=M:run({error,outer},stable),
{outer,stable}=erase(last_cleanup),
{error,inner}=M:direct({found,{error,inner}},stable),
{outer,stable}=erase(last_cleanup),
cleanup_failed=try M:run({found,{error,inner}},crash) catch error:Reason->Reason end,
{error,inner}=M:caught({found,{error,inner}},crash),
{beam_file,_,_,_,_,Fs}=beam_disasm:file(filename:join(D,atom_to_list(M)++".beam")),
lists:foreach(fun(F)->io:format("~0p.~n",[F]) end,[F||{function,N,2,_,_}=F<-Fs,lists:member(N,[run,direct,caught])]),
io:format("{execution,passed}.~n",[]),halt().

