Release="D:/Distr/Work/Codex/Erlang.Net/Erlang.Net/artifacts/library376-official-compiler/installed/lib/eldap-1.3.1/ebin/ELDAPv3.beam",
Actual="artifacts/beam-backend/part684-eldap/ELDAPv3.release-profile.beam",
Read=fun(P)->{beam_file,_,_,_,_,Fs}=beam_disasm:file(P),[I]=[Ops||{function,dec_LDAPMessage_protocolOp,2,_,Ops}<-Fs],I end,
Norm=fun(I)->
    Labels=[L||{label,L}<-I],
    Map=maps:from_list(lists:zip(Labels,lists:seq(1,length(Labels)))),
    F=fun R({label,L})->{label,maps:get(L,Map,L)};
          R({f,L})->{f,maps:get(L,Map,L)};

          R(T) when is_tuple(T)->list_to_tuple([R(E)||E<-tuple_to_list(T)]);
          R(L) when is_list(L)->[R(E)||E<-L];
          R(X)->X end,
    [F(Op)||Op<-I]
end,
R=Norm(Read(Release)),A=Norm(Read(Actual)),
Delta=[{K,U,V}||{{U,V},K}<-lists:zip(lists:zip(R,A,trim),lists:seq(1,min(length(R),length(A)))),U=/=V],
io:format("OTP=~p managed=~p equal_after_normalizing_labels=~p first_deltas=~p~n",[length(R),length(A),R=:=A,lists:sublist(Delta,6)]),case R=:=A of true->halt();false->halt(1) end.