[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    io:format("~s~n~p~n",[Path,[{N,Is} || {function,N,_,_,Is}<-Fs,lists:member(N,[nested_binary,literal_result,joined_case])]]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    {tag,Bin}=M:nested_binary(head),
    head=binary_to_term(Bin),
    {stop,normal,done}=M:literal_result(timeout,head),
    function_clause=(try M:literal_result(other,head) catch error:R -> R end),
    {ok,joined}=M:joined_case(active),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
