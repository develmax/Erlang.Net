[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, slot_reuse_probe} = code:load_binary(slot_reuse_probe, Path, Binary),
undefined = put(key, start),
{start,kept} = slot_reuse_probe:reuse(a,key,once,kept),
kept = get(once),
{a,twice} = slot_reuse_probe:keep(b,key,twice,other),
other = get(twice),
{b,c} = slot_reuse_probe:duplicate(c,key,twice),
twice = get(twice),
F = slot_reuse_probe:closure(key,lifted),
{c,again} = F(d,again),
again = get(lifted),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [Item]) || Item = {function, Name, _, _, _} <- Functions, Name =/= module_info],
halt().
