diff --git a/tests/Erlang.Tests/Compiler/Beam/Frames/BeamAtomOwnedNestedRecordChecks.cs b/tests/Erlang.Tests/Compiler/Beam/Frames/BeamAtomOwnedNestedRecordChecks.cs
