diff --git a/tests/Erlang.Tests/Compiler/Beam/Calls/BeamZeroBifArgumentOrderChecks.cs b/tests/Erlang.Tests/Compiler/Beam/Calls/BeamZeroBifArgumentOrderChecks.cs
