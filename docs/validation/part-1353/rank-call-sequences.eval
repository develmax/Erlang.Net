[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Kinds = fun(Body) ->
    Binding = fun({match,_,{var,_,Name},{call,_,_,Args}}) when Name =/= '_' -> {Name,Args};
                 (_) -> none
              end,
    Ordinary = fun({call,_,_,_}) -> true;
                  (Expression) -> Binding(Expression) =/= none
               end,
    Forwards = fun(Name, Args) ->
        length([ok || Arg <- Args, case Arg of
            {var,_,Name} -> true;
            {cons,_,{var,_,Name},{nil,_}} -> true;
            _ -> false
        end]) =:= 1
    end,
    case Body of
        [First,_,_|_] ->
            Last = lists:last(Body),
            EndsInCall = case Last of {call,_,_,_} -> true; _ -> false end,
            case {Binding(First),EndsInCall} of
                {{_,_},true} ->
                    Prefix = lists:sublist(Body,length(Body)-1),
                    Steps = [Binding(Expression) || Expression <- Prefix],
                    Linear = lists:all(fun(Step) -> Step =/= none end,Steps)
                        andalso begin
                            {call,_,_,LastArgs} = Last,
                            lists:all(fun({{Name,_},{_,Args}}) -> Forwards(Name,Args) end,
                                lists:zip(Steps,tl(Steps)++[{tail,LastArgs}]))
                        end,
                    AllCalls = lists:all(Ordinary,Body),
                    [Kind || {Kind,Present} <- [{bound_first_tail_last,true},
                        {linear_forwarding,Linear},{other_call_sequence,AllCalls andalso not Linear},
                        {mixed_expression_sequence,not AllCalls}], Present];
                {{_,_},false} ->
                    Result = case Last of
                        {tuple,_,_} -> tuple_result;
                        {cons,_,_,_} -> list_result;
                        {'case',_,_,_} -> case_result;
                        {var,_,_} -> variable_result;
                        _ -> other_value_result
                    end,
                    [bound_first_value_result,Result];
                {none,true} ->
                    case First of {call,_,_,_} -> [discarded_first_tail_last]; _ -> [] end;
                _ -> []
            end;
        _ -> []
    end
end,
Files = lists:sort(filelib:fold_files(Generated,"[.]beam$",true,fun(Path,Acc) -> [Path|Acc] end,[])),
Totals = lists:foldl(fun(Path,Acc) ->
    Relative = lists:nthtail(length(filename:split(Generated)),filename:split(Path)),
    case beam_lib:chunks(filename:join([Reference|Relative]),[abstract_code]) of
        {ok,{Module,[{abstract_code,{raw_abstract_v1,Forms}}]}} ->
            Groups = lists:foldl(fun({Name,Arity,Clauses},G0) ->
                Shapes = lists:usort(lists:append([Kinds(Body) || {clause,_,_,_,Body} <- Clauses])),
                lists:foldl(fun(Shape,G) -> maps:update_with(Shape,fun(Mfas) ->
                    [{Name,Arity}|Mfas] end,[{Name,Arity}],G) end,G0,Shapes)
            end,#{},[{Name,Arity,Clauses} || {function,_,Name,Arity,Clauses} <- Forms]),
            maps:fold(fun(Shape,Mfas,All) ->
                Count = length(Mfas),
                Example = {Module,lists:min(Mfas)},
                maps:update_with(Shape,fun({Modules,Functions,Examples}) ->
                    {Modules+1,Functions+Count,lists:sublist([Example|Examples],3)}
                end,{1,Count,[Example]},All)
            end,Acc,Groups);
        _ -> Acc
    end
end,#{},Files),
io:format("Sequence shapes in top-level function clauses of ~p differing images.~n",[length(Files)]),
io:format("Counts are {modules, functions, examples}. Groups can overlap.~n~p~n",[Totals]),
halt().
