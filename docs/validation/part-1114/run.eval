[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    lists:sublist(Fs,2)
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_sibling_effects_probe,Path,B),
    erase(sibling_order),
    {error,left_failed}=try M:run(fail,b) of V->{value,V} catch error:R->{error,R} end,
    undefined=get(sibling_order),
    {{left,a},{right,b}}=M:run(a,b),
    right=get(sibling_order),
    {{left,a},{right,b},b}=M:keep(a,b),
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
