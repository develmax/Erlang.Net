+        string twoPayloads = Source.Replace("{stop,Reason}", "{stop,Reason,Timeout}", StringComparison.Ordinal);
+        if (twoPayloads == Source || !UsesSingleSlotTrim(Source) || UsesSingleSlotTrim(twoPayloads))
