\"$GITHUB_WORKSPACE/artifacts/beam-otp-oracle/lib/erlang/releases/29/OTP_VERSION\")\" = 29.1.1\n            echo 'PINNED_BEAM_INSTALL_VERIFIED 29.1.1'\n          } 2>&1 | tee artifacts/beam-otp-build.log\n          python3 - <<'PY'\n          import hashlib, json, os, pathlib\n          root = pathlib.Path(os.environ['GITHUB_WORKSPACE'])\n          log = root / 'artifacts/beam-otp-build.log'\n          evidence = {\n              'SourceCommit': 'ad05823719d77c8faee87348ea39513d4e2f99c5',\n              'SourceTag': 'OTP-29.1.1',\n              'SourceBuildCompleted': True,\n              'InstalledOtpRoot': str(root / 'artifacts/beam-otp-oracle/lib/erlang'),\n              'SourceBuildLog': str(log),\n              'SourceBuildLogSha256': hashlib.sha256(log.read_bytes()).hexdigest().upper(),\n              'HarnessCommit': os.environ['GITHUB_SHA'],\n              'RunId': os.environ['GITHUB_RUN_ID'],\n              'RunAttempt': os.environ['GITHUB_RUN_ATTEMPT'],\n              'Job': os.environ['GITHUB_JOB'],\n              'RunnerOs': os.environ['RUNNER_OS'],\n              'ConfigureOptions': ['--without-javac','--without-wx','--without-odbc','--without-debugger','--without-observer','--without-et'],\n              'BuildArguments': ['make','-j2'],\n              'InstallArguments': ['make','install']\n          }\n          (root / 'artifacts/beam-source-build-evidence.json').write_text(json.dumps(evidence, indent=2) + '\\n')\n          PY\n      - name: Capture eleven original payload-exit scenarios in independent fresh VMs\n        if: ${{ !cancelled() && steps.payload-exit-tool.outcome == 'success' && steps.pinned-build.outcome == 'success' }}\n        shell: bash\n        run: |\n          set -euo pipefail\n          dotnet run --project tools/Erlang.DistributionPayloadExitObservations --no-build -- artifacts/beam-otp-oracle/lib/erlang artifacts/distribution-payload-exit-observations artifacts/beam-source-build-evidence.json\n      - uses: actions/upload-artifact@v7\n        if: always()\n        with:\n          name: pinned-distribution-payload-exit-observations\n          path: |\n            artifacts/distribution-payload-exit-observations\n            artifacts/beam-otp-build.log\n            artifacts/beam-source-build-evidence.json\n            artifacts/payload-exit-observation-tool-build.log\n"
