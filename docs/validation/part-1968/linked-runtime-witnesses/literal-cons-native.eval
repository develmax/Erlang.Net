[Image]=init:get_plain_arguments(),
M=beam_literal_cons_comprehension,
{ok,Bin}=file:read_file(Image),
{module,M}=code:load_binary(M,Image,Bin),
Exact=[{exact,one},{exact,two}],
{Exact,Exact}=M:probe("ab",[one,two]),
Proper=[{{proper,"c"},one},{{proper,"c"},two}],
{Proper,Proper}=M:probe("ac",[one,two]),
Improper=[{{improper,tail},one},{{improper,tail},two}],
{Improper,Improper}=M:probe([$a|tail],[one,two]),
Other=[{other,one},{other,two}],
{Other,Other}=M:probe("ba",[one,two]),
{[],[]}=M:probe("ab",[]),
put(events,[]),
Exact=M:explicit("ab",[one,two]),
put(events,[]),
{"ab",[{{nested,note},one}]}=M:nested([{"ab",note}|rest],[one]),
{bad_generator,tail,Exact}=M:failure([one,two|tail]),
io:format("~p.~n",[{native,passed,[literal_match,proper_variable_tail,improper_variable_tail,literal_mismatch,empty_generator,explicit_cons,nested_alias,invalid_generator_effect_order]}]),
halt(0).
