[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [Instructions]=[Is || {function,arithmetic,2,_,Is}<-Fs],
    io:format("~s~n~p~n",[Path,Instructions]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_guarded_bif_tail_probe,Path,B),
    {-2,3}=M:run(-1.5,3.75),
    2=M:arithmetic(8,3),
    -2=M:arithmetic(-8,-3),
    {8,0}=M:arithmetic(8,0),
    {error,badarith}=try M:arithmetic(8,0.5) of V->{value,V} catch error:R->{error,R} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
