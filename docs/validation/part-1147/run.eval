[P,Q]=init:get_plain_arguments(),
lists:foreach(fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [Is]=[Instructions || {function,nested_result,2,_,Instructions}<-Fs],
    io:format("~s~n~p~n",[Path,Is]),
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_general_catch_probe,Path,B),
    11=M:nested_result({item,11},saved),
    {error,{{saved},other}}=M:nested_result(other,saved),
    code:delete(M),
    code:purge(M)
end,[P,Q]),
halt().
