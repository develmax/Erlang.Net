[Manifest,ModuleName,Index]=init:get_plain_arguments(),
Mod=list_to_atom(ModuleName),
{ok,Data}=file:read_file(Manifest),
Pattern = list_to_binary(ModuleName++".beam"),
[Row]=[X||X<-binary:split(Data,<<"\n">>,[global]),binary:match(X,Pattern)=/=nomatch],
Paths=[string:trim(binary_to_list(X))||X<-binary:split(Row,<<"\t">>,[global])],
Path=lists:nth(list_to_integer(Index),Paths),
{ok,Beam}=file:read_file(Path),
{module,Mod}=code:load_binary(Mod,Path,Beam),
Message = <<"BEAM parity, verified input">>,
Result=case Mod of
   crypto ->
        Digest=crypto:hash(sha256,Message),
        Digest=crypto:hash_final(crypto:hash_update(crypto:hash_init(sha256),Message)),
        binary:encode_hex(Digest);
   zstd ->
        Compressed=zstd:compress(Message),
        Message=iolist_to_binary(zstd:decompress(Compressed)),
        io_lib:format("~w",[iolist_to_binary(Compressed)])
end,
io:format("~s~n",[Result]),
halt().
