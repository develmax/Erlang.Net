[Pinned,Candidate] = init:get_plain_arguments(),
Inputs = [
 {pick,[#{alpha=>1,beta=>2}]},{pick,[#{alpha=>1}]},{pick,[#{beta=>2}]},{pick,[wrong]},
 {nest,[#{outer=>#{alpha=>8},extra=>9}]},{nest,[#{outer=>other,extra=>9}]},{nest,[#{outer=>#{alpha=>8}}]},
 {dynamic,[#{alpha=>3,extra=>4},alpha,3]},{dynamic,[#{alpha=>3,extra=>4},alpha,3.0]},
 {dynamic,[#{alpha=>3,extra=>4},beta,3]},{dynamic,[#{1=>3,1.0=>5,extra=>4},1.0,5]},
 {optional,[#{alpha=>7}]},{optional,[#{}]},{optional,[wrong]}
],
Run = fun(Path)->
 {ok,Bytes}=file:read_file(Path),{module,generic_map_input_probe}=code:load_binary(generic_map_input_probe,Path,Bytes),
 Results=[try apply(generic_map_input_probe,case Name of nest->nested; _->Name end,Args) of V->{ok,V}
  catch Class:Reason->{Class,Reason} end||{Name,Args}<-Inputs],
 true=code:delete(generic_map_input_probe),_=code:purge(generic_map_input_probe),Results
end,
R=Run(Pinned),R=Run(Candidate),
io:format("~p results and reasons agree across pinned and actual generated image~n",[length(R)]),halt().

