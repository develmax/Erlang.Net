[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Variables = fun Walk({var,_,Name}) when Name =/= '_' -> [Name];
                Walk(Items) when is_list(Items) -> lists:append([Walk(Item) || Item <- Items]);
                Walk(Item) when is_tuple(Item) -> Walk(tuple_to_list(Item));
                Walk(_) -> []
            end,
Kinds = fun(Body) ->
    case lists:reverse(Body) of
        [{'case',_,Selector,Arms}|Prefix] ->
            Ready = case {Selector,Prefix} of
                {{call,_,_,_},_} -> true;
                {{var,_,Name},[{match,_,{var,_,Name},{call,_,_,_}}|_]} -> true;
                _ -> false
            end,
            case Ready of
                false -> [];
                true -> lists:append([case Arm of
                    {clause,_,[{tuple,_,Fields}=Pattern],_,Expressions} ->
                        case lists:last(Expressions) of
                            {tuple,_,Results} ->
                                Calls = [Call || {call,_,_,_}=Call <- Results],
                                ResultVariables = [Name || {var,_,Name} <- Results],
                                Deferred = [V || V <- lists:usort(ResultVariables),
                                    lists:member(V,Variables(Pattern)),
                                    not lists:member(V,Variables(Calls))],
                                HasUnguardedVariable = lists:any(fun
                                    ({clause,_,[{var,_,_}],[],_}) -> true;
                                    (_) -> false
                                end,Arms),
                                [K || {K,true} <- [
                                    {tuple_case_computed_tuple,Calls =/= []},
                                    {tuple_case_computed_tuple_without_catchall,Calls =/= [] andalso not HasUnguardedVariable},
                                    {tuple_case_deferred_field,Calls =/= [] andalso Deferred =/= []},
                                    {tuple_case_deferred_nested_field,Calls =/= [] andalso
                                        lists:any(fun({tuple,_,_}) -> true; (_) -> false end,Fields) andalso Deferred =/= []}
                                ]];
                            _ -> []
                        end;
                    _ -> []
                end || Arm <- Arms])
            end;
        _ -> []
    end
end,
Files = lists:sort(filelib:fold_files(Generated,"[.]beam$",true,fun(Path,Acc) -> [Path|Acc] end,[])),
Totals = lists:foldl(fun(Path,Acc) ->
    Relative = lists:nthtail(length(filename:split(Generated)),filename:split(Path)),
    case beam_lib:chunks(filename:join([Reference|Relative]),[abstract_code]) of
        {ok,{Module,[{abstract_code,{raw_abstract_v1,Forms}}]}} ->
            Groups = lists:foldl(fun({Name,Arity,Clauses},G0) ->
                Shapes = lists:usort(lists:append([Kinds(Body) || {clause,_,_,_,Body} <- Clauses])),
                lists:foldl(fun(Shape,G) -> maps:update_with(Shape,fun(Mfas) ->
                    [{Name,Arity}|Mfas] end,[{Name,Arity}],G) end,G0,Shapes)
            end,#{},[{Name,Arity,Clauses} || {function,_,Name,Arity,Clauses} <- Forms]),
            maps:fold(fun(Shape,Mfas,All) ->
                Count = length(Mfas),
                Example = {Module,lists:min(Mfas)},
                maps:update_with(Shape,fun({Modules,Functions,Examples}) ->
                    {Modules+1,Functions+Count,lists:sublist([Example|Examples],3)}
                end,{1,Count,[Example]},All)
            end,Acc,Groups);
        _ -> Acc
    end
end,#{},Files),
io:format("Deferred tuple fields in top-level function clauses of ~p differing images.~n",[length(Files)]),
io:format("Counts are {modules, functions, examples}. Groups can overlap.~n~p~n",[Totals]),
halt().





