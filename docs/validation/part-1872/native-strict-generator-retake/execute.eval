[P]=init:get_plain_arguments(),
M=beam_strict_list_generator_helper,{module,M}=code:load_abs(filename:rootname(P)),
B=[{tag,one},{tag,two}], Mixed=[{tag,one},bad,{tag,two}],
[one,two]=M:strict(B),[]=M:strict([]),[one,two]=M:relaxed(Mixed),Mixed=M:variable(Mixed),
[[],[one,two]]=M:nested([[],B]),
{[one,two],[two,one]}=M:observe(B),{{badmatch,bad},[one]}=M:observe(Mixed),
Fail=fun(F,In,R,Name,N)->try M:F(In) of Value->error({unexpected,Value}) catch error:R:Stack -> [{M,Name,_,Location}|_]=Stack,N=proplists:get_value(line,Location),{R,Name,N} end end,
Reports=[Fail(strict,Mixed,{badmatch,bad},'-strict/1-lc$^0/1-0-',4),Fail(strict,[{tag,one}|invalid_tail],{bad_generator,invalid_tail},'-strict/1-lc$^0/1-0-',4),
         Fail(split_source,invalid_tail,{bad_generator,invalid_tail},'-split_source/1-lc$^0/1-0-',26)],
io:format("~0p~n",[{passed,Reports}]),halt().
