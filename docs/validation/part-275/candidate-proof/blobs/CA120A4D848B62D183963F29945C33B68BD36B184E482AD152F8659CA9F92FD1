      "SourceContent": "name: Pinned OTP local node admission observations\r\non:\r\n  workflow_dispatch:\r\npermissions:\r\n  contents: read\r\njobs:\r\n  fixtures:\r\n    runs-on: ubuntu-latest\r\n    timeout-minutes: 45\r\n    steps:\r\n      - uses: actions/checkout@v7\r\n        with:\r\n          persist-credentials: false\r\n      - uses: actions/setup-dotnet@v6\r\n        with:\r\n          global-json-file: global.json\r\n      - name: Build standalone node identity observation tool\r\n        shell: bash\r\n        run: |\r\n          set -euo pipefail\r\n          mkdir -p artifacts\r\n          dotnet build tools/Erlang.LocalNodeAdmissionContrasts -m:1 --disable-build-servers 2>&1 | tee artifacts/beam-fixture-tool-build.log\r\n      - name: Build and attest the pinned development compiler\r\n        shell: bash\r\n        run: |\r\n          set -euo pipefail\r\n          {\r\n            echo \"PINNED_BEAM_SOURCE_BEGIN $GITHUB_SHA\"\r\n            git clone --depth 1 --branch OTP-29.1.1 https://github.com/erlang/otp.git artifacts/beam-otp-source\r\n            source_commit=\"$(git -C artifacts/beam-otp-source rev-parse HEAD)\"\r\n            test \"$source_commit\" = ad05823719d77c8faee87348ea39513d4e2f99c5\r\n            echo \"PINNED_BEAM_SOURCE_VERIFIED $source_commit\"\r\n            cd artifacts/beam-otp-source\r\n            echo 'PINNED_BEAM_CONFIGURE --without-javac --without-wx --without-odbc --without-debugger --without-observer --without-et'\r\n            ./configure --prefix=\"$GITHUB_WORKSPACE/artifacts/beam-otp-oracle\" --without-javac --without-wx --without-odbc --without-debugger --without-observer --without-et\r\n            echo 'PINNED_BEAM_MAKE -j2'\r\n            make -j2\r\n            echo 'PINNED_BEAM_INSTALL'\r\n            make install\r\n            test \"$(cat \"$GITHUB_WORKSPACE/artifacts/beam-otp-oracle/lib/erlang/releases/29/OTP_VERSION\")\" = 29.1.1\r\n            echo 'PINNED_BEAM_INSTALL_VERIFIED 29.1.1'\r\n         