      "SourceContent": "internal static class CaptureControlNames\n{\n    internal const string Dotnet = \"dotnet\";\n    internal const string RawChild = \"raw-child\";\n    internal const string Holder = \"hold-child\";\n    internal const string SpawnHolder = \"spawn-holder\";\n    internal const string Raw = \"raw\";\n    internal const string Pipes = \"pipes\";\n    internal const string ChildFile = \"child.pid\";\n    internal const string Stdout = \"raw.stdout\";\n    internal const string Stderr = \"raw.stderr\";\n    internal const string Failure = \"Actual byte capture or bounded inherited-pipe control failed.\";\n    internal const string Pass = \"PASS\";\n    internal const int RawExit = 3;\n    internal static readonly byte[] RawOutput = [0, 128, 255];\n    internal static readonly byte[] RawError = [254, 0, 129];\n    internal static readonly TimeSpan HoldTime = TimeSpan.FromSeconds(20);\n    internal static readonly TimeSpan ExitDeadline = TimeSpan.FromSeconds(5);\n    internal static readonly TimeSpan CaptureDeadline = TimeSpan.FromSeconds(12);\n}\n"
