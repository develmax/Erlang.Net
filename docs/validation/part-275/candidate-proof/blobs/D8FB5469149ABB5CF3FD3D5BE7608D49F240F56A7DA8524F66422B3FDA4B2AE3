    {
      "Path": "artifacts/setnode2-native-oracle-capture-control/Program.cs",
      "Sha256": "A83BEC9EDC4A07F9CC372D6BEFDCC2B1E3618927975F33FAB7AB8E1CF23017FC",
      "SourceContent": "using NodeIdentityContrasts;\nusing System.Diagnostics;\nusing System.Globalization;\nusing System.Text.Json;\n\nif (args[0] == CaptureControlNames.RawChild)\n{\n    await Console.OpenStandardOutput().WriteAsync(CaptureControlNames.RawOutput);\n    await Console.OpenStandardError().WriteAsync(CaptureControlNames.RawError);\n\n    return CaptureControlNames.RawExit;\n}\nif (args[0] == CaptureControlNames.Holder)\n{\n    await Task.Delay(CaptureControlNames.HoldTime);\n\n    return 0;\n}\nif (args[0] == CaptureControlNames.SpawnHolder)\n{\n    var start = new ProcessStartInfo(CaptureControlNames.Dotnet) { UseShellExecute = false, CreateNoWindow = true };\n    start.ArgumentList.Add(typeof(NodeProcess).Assembly.Location);\n    start.ArgumentList.Add(CaptureControlNames.Holder);\n    using var child = Process.Start(start)!;\n    await File.WriteAllTextAsync(args[1], child.Id.ToString(CultureInfo.InvariantCulture));\n\n    return 0;\n}\nDirectory.CreateDirectory(args[0]);\nstring assembly = typeof(NodeProcess).Assembly.Location;\nvar raw = await NodeProcess.Run(CaptureControlNames.Dotnet, [assembly, CaptureControlNames.RawChild], Path.Combine(args[0], CaptureControlNames.Raw));\nif (raw.ExitCode != CaptureControlNames.RawExit || raw.TimedOut || !raw.RawComplete ||\n    !File.ReadAllBytes(Path.Combine(args[0], CaptureControlNames.Stdout)).SequenceEqual(CaptureControlNames.RawOutput) ||\n    !File.ReadAllBytes(Path.Combine(args[0], CaptureControlNames.Stderr)).SequenceEqual(CaptureControlNames.RawError))\n    throw new InvalidOperationException(CaptureControlNames.Failure);\nstring childFile = Path.Combine(args[0], CaptureControlNames.ChildFile);\nvar clock = Stopwatch.StartNew();\nNodeProcessResult pipes;\nbool terminated;\ntry\n{\n    pipes = await NodeProcess.Run(CaptureControlNames.Dotnet, [assembly, CaptureControlNames.SpawnHolder, childFile], Path.Combine(args[0], CaptureControlNames.Pipes));\n}\nfinally\n{\n    clock.Stop();\n    using var holder = Process.GetProcessById(int.Parse(await File.ReadAllTextAsync(childFile), CultureInfo.InvariantCulture));\n    holder.Kill(entireProcessTree: true);\n    await holder.WaitForExitAsync().WaitAsync(CaptureControlNames.ExitDeadline);\n    terminated = holder.HasExited;\n}\nif (pipes.ExitCode != 0 || pipes.TimedOut || pipes.RawComplete || clock.Elapsed > CaptureControlNames.CaptureDeadline || !terminated)\n    throw new InvalidOperationException(CaptureControlNames.Failure);\nConsole.WriteLine(JsonSerializer.Serialize(new { Status = CaptureControlNames.Pass, Raw = raw, InheritedPipes = pipes, Milliseconds = clock.ElapsedMilliseconds, OwnedChildTerminated = terminated }));\n\nreturn 0;\n"
    }
