Dir = "artifacts/beam-backend/part827-images",
Module = ssl_client_session_cache_db,
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Cache = Module:init([{role, client}]),
    client_ssl_otp_session_cache = ets:info(Cache, name),
    ordered_set = ets:info(Cache, type),
    protected = ets:info(Cache, protection),
    0 = Module:size(Cache),
    undefined = Module:lookup(Cache, missing),
    true = Module:update(Cache, {partial, first}, original),
    true = Module:update(Cache, {partial, first}, changed),
    true = Module:update(Cache, {partial, second}, another),
    true = Module:update(Cache, {other, first}, unrelated),
    changed = Module:lookup(Cache, {partial, first}),
    3 = Module:size(Cache),
    [another, changed] = lists:sort(Module:select_session(Cache, partial)),
    [] = Module:select_session(Cache, absent),
    Count = fun(_, N) -> N + 1 end,
    3 = Module:foldl(Count, 0, Cache),
    fallback = Module:foldl(fun(_, _) -> throw(fixture) end, fallback, Cache),
    true = Module:delete(Cache, {partial, second}),
    undefined = Module:lookup(Cache, {partial, second}),
    [changed] = Module:select_session(Cache, partial),
    2 = Module:size(Cache),
    true = Module:terminate(Cache),
    undefined = Module:lookup(Cache, {partial, first}),
    [] = Module:select_session(Cache, partial),
    10 = Module:foldl(Count, 10, Cache),
    ok
end,
Otp = Run(code:which(Module)),
Otp = Run(filename:join(Dir, atom_to_list(Module) ++ ".beam")),
erlang:display({Module, equal}),
halt().
