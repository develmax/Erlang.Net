M=beam_try_stack_slots, Normalize=fun({{bad,_}=Reason,K,O,{Mod,F,Arity,_}})->{Reason,K,O,{Mod,F,Arity}};(Other)->Other end, Run=fun(F,Args,Start,Work,First)->erase(),put(start,Start),put(work,Work),put(first,First),put(done,old_done),put(last,old_last), Result=try Normalize(apply(M,F,Args)) catch error:Reason->{outer_error,Reason} end, {Result,[get(K)||K<-[start,work,first,done,last]]} end, Pair=[input,{keep,1}], Triple=[input,{keep,2},{other,3}], Results=[Run(run,Pair,{ok,old_start},{ok,worked},first_val),Run(run,Pair,start_val,bad_work,first_val),Run(twice,Triple,{ok,one},{ok,two},first_val),Run(twice,Triple,bad_start,{ok,two},first_val),Run(twice,Triple,{ok,one},bad_work,first_val),Run(after_try,Triple,start_val,work_val,{ok,after_value}),Run(after_try,Triple,start_val,work_val,bad_after)],io:format("~0p~n",[Results]),halt().