A="artifacts/beam-backend/part742-images/asn1ct_rtt.beam", O=code:which(asn1ct_rtt), {ok,Beam}=file:read_file(A),{ok,Original}=file:read_file(O),true=(Beam=:=Original),{beam_file,_,_,_,_,AC}=beam_disasm:file(A),{beam_file,_,_,_,_,OC}=beam_disasm:file(O),true=(AC=:=OC), {ok,{_,[{_,D}]}}=beam_lib:chunks(O,["Dbgi"]), {_,_,{Fs,_}}=binary_to_term(D), FunForms=[F||F={function,_,_,_,_}<-Fs], Keys=fun(N)->{function,_,N,1,Cs}=lists:keyfind(N,3,FunForms), [erl_parse:normalise(P)||{clause,_,[P={tuple,_,_}],_,_}<-Cs] end, Assert=Keys(assert_defined), Dep=Keys(dependencies), Invalid=[bad,{ber,decode_integer},{ber,decode_integer,999},{ber,unknown,1},{unknown,decode_integer,2}], Expected=[asn1ct_rtt:dependencies(K)||K<-Dep++Invalid], Code=asn1ct_rtt:code(), {module,asn1ct_rtt}=code:load_binary(asn1ct_rtt,A,Beam), Expected=[asn1ct_rtt:dependencies(K)||K<-Dep++Invalid], Code=asn1ct_rtt:code(), true=lists:all(fun(K)->asn1ct_rtt:assert_defined(K)=:=ok end,Assert), true=lists:all(fun(K)->try asn1ct_rtt:assert_defined(K),false catch error:function_clause->true end end,Invalid), {function,_,_,_,Instructions}=lists:keyfind(dependencies,2,AC), io:format("bytes_equal=true~nsize=~p~nsha256=~s~ndependencies_instructions=~p~nassertion_keys=~p~ndependency_keys=~p~ninvalid_inputs=~p~ncode_equal=true~n",[byte_size(Beam),binary:encode_hex(crypto:hash(sha256,Beam)),length(Instructions),length(Assert),length(Dep),length(Invalid)]),halt().
