A="artifacts/beam-backend/part741-verified-images/asn1ct_rtt.beam", O=code:which(asn1ct_rtt), {beam_file,_,_,_,_,[X,Y|_]}=beam_disasm:file(A), {beam_file,_,_,_,_,[U,V|_]}=beam_disasm:file(O), true=(X=:=U), {ok,_,AC}=beam_lib:all_chunks(A),{ok,_,OC}=beam_lib:all_chunks(O), io:format("assert_defined_equal=true~nassert_instructions=~p~ndependencies_actual=~p~ndependencies_expected=~p~ndifferent_sections=~p~n",[length(element(5,X)),length(element(5,Y)),length(element(5,V)),[K||{K,B}<-OC,proplists:get_value(K,AC)=/=B]]), {_,_,{Forms,_}}=binary_to_term(proplists:get_value("Dbgi",OC)), {function,_,assert_defined,1,Clauses}=lists:keyfind(assert_defined,3,[F||F={function,_,_,_,_}<-Forms]), Keys=[erl_parse:normalise(P)||{clause,_,[P],_,_}<-Clauses], {ok,Beam}=file:read_file(A), {module,asn1ct_rtt}=code:load_binary(asn1ct_rtt,A,Beam), true=lists:all(fun(Key)->asn1ct_rtt:assert_defined(Key)=:=ok end,Keys), Reject=fun(K)->try asn1ct_rtt:assert_defined(K),false catch error:function_clause->true end end, true=lists:all(Reject,[bad,{ber,decode_integer},{ber,decode_integer,999},{ber,unknown,1},{unknown,decode_integer,2}]), io:format("accepted_keys=~p~nrejected_inputs=5~n",[length(Keys)]),halt().
