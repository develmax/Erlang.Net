[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, binding_liveness_probe} = code:load_binary(binding_liveness_probe, Path, Binary),
undefined = put(num,7),
{8,keep} = binding_liveness_probe:arithmetic(num,keep),
8 = get(observed),
{'EXIT',{badarith,_}} = (catch binding_liveness_probe:arithmetic(num,after_error)),
after_error = get(num),
8 = get(observed),
undefined = put(tuple_key,old),
{{old,kept},kept} = binding_liveness_probe:tuple_value(tuple_key,kept),
undefined = put(list_key,head),
{[head,tail],[tail]} = binding_liveness_probe:list_value(list_key,[tail]),
undefined = put(alias_key,9),
{9,10,kept} = binding_liveness_probe:alias_live(alias_key,kept),
10 = get(observed),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [Item]) || Item = {function, Name, _, _, _} <- Functions, Name =/= module_info],
halt().
