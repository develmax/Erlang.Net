diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedPairContinuations.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedPairContinuations.cs
