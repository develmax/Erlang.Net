diff --git a/tests/Erlang.Tests/Compiler/Beam/Calls/BeamSpilledResultLiteralMovesChecks.cs b/tests/Erlang.Tests/Compiler/Beam/Calls/BeamSpilledResultLiteralMovesChecks.cs
