+        private RequiredPairEnumeration? ReadRequiredPairEnumeration(
+            Expr expression,
+            string source,
+            IReadOnlySet<string> bindings
+        )
+        {
+            if (expression is not Expr.Case { Value: Expr.Variable tested, Clauses.Count: >= 3 } decision
