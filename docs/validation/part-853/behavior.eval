Dir = "artifacts/beam-backend/part853-images",
Module = beam_tuple_key_filter_probe,
Name = atom_to_list(Module) ++ ".beam",
Run = fun(File) ->
    code:purge(Module), code:delete(Module),
    {ok,Bytes} = file:read_file(File),
    {module,Module} = code:load_binary(Module,File,Bytes),
    [] = Module:filter([]),
    Expected = [{active,false},{deliver,term},{packet,4},{active,true}],
    Expected = Module:filter([{active,false},ignored,{active},{deliver,term},{other,0},
                             {packet,4},{packet,4,extra},{active,true}]),
    [try Module:filter(Input) of
         Value -> error({unexpected_result,Value})
     catch
         error:{bad_generator,tail}:Frames -> Frames
     end || Input <- [tail,[ignored|tail],[{active,false}|tail]]]
end,
Otp = Run(filename:join([Dir,"fixture","lib","probe","ebin",Name])),
Otp = Run(filename:join(Dir,Name)),
erlang:display({Module,equal}),
halt().
