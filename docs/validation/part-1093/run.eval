[Path] = init:get_plain_arguments(),
{ok, Binary} = file:read_file(Path),
{module, tuple_order_probe} = code:load_binary(tuple_order_probe, Path, Binary),
undefined = put(shared, old),
{old,first,keep} = tuple_order_probe:tuple(first,shared,shared,keep),
keep = put(shared,old),
{ordered,second_keep} = tuple_order_probe:select(second,shared,shared,second_keep),
{other,second_keep,third} = tuple_order_probe:select(third,shared,shared,third_keep),
{'EXIT',{{case_clause,{third_keep,fourth}},_}} = (catch tuple_order_probe:strict(fourth,shared,shared,fourth_keep)),
F = tuple_order_probe:closure(shared,shared),
{fourth_keep,fifth,fifth_keep} = F(fifth,fifth_keep),
fifth_keep = get(shared),
{yes,same} = tuple_order_probe:repeated(same,same),
no = tuple_order_probe:repeated(same,other),
no = tuple_order_probe:repeated(1,1),
{value,kept} = tuple_order_probe:exported(tag,kept),
{value,first} = tuple_order_probe:exported(first,second),
undefined = put(literal,old),
{ordered,lit_keep} = tuple_order_probe:literal(expected,literal,literal,lit_keep),
{'EXIT',{{case_clause,{lit_keep,wrong}},_}} = (catch tuple_order_probe:literal(wrong,literal,literal,next_keep)),
undefined = put(referenced,old),
{expected,ref_keep} = tuple_order_probe:referenced(expected,referenced,referenced,ref_keep),
undefined = put(recycle_key,old),
undefined = put(branch,initial),
{initial,recycled} = tuple_order_probe:recycle(expected,recycle_key,recycle_key,recycled),
initial = get(follow),
undefined = put(alias_key,alias_value),
{alias_value,recycled,kept_alias} = tuple_order_probe:keep_alias(expected,alias_key,alias_key,kept_alias),
recycled = get(follow),
{'EXIT',{{case_clause,{recycled,wrong}},_}} = (catch tuple_order_probe:recycle(wrong,recycle_key,recycle_key,failed)),
kept_alias = get(branch),
{beam_file, _, _, _, _, Functions} = beam_disasm:file(Path),
[io:format("~p~n", [Item]) || Item = {function, Name, _, _, _} <- Functions, Name =/= module_info],
halt().



