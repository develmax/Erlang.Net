[Image,Dir,Output]=init:get_plain_arguments(),
ok=file:make_dir(Dir),
{ok,Bytes}=file:read_file(Image),
{beam_file,M,_,_,_,_}=beam_disasm:file(Image),
{module,M}=code:load_binary(M,Image,Bytes),
Rows=case M of
 mnesia_backup ->
   File=filename:join(Dir,"backup.log"),
   Tmp=File++".BUPTMP",
   Missing=mnesia_backup:open_read(filename:join(Dir,"missing.log")),
   {ok,W={backup,Tmp,File,Wref}}=mnesia_backup:open_write(File),
   true=is_reference(Wref),
   Data=[{example,11},{example,{payload,2}}],
   {ok,W}=mnesia_backup:write(W,Data),
   {ok,File}=mnesia_backup:commit_write(W),
   {ok,R={restore,File,Rref,start}}=mnesia_backup:open_read(File),
   true=is_reference(Rref), true=(Wref=/=Rref),
   {ok,R2,Data}=mnesia_backup:read(R),
   {ok,R2,[]}=mnesia_backup:read(R2),
   {ok,File}=mnesia_backup:close_read(R2),
   Abort=filename:join(Dir,"abort.log"),
   {ok,A}=mnesia_backup:open_write(Abort),
   {ok,Abort}=mnesia_backup:abort_write(A),
   false=filelib:is_file(Abort++".BUPTMP"),
   {error,{file_error,BadPath,BadReason}}=mnesia_backup:open_write(filename:join([Dir,"missing_dir","blocked.log"])),
   [{read_missing,Missing},{round_trip,Data},{abort_removes_tmp,true},
    {write_missing_directory,{file_error,filename:basename(BadPath),BadReason}}];
 mnesia_dumper ->
   Empty=filename:join(Dir,"empty.log"),
   Name=make_ref(),
   {ok,Name}=disk_log:open([{name,Name},{file,Empty}]),
   ok=disk_log:close(Name),
   ok=mnesia_dumper:load_from_logfile(ram_copies,unused_table,Empty),
   Missing=filename:join([Dir,"missing_dir","empty.log"]),
   {error,{file_error,P,Reason}}=mnesia_dumper:load_from_logfile(ram_copies,unused_table,Missing),
   [{load_empty,ok},{load_missing_directory,{file_error,filename:basename(P),Reason}}]
end,
ok=file:write_file(Output,io_lib:format("~tp.~n",[{M,Rows}])),
halt().
