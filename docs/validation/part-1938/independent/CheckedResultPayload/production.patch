diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedCallResultPayload.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.CheckedCallResultPayload.cs
