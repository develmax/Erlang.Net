diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalHeaderListHeap.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.TerminalHeaderListHeap.cs
