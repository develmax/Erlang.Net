Path = "tests/Erlang.Tests/Resources/Beam/beam_multiple_tuple_fun_probe.erl",
{ok,beam_multiple_tuple_fun_probe,Expected} = compile:file(Path,[binary,deterministic]),
{ok,Expected} = file:read_file("artifacts/beam-backend/part759-probe.beam"),
{module,beam_multiple_tuple_fun_probe} = code:load_binary(beam_multiple_tuple_fun_probe,Path,Expected),
{First,Second,right} = beam_multiple_tuple_fun_probe:make(left,right),
right = First(),
left = Second(),
{SharedFirst,SharedSecond} = beam_multiple_tuple_fun_probe:shared(value),
{first,value} = SharedFirst(),
{second,value} = SharedSecond(),
{env,[value]} = erlang:fun_info(SharedFirst,env),
{env,[value]} = erlang:fun_info(SharedSecond,env),
{Recursive,Anonymous} = beam_multiple_tuple_fun_probe:mixed(mixed),
mixed = Recursive(2000),
mixed = Anonymous(),
io:format("whole_image_equal=true bytes=~p closures=6 shared_capture=true mixed_recursion=true~n",[byte_size(Expected)]),
halt().
