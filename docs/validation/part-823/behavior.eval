Dir = "artifacts/beam-backend/part823-images",
Run = fun(Module, File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    {ok, Normal} = Module:start_link(),
    {ok, Dist} = Module:start_link_dist(),
    Normal = whereis(Module),
    DistName = list_to_atom(atom_to_list(Module) ++ "_dist"),
    Dist = whereis(DistName),
    {ok, NP} = Module:start_child([self(), normal]),
    {ok, DP} = Module:start_child_dist([self(), dist]),
    receive {child, normal, Normal} -> ok after 1000 -> error(normal_timeout) end,
    receive {child, dist, Dist} -> ok after 1000 -> error(dist_timeout) end,
    true = is_pid(NP),
    true = is_pid(DP),
    ok = gen_server:stop(Normal),
    ok = gen_server:stop(Dist),
    Module:init([])
end,
lists:foreach(fun({Module, Child}) ->
    code:purge(Child),
    code:delete(Child),
    Path = filename:join(Dir, atom_to_list(Child) ++ ".erl"),
    Source = io_lib:format("-module(~p).~n-export([start_link/2]).~nstart_link(Caller, Kind) -> Caller ! {child, Kind, self()}, {ok, spawn_link(fun() -> receive stop -> ok end end)}.~n", [Child]),
    ok = file:write_file(Path, Source),
    {ok, Child, Stub} = compile:file(Path, [binary]),
    {module, Child} = code:load_binary(Child, Path, Stub),
    Otp = Run(Module, code:which(Module)),
    Otp = Run(Module, filename:join(Dir, atom_to_list(Module) ++ ".beam")),
    erlang:display({Module, equal})
end, [{ssl_listen_tracker_sup, tls_socket}, {tls_server_session_ticket_sup, tls_server_session_ticket}]),
halt().
