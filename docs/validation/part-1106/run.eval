[P,Q]=init:get_plain_arguments(),
Read=fun(Path)->
    {beam_file,_,_,_,_,Fs}=beam_disasm:file(Path),
    [{N,Is} || {function,N,1,_,Is}<-Fs,N=:=run orelse N=:=loop]
end,
Expected=Read(P),
io:format("OTP: ~p~nC#: ~p~n",[Expected,Read(Q)]),
Expected=Read(Q),
lists:foreach(fun(Path)->
    {ok,B}=file:read_file(Path),
    {module,M}=code:load_binary(beam_cons_call_match_probe,Path,B),
    ok=M:run([true,true]),
    ok=M:loop([]),
    {error,{badmatch,wrong}}=try M:run([wrong]) of V->{value,V} catch error:R->{error,R} end,
    {error,function_clause}=try M:loop([true|bad]) of V2->{value,V2} catch error:R2->{error,R2} end,
    code:purge(M),
    code:delete(M)
end,[P,Q]),
halt().
