M=beam_bit_match_slots, Run=fun(F,Args,Snapshot) -> erase(),put(first,Snapshot),put(next,previous), Result=apply(M,F,Args), {Result,get(first),get(next)} end, Args=[<<100>>,keep], Results=[Run(fixed,Args,<<1,42,3>>),Run(fixed,Args,<<1,43,3>>),Run(fixed,Args,<<1,42>>),Run(split,[<<100>>,2,keep],<<1,2,3>>),Run(split,[<<100>>,4,keep],<<1,2,3>>),Run(split,[<<100>>,-1,keep],<<1,2,3>>),Run(signed,[<<100>>,8,keep],<<255,17>>),Run(signed,[<<100>>,8,keep],<<255>>)],io:format("~0p~n",[Results]),halt().