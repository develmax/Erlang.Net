Dir = "artifacts/beam-backend/part833-images",
Module = beam_socket_option_read_probe,
Stub = beam_option_transport,
Path = filename:join(Dir, atom_to_list(Stub) ++ ".erl"),
Source = "-module(beam_option_transport).\n-export([split_options/2,get_sock_opts/2,getopts/2,listener_stats/2,socket_stats/2,getstat/2]).\nsplit_options(T,O) -> {split,T,O}.\nget_sock_opts(L,O) -> {listener,L,O}.\ngetopts(S,O) -> {options,S,O}.\nlistener_stats(S,O) -> {listener_stats,S,O}.\nsocket_stats(S,O) -> {socket_stats,S,O}.\ngetstat(S,O) -> {dynamic_stats,S,O}.\n",
ok = file:write_file(Path, Source),
{ok, Stub, StubBytes} = compile:file(Path, [binary]),
{module, Stub} = code:load_binary(Stub, Path, StubBytes),
Run = fun(File) ->
    code:purge(Module),
    code:delete(Module),
    {ok, Bytes} = file:read_file(File),
    {module, Module} = code:load_binary(Module, File, Bytes),
    Pid = self(),
    Opts = [active],
    {listener,Pid,{split,gen_udp,Opts}} = Module:getopts(Stub,{socket,{Pid,ignored},{config,[]}},Opts),
    {options,raw,Opts} = Module:getopts(gen_udp,{ignored,{{host,4433},raw}},Opts),
    {options,raw,Opts} = Module:getopts(gen_udp,{ignored,raw},Opts),
    {options,{bad_address,raw},Opts} = Module:getopts(gen_udp,{ignored,{bad_address,raw}},Opts),
    {options,raw,Opts} = Module:getopts(Stub,raw,Opts),
    {listener_stats,Pid,Opts} = Module:getstat(gen_udp,Pid,Opts),
    {socket_stats,raw,Opts} = Module:getstat(gen_udp,{ignored,{address,raw}},Opts),
    {socket_stats,raw,Opts} = Module:getstat(gen_udp,{ignored,raw},Opts),
    {socket_stats,raw,Opts} = Module:getstat(gen_udp,raw,Opts),
    {dynamic_stats,raw,Opts} = Module:getstat(Stub,raw,Opts),
    try Module:getopts(nonexistent_fixture_transport,raw,Opts) catch error:undef:Stack -> Stack end
end,
Name = atom_to_list(Module) ++ ".beam",
Otp = Run(filename:join([Dir, "fixture", "lib", "probe", "ebin", Name])),
[{nonexistent_fixture_transport,getopts,_,_}|_] = Otp,
Otp = Run(filename:join(Dir, Name)),
erlang:display({Module, equal}),
halt().
