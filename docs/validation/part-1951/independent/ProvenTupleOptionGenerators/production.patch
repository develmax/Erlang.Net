diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ProvenTupleOptionGenerator.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ProvenTupleOptionGenerator.cs
