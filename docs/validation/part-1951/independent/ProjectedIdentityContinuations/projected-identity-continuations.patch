diff --git a/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ProjectedIdentityContinuations.cs b/src/Compiler/Erlang.Compiler/Compilation/BeamModuleCompiler.ProjectedIdentityContinuations.cs
