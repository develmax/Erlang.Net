<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Development/Erlang.Otp.Parsetools.Beam/Erlang.Otp.Parsetools.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Development/Erlang.Otp.SyntaxTools.Beam/Erlang.Otp.SyntaxTools.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Parsetools.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.SyntaxTools.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Syntax.Library.Tests.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>