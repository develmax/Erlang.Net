<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Otp/Original/Platform/Erlang.Otp.OsMon.Beam/Erlang.Otp.OsMon.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Platform/Erlang.Otp.Odbc.Beam/Erlang.Otp.Odbc.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.OsMon.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Odbc.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Platform.Library.Tests.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/ApplyLegacy477/*" LogicalName="Erlang.Otp.Platform.Library.Tests.Legacy.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
