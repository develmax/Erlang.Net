<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Ssl.Beam/Erlang.Otp.Ssl.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Ssh.Beam/Erlang.Otp.Ssh.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Ssl.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Ssh.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Transport.Library.Tests.%(Filename)%(Extension)" />
  </ItemGroup>
<ItemGroup><EmbeddedResource Include="Fixtures/Frame481/*" LogicalName="Erlang.Otp.Transport.Library.Tests.Frame481.%(Filename)%(Extension)" /></ItemGroup>
</Project>
