<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Otp/Original/Networking/Erlang.Otp.Tftp.Beam/Erlang.Otp.Tftp.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Networking/Erlang.Otp.Eldap.Beam/Erlang.Otp.Eldap.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Foundation/Erlang.Otp.Kernel.Beam/Erlang.Otp.Kernel.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Networking/Erlang.Otp.Inets.Beam/Erlang.Otp.Inets.Beam.csproj" />
    <ProjectReference Include="../../src/Otp/Original/Networking/Erlang.Otp.Ftp.Beam/Erlang.Otp.Ftp.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Tftp.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Eldap.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Kernel.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Inets.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Ftp.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Network.Library.Tests.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
