<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Erlang.Otp.Kernel.Beam/Erlang.Otp.Kernel.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Kernel.Beam" Version="0.1.0" />
  </ItemGroup>
</Project>
