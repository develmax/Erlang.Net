<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Asn1.Beam/Erlang.Otp.Asn1.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Asn1.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Asn1.Library.Tests.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
