<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Erlang.Otp.Debugger.Beam/Erlang.Otp.Debugger.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Et.Beam/Erlang.Otp.Et.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Observer.Beam/Erlang.Otp.Observer.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Reltool.Beam/Erlang.Otp.Reltool.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Wx.Beam/Erlang.Otp.Wx.Beam.csproj" />
    <ProjectReference Include="../../src/Erlang.Otp.Stdlib.Beam/Erlang.Otp.Stdlib.Beam.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Otp.Debugger.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Et.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Observer.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Reltool.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Wx.Beam" Version="0.1.0" />
    <PackageReference Include="Erlang.Otp.Stdlib.Beam" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/FloatStore479/*" LogicalName="Erlang.Otp.Gui.Library.Tests.FloatStore479.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/*" LogicalName="Erlang.Otp.Gui.Library.Tests.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
