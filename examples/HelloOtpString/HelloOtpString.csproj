<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
    <StringBackend Condition="'$(StringBackend)' == ''">Managed</StringBackend>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../../src/Runtime/Erlang.Runtime/Erlang.Runtime.csproj" />
    <ProjectReference Include="../../tools/Build/Erlang.BeamBuild/Erlang.BeamBuild.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Net.CSharp" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ErlangLibrary Include="erlang" Backend="Managed" />
    <ErlangLibrary Include="lists" Backend="Managed" />
    <ErlangLibrary Include="unicode" Backend="Beam" Image="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Otp/unicode.beam" Sha256="2495812294976A34AE904E7709B75348F3DDDF3B950413199867A78E093A4379" Dependencies="lists;unicode_util" />
    <ErlangLibrary Include="unicode_util" Backend="Beam" Image="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Otp/unicode_util.beam" Sha256="5CDC886E30216B5DE33B6F4BDC1DEA006EAA3392EC4A83EC90CD7B946B5759FF" Dependencies="lists" />
    <ErlangLibrary Include="string" Backend="Managed" Dependencies="erlang;lists;unicode;unicode_util" Condition="'$(StringBackend)' == 'Managed'" />
    <ErlangLibrary Include="string" Backend="Beam" Image="../../src/Otp/Original/Foundation/Erlang.Otp.Stdlib.Beam/Otp/string.beam" Sha256="37C66C6A5DF38AE239CA1EEDEDBD2CE2FBC4B8B4F3EB7605E115D0AB73FDA697" Dependencies="erlang;lists;unicode;unicode_util" Condition="'$(StringBackend)' == 'Beam'" />
  </ItemGroup>
  <Import Project="../../build/Erlang.Net.targets" Condition="'$(UseInstalledPackage)' != 'true'" />
  <Target Name="ValidateStringBackend" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(StringBackend)' != 'Managed' and '$(StringBackend)' != 'Beam'" Text="StringBackend must be Managed or Beam." />
  </Target>
</Project>
