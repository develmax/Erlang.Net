<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>Erlang.Runtime</AssemblyName><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Erlang.Terms/Erlang.Terms.csproj" />
    <ProjectReference Include="../Erlang.Serialization/Erlang.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="runtimes/win-x64/native/Erlang.Nif.WindowsVariadic.dll"
          Condition="Exists('runtimes/win-x64/native/Erlang.Nif.WindowsVariadic.dll')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="Erlang.Nif.WindowsVariadic.dll" Pack="true" PackagePath="runtimes/win-x64/native/Erlang.Nif.WindowsVariadic.dll" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Otp/Original/Foundation/Erlang.Otp.Erts.Beam/Otp/ebin/erlang.beam" LogicalName="Erlang.Runtime.PinnedOtp.erlang.beam" />
    <EmbeddedResource Include="../../Otp/Original/Foundation/Erlang.Otp.Erts.Beam/Otp/src/erlang.erl" LogicalName="Erlang.Runtime.PinnedOtp.erlang.erl" />
    <EmbeddedResource Include="../../Otp/Original/Foundation/Erlang.Otp.Erts.Beam/provenance.json" LogicalName="Erlang.Runtime.PinnedOtp.erlang.provenance.json" />
    <EmbeddedResource Include="../../Otp/Original/Foundation/Erlang.Otp.Erts.Beam/Otp/ebin/erts_internal.beam" LogicalName="Erlang.Runtime.PinnedOtp.erts_internal.beam" />
    <EmbeddedResource Include="../../Otp/Original/Foundation/Erlang.Otp.Erts.Beam/Otp/src/erts_internal.erl" LogicalName="Erlang.Runtime.PinnedOtp.erts_internal.erl" />
  </ItemGroup>
  <Target Name="RequireWindowsNifVariadicAsset526" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('runtimes/win-x64/native/Erlang.Nif.WindowsVariadic.dll')"
           Text="Build/install the Windows NIF variadic runtime asset before packaging Erlang.Runtime.Core." />
  </Target>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX'))">
    <PosixFileExtension>.so</PosixFileExtension>
    <PosixFileLinkFlag>-shared</PosixFileLinkFlag>
    <PosixFileExtension Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</PosixFileExtension>
    <PosixFileLinkFlag Condition="$([MSBuild]::IsOSPlatform('OSX'))">-dynamiclib</PosixFileLinkFlag>
    <PosixFileSource>$(MSBuildProjectDirectory)/../../../tools/Native/Erlang.FileSystem.Native</PosixFileSource>
    <PosixFileOutput>$(BaseIntermediateOutputPath)$(Configuration)/native/libErlang.FileSystem.Native$(PosixFileExtension)</PosixFileOutput>
  </PropertyGroup>
  <ItemGroup Condition="'$(PosixFileExtension)' != ''">
    <Content Include="$(PosixFileOutput)" Link="libErlang.FileSystem.Native$(PosixFileExtension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildPosixFileBoundary" BeforeTargets="CoreCompile;GetCopyToOutputDirectoryItems" Condition="'$(PosixFileExtension)' != ''" Inputs="$(PosixFileSource)/filesystem.c;$(PosixFileSource)/filesystem.h" Outputs="$(PosixFileOutput)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PosixFileOutput)'))" />
    <Exec Command="cc -std=c11 -O2 -fPIC -Wall -Wextra -Werror $(PosixFileLinkFlag) &quot;$(PosixFileSource)/filesystem.c&quot; -o &quot;$(PosixFileOutput)&quot;" />
  </Target>
</Project>
