<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
    <Description>Pinned original OTP diameter images and application resources for Erlang.Net.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>OTP-LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../Erlang.Runtime/Erlang.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Net.CSharp" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Otp/ebin/*" LogicalName="Erlang.Otp.Diameter.Beam.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Otp/bin/diameterc" LogicalName="Erlang.Otp.Diameter.Beam.support/bin/diameterc" />
    <None Remove="Otp/mibs/**/*" />
    <None Include="Otp/mibs/**/*" Pack="true" PackagePath="otp/mibs/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Otp/priv/**/*" />
    <None Include="Otp/priv/**/*" Pack="true" PackagePath="otp/priv/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Otp/bin/**/*" />
    <None Include="Otp/bin/**/*" Pack="true" PackagePath="otp/bin/%(RecursiveDir)" />
    <EmbeddedResource Include="catalog.json" LogicalName="Erlang.Otp.Diameter.Beam.catalog.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/OTP-LICENSE.txt" Pack="true" PackagePath="/" />
    <None Remove="Otp/src/**/*" />
    <None Include="Otp/src/**/*" Pack="true" PackagePath="otp/src/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Otp/include/**/*" />
    <None Include="Otp/include/**/*" Pack="true" PackagePath="otp/include/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Otp/asn1/**/*" />
    <None Include="Otp/asn1/**/*" Pack="true" PackagePath="otp/asn1/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Update="Otp/ebin/*.hrl" Pack="true" PackagePath="otp/ebin/%(Filename)%(Extension)" />
    <None Update="provenance.json;catalog.json" Pack="true" PackagePath="otp/" />
  </ItemGroup>
</Project>
