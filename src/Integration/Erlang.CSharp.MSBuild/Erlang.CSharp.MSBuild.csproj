<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><PackageId>Erlang.Net.CSharp</PackageId><Version>0.1.0</Version><Description>Experimental C#-native Erlang runtime, compiler and MSBuild preprocessor.</Description><IncludeBuildOutput>false</IncludeBuildOutput><PackageReadmeFile>README.md</PackageReadmeFile></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../tools/Build/Erlang.Tool/Erlang.Tool.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../../tools/Build/Erlang.BeamBuild/Erlang.BeamBuild.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Otp/Managed/Erlang.Otp.Behaviours/Erlang.Otp.Behaviours.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Runtime/Erlang.Serialization/Erlang.Serialization.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/ROSLYN-LICENSE.txt;../../../docs/DOTNET-LICENSE.txt;../../../docs/DOTNET-ThirdPartyNotices.txt;../../../docs/OTP-LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../../docs/OTP-PORTS.md" Pack="true" PackagePath="licenses/" />
    <None Include="../../../build/Erlang.Net.targets" Pack="true" PackagePath="buildTransitive/Erlang.Net.CSharp.targets" />
    <None Include="../../../build/Erlang.Beam.targets" Pack="true" PackagePath="buildTransitive/Erlang.Beam.targets" />
    <None Include="../../../build/Erlang.Beam.Application.targets" Pack="true" PackagePath="buildTransitive/Erlang.Beam.Application.targets" />
    <None Include="../../../build/Erlang.Beam.Source.targets" Pack="true" PackagePath="buildTransitive/Erlang.Beam.Source.targets" />
    <None Include="../../../build/Erlang.Library.targets" Pack="true" PackagePath="buildTransitive/Erlang.Library.targets" />
    <None Include="../../../tools/Build/Erlang.Tool/bin/$(Configuration)/net10.0/*.dll;../../../tools/Build/Erlang.Tool/bin/$(Configuration)/net10.0/*.json" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="../../Runtime/Erlang.Terms/bin/$(Configuration)/net10.0/Erlang.Terms.dll;../../Runtime/Erlang.Runtime/bin/$(Configuration)/net10.0/Erlang.Runtime.dll;../../Runtime/Erlang.Runtime/bin/$(Configuration)/net10.0/Erlang.Runtime.Bundle.dll;../../Otp/Managed/Erlang.Otp.Stdlib/bin/$(Configuration)/net10.0/Erlang.Otp.Stdlib.dll;../../Otp/Managed/Erlang.Otp.Kernel/bin/$(Configuration)/net10.0/Erlang.Otp.Kernel.dll;../../Compiler/Erlang.Compiler/bin/$(Configuration)/net10.0/Erlang.Compiler.dll;../../Otp/Managed/Erlang.Otp.Behaviours/bin/$(Configuration)/net10.0/Erlang.Otp.Behaviours.dll;../../Runtime/Erlang.Serialization/bin/$(Configuration)/net10.0/Erlang.Serialization.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>
  <!-- Evaluate generated tool files after Build, including the first pack on a clean checkout. -->
  <Target Name="CollectBeamBuildPackageFiles" BeforeTargets="_GetPackageFiles">
    <Error Condition="!Exists('../../../tools/Build/Erlang.BeamBuild/bin/$(Configuration)/net10.0/Erlang.BeamBuild.dll') or !Exists('../../../tools/Build/Erlang.BeamBuild/bin/$(Configuration)/net10.0/Erlang.BeamBuild.runtimeconfig.json')" Text="Build Erlang.BeamBuild before packing the source compiler integration." />
    <ItemGroup>
      <None Include="../../../tools/Build/Erlang.BeamBuild/bin/$(Configuration)/net10.0/*.dll;../../../tools/Build/Erlang.BeamBuild/bin/$(Configuration)/net10.0/*.json" Pack="true" PackagePath="tools/beam/net10.0/" />
    </ItemGroup>
  </Target>
</Project>
