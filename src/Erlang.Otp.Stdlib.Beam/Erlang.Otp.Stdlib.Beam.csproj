<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <ErlangPreprocessEnabled>false</ErlangPreprocessEnabled>
    <Description>Pinned original OTP stdlib images for the Erlang.Net runtime.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>OTP-LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' != 'true'">
    <ProjectReference Include="../Erlang.Runtime/Erlang.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstalledPackage)' == 'true'">
    <PackageReference Include="Erlang.Net.CSharp" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Otp/*.beam" LogicalName="Erlang.Otp.Stdlib.Beam.%(Filename)%(Extension)" />
    <EmbeddedResource Include="catalog.json" LogicalName="Erlang.Otp.Stdlib.Beam.catalog.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/OTP-LICENSE.txt" Pack="true" PackagePath="/" />
    <None Update="Otp/*.erl;Otp/*.json;catalog.json" Pack="true" PackagePath="otp/%(Filename)%(Extension)" />
    <None Update="Variants/BackendSelection/*" Pack="true" PackagePath="otp/variants/backend-selection/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
