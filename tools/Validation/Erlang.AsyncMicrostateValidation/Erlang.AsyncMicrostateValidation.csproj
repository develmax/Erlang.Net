<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Erlang.AsyncMicrostateValidation</AssemblyName><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Erlang.Runtime"><HintPath>$(ReviewedPackageRoot)/Erlang.Runtime.dll</HintPath></Reference>
    <Reference Include="Erlang.Terms"><HintPath>$(ReviewedPackageRoot)/Erlang.Terms.dll</HintPath></Reference>
    <Reference Include="Erlang.Serialization"><HintPath>$(ReviewedPackageRoot)/Erlang.Serialization.dll</HintPath></Reference>
    <Reference Include="Erlang.Otp.Stdlib"><HintPath>$(ReviewedPackageRoot)/Erlang.Otp.Stdlib.dll</HintPath></Reference>
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Native/Resources/NativeResource524Access.cs" Link="Existing/NativeResource524Access.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Native/Resources/NativeResource524Names.cs" Link="Existing/NativeResource524Names.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Native/Resources/NativeResource524ImageOwner.cs" Link="Existing/NativeResource524ImageOwner.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Native/Resources/NativeResource536Access.cs" Link="Existing/NativeResource536Access.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Native/Resources/NativeResource536TestNames.cs" Link="Existing/NativeResource536TestNames.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/PreparedBeamFixtureScope171.cs" Link="Existing/PreparedBeamFixtureScope171.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Execution/RuntimeNodeFoundationHostActor.cs" Link="Existing/RuntimeNodeFoundationHostActor.cs" />
    <Compile Include="$(RepositoryRoot)/tests/Erlang.Tests/Runtime/Execution/RuntimeNodeFoundationHostActorParameters.cs" Link="Existing/RuntimeNodeFoundationHostActorParameters.cs" />
  </ItemGroup>
  <Target Name="RequireReviewedInputs" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ReviewedPackageRoot)'=='' Or !Exists('$(ReviewedPackageRoot)/erldrv-host-package.json') Or !Exists('$(ReviewedPackageRoot)/Erlang.Runtime.dll')" Text="Actual existing catalog-created DriverHost package required; no fallback runtime/bridge build." />
  </Target>
</Project>
