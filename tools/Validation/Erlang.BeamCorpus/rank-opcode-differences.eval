[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Opcode = fun
    ({test, Name, _, _}) -> {test, Name};
    ({bif, Name, _, _, _}) -> {bif, Name};
    ({gc_bif, Name, _, _, _, _}) -> {gc_bif, Name};
    (Instruction) when is_atom(Instruction) -> Instruction;
    (Instruction) -> element(1, Instruction)
end,
Functions = fun(Disassembly) ->
    maps:from_list([{{Name, Arity}, Instructions}
        || {function, Name, Arity, _, Instructions} <- Disassembly])
end,
WithoutMetadata = fun(Instructions) ->
    [I || I <- Instructions, Op <- [Opcode(I)], Op =/= label, Op =/= line, Op =/= func_info]
end,
%% A first move/init_yregs mismatch is often caused by different frame sizes.
%% Keep those cases separate from differences with the same allocation.
FirstDifference = fun(ReferenceOps, GeneratedOps) ->
    Find = fun
        Loop([Left | RestLeft], [Right | RestRight], Previous) ->
            case {Opcode(Left), Opcode(Right)} of
                {Op, Op} -> Loop(RestLeft, RestRight, {Left, Right});
                {move, init_yregs} ->
                    case Previous of
                        {{allocate, Size, Live}, {allocate, Size, Live}} ->
                            {move, init_yregs, equal_allocation};
                        {{allocate, _, _}, {allocate, _, _}} ->
                            {move, init_yregs, different_allocation};
                        _ ->
                            {move, init_yregs, other_context}
                    end;
                Pair -> Pair
            end;
        Loop([], [], _) -> same;
        Loop([], [Right | _], _) -> {instruction_end, Opcode(Right)};
        Loop([Left | _], [], _) -> {Opcode(Left), instruction_end}
    end,
    Find(ReferenceOps, GeneratedOps, none)
end,
%% Keep operand differences separate from opcode differences. A function may
%% have a mismatched allocation and still have the same opcode sequence.
Direction = fun(Expected, Actual) when Expected < Actual -> excess;
               (Expected, Actual) when Expected > Actual -> insufficient;
               (_, _) -> equal
end,
NormalizeLabels = fun(Instructions) ->
    Labels = [Label || {label, Label} <- Instructions],
    Numbered = maps:from_list(lists:zip(Labels, lists:seq(1, length(Labels)))),
    Normalize = fun
        Term({label, Label}) -> {label, maps:get(Label, Numbered)};
        Term({f, Label}) -> {f, maps:get(Label, Numbered, Label)};
        Term({literal, _} = Literal) -> Literal;
        Term({make_fun3, Module, Index, _, Destination, Arguments}) ->
            {make_fun3, Module, Index, uniq, Term(Destination), Term(Arguments)};
        Term(Tuple) when is_tuple(Tuple) -> list_to_tuple(Term(tuple_to_list(Tuple)));
        Term([Head | Tail]) -> [Term(Head) | Term(Tail)];
        Term(Value) -> Value
    end,
    Normalize(Instructions)
end,
AllocationDifference = fun(ReferenceOps, GeneratedOps) ->
    Find = fun
        Loop([Instruction | Left], [Instruction | Right]) ->
            Loop(Left, Right);
        Loop([{allocate, ExpectedSlots, ExpectedLive} | _],
             [{allocate, ActualSlots, ActualLive} | _]) ->
            {allocate, {frame, Direction(ExpectedSlots, ActualSlots)},
                {live, Direction(ExpectedLive, ActualLive)}};
        Loop([{allocate_heap, ExpectedSlots, ExpectedHeap, ExpectedLive} | _],
             [{allocate_heap, ActualSlots, ActualHeap, ActualLive} | _]) ->
            Heap = case ExpectedHeap =:= ActualHeap of true -> equal; false -> different end,
            {allocate_heap, {frame, Direction(ExpectedSlots, ActualSlots)},
                {heap, Heap}, {live, Direction(ExpectedLive, ActualLive)}};
        Loop(_, _) -> same
    end,
    Find(NormalizeLabels(ReferenceOps), NormalizeLabels(GeneratedOps))
end,
AddExample = fun(Path, Function, Modules) ->
    maps:update_with(Path, fun(Example) -> min(Example, Function) end, Function, Modules)
end,
Add = fun(Difference, Path, Function, Groups) ->
    maps:update_with(Difference,
        fun(Modules) -> AddExample(Path, Function, Modules) end,
        #{Path => Function}, Groups)
end,
Files = filelib:fold_files(Generated, "[.]beam$", true, fun(Path, Acc) -> [Path | Acc] end, []),
{Groups, AllocationGroups, Unreadable, SameOpcodes} = lists:foldl(fun(Path, {Acc, Allocations, Errors, Same}) ->
    Relative = lists:nthtail(length(filename:split(Generated)), filename:split(Path)),
    Original = filename:join([Reference | Relative]),
    Name = filename:join(Relative),
    case {catch beam_disasm:file(Original), catch beam_disasm:file(Path)} of
        {{beam_file, Module, _, _, _, Left}, {beam_file, Module, _, _, _, Right}} ->
            Expected = Functions(Left),
            Actual = Functions(Right),
            Differences = [{Function, case maps:find(Function, Actual) of
                {ok, Ops} -> FirstDifference(WithoutMetadata(ReferenceOps), WithoutMetadata(Ops));
                error -> missing_function
            end} || {Function, ReferenceOps} <- maps:to_list(Expected)]
                ++ [{Function, extra_function} || Function <- maps:keys(Actual), not maps:is_key(Function, Expected)],
            Changes = [{Function, Difference} || {Function, Difference} <- Differences, Difference =/= same],
            Updated = lists:foldl(fun({Function, Difference}, Current) ->
                Add(Difference, Name, Function, Current)
            end, Acc, Changes),
            AllocationChanges = maps:fold(fun(Function, ReferenceOps, Current) ->
                case AllocationDifference(ReferenceOps, maps:get(Function, Actual, [])) of
                    same -> Current;
                    Difference -> maps:update_with(Difference,
                        fun({Count, Modules}) -> {Count + 1, AddExample(Name, Function, Modules)} end,
                        {1, #{Name => Function}}, Current)
                end
            end, Allocations, Expected),
            {Updated, AllocationChanges, Errors, Same + case Changes of [] -> 1; _ -> 0 end};
        _ ->
            {Acc, Allocations, [Name | Errors], Same}
    end
end, {#{}, #{}, [], 0}, Files),
Ranked = lists:reverse(lists:sort([{map_size(Modules), Difference,
    lists:sublist(lists:sort(maps:to_list(Modules)), 3)} || {Difference, Modules} <- maps:to_list(Groups)])),
io:format("Different images: ~p~nSame opcode sequences: ~p~nUnreadable images: ~p~n",
    [length(Files), SameOpcodes, lists:sort(Unreadable)]),
Top = lists:sublist(Ranked, 30),
FrameDetails = [Row || {_, {move, init_yregs, _}, _}=Row <- Ranked,
    not lists:member(Row, Top)],
lists:foreach(fun({Count, Difference, Examples}) ->
    io:format("~w ~w ~p~n", [Count, Difference, Examples])
end, Top ++ FrameDetails),
io:format("First differing instruction operands at allocation after label normalization:~n"),
AllocationRows = lists:reverse(lists:sort([
    {map_size(Modules), FunctionCount, Difference, lists:sublist(lists:sort(maps:to_list(Modules)), 3)}
    || {Difference, {FunctionCount, Modules}} <- maps:to_list(AllocationGroups)])),
lists:foreach(fun({ModuleCount, FunctionCount, Difference, Examples}) ->
    io:format("~B modules, ~B functions ~w ~p~n", [ModuleCount, FunctionCount, Difference, Examples])
end, AllocationRows),
halt().
