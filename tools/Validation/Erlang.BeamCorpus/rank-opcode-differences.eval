[Reference, Generated] = [filename:absname(Path) || Path <- init:get_plain_arguments()],
Opcode = fun
    ({test, Name, _, _}) -> {test, Name};
    ({bif, Name, _, _, _}) -> {bif, Name};
    ({gc_bif, Name, _, _, _, _}) -> {gc_bif, Name};
    (Instruction) when is_atom(Instruction) -> Instruction;
    (Instruction) -> element(1, Instruction)
end,
Functions = fun(Disassembly) ->
    maps:from_list([{{Name, Arity}, [I || I <- Instructions,
        Op <- [Opcode(I)], Op =/= label, Op =/= line, Op =/= func_info]}
        || {function, Name, Arity, _, Instructions} <- Disassembly])
end,
%% A first move/init_yregs mismatch is often caused by different frame sizes.
%% Keep those cases separate from differences with the same allocation.
FirstDifference = fun(Reference, Generated) ->
    Find = fun
        Loop([Left | RestLeft], [Right | RestRight], Previous) ->
            case {Opcode(Left), Opcode(Right)} of
                {Op, Op} -> Loop(RestLeft, RestRight, {Left, Right});
                {move, init_yregs} ->
                    case Previous of
                        {{allocate, Size, Live}, {allocate, Size, Live}} ->
                            {move, init_yregs, equal_allocation};
                        {{allocate, _, _}, {allocate, _, _}} ->
                            {move, init_yregs, different_allocation};
                        _ ->
                            {move, init_yregs, other_context}
                    end;
                Pair -> Pair
            end;
        Loop([], [], _) -> same;
        Loop([], [Right | _], _) -> {instruction_end, Opcode(Right)};
        Loop([Left | _], [], _) -> {Opcode(Left), instruction_end}
    end,
    Find(Reference, Generated, none)
end,
Add = fun(Difference, Path, Function, Groups) ->
    maps:update_with(Difference,
        fun(Modules) -> maps:update_with(Path, fun(Example) -> min(Example, Function) end, Function, Modules) end,
        #{Path => Function}, Groups)
end,
Files = filelib:fold_files(Generated, "[.]beam$", true, fun(Path, Acc) -> [Path | Acc] end, []),
{Groups, Unreadable, SameOpcodes} = lists:foldl(fun(Path, {Acc, Errors, Same}) ->
    Relative = lists:nthtail(length(filename:split(Generated)), filename:split(Path)),
    Original = filename:join([Reference | Relative]),
    Name = filename:join(Relative),
    case {catch beam_disasm:file(Original), catch beam_disasm:file(Path)} of
        {{beam_file, Module, _, _, _, Left}, {beam_file, Module, _, _, _, Right}} ->
            Expected = Functions(Left),
            Actual = Functions(Right),
            Differences = [{Function, case maps:find(Function, Actual) of
                {ok, Ops} -> FirstDifference(ReferenceOps, Ops);
                error -> missing_function
            end} || {Function, ReferenceOps} <- maps:to_list(Expected)]
                ++ [{Function, extra_function} || Function <- maps:keys(Actual), not maps:is_key(Function, Expected)],
            Changes = [{Function, Difference} || {Function, Difference} <- Differences, Difference =/= same],
            Updated = lists:foldl(fun({Function, Difference}, Current) ->
                Add(Difference, Name, Function, Current)
            end, Acc, Changes),
            {Updated, Errors, Same + case Changes of [] -> 1; _ -> 0 end};
        _ ->
            {Acc, [Name | Errors], Same}
    end
end, {#{}, [], 0}, Files),
Ranked = lists:reverse(lists:sort([{map_size(Modules), Difference,
    lists:sublist(lists:sort(maps:to_list(Modules)), 3)} || {Difference, Modules} <- maps:to_list(Groups)])),
io:format("Different images: ~p~nSame opcode sequences: ~p~nUnreadable images: ~p~n",
    [length(Files), SameOpcodes, lists:sort(Unreadable)]),
Top = lists:sublist(Ranked, 30),
FrameDetails = [Row || {_, {move, init_yregs, _}, _}=Row <- Ranked,
    not lists:member(Row, Top)],
lists:foreach(fun({Count, Difference, Examples}) ->
    io:format("~w ~w ~p~n", [Count, Difference, Examples])
end, Top ++ FrameDetails),
halt().
