<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Erlang.AsyncMicrostateValidation</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit>
    <EngineVersion Condition="'$(EngineVersion)'==''">green1558</EngineVersion>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</RepositoryRoot>
    <RuntimeReferenceDirectory Condition="'$(RuntimeReferenceDirectory)'==''">artifacts/poll-final1589/bin/$(Configuration)</RuntimeReferenceDirectory>
    <ResolvedRuntimeReferenceDirectory>$([System.IO.Path]::GetFullPath('$(RuntimeReferenceDirectory)', '$(RepositoryRoot)'))</ResolvedRuntimeReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Erlang.Runtime">
      <HintPath>$(ResolvedRuntimeReferenceDirectory)/Erlang.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Erlang.Terms">
      <HintPath>$(ResolvedRuntimeReferenceDirectory)/Erlang.Terms.dll</HintPath>
    </Reference>
    <Reference Include="Erlang.Serialization">
      <HintPath>$(ResolvedRuntimeReferenceDirectory)/Erlang.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Erlang.Otp.Stdlib">
      <HintPath>$(ResolvedRuntimeReferenceDirectory)/Erlang.Otp.Stdlib.dll</HintPath>
    </Reference>
    <Compile Include="harness/*.cs" />
  </ItemGroup>
  <Target Name="RequireReviewedRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ResolvedRuntimeReferenceDirectory)/Erlang.Runtime.dll')" Text="Existing reviewed runtime references required; no fallback fake runtime." />
  </Target>
</Project>